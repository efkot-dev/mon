<table width="100%"><tr>
<td width="8%">Новий ключ</td><td>
<form action="/" method="post" class="flex">
<input type="hidden" name="do" value="pmonapi">
<input type="hidden" name="act" value="parametr">
<input value="{apikey}" autocomplete="off" name="apikey" class="css_select" type="text" style="width:200px;" required>
<input placeholder="Ip-Адреса 10.10.10.34" autocomplete="off" name="ip" class="css_select" type="text" style="width:200px;">
{select_type}
{select_user}
<button type="submit" class="css_add" value="submit">[lang:save]</button>
</form>
</td>
</tr>
</table>
</br>