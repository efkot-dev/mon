CREATE TABLE IF NOT EXISTS `topology_nodes` (
  `id` INT UNSIGNED NOT NULL AUTO_INCREMENT,
  `uid` VARCHAR(32) NOT NULL,
  `name` VARCHAR(128) NOT NULL,
  `model` VARCHAR(128) NULL,
  `ports` SMALLINT UNSIGNED NOT NULL DEFAULT 12,
  `ports_per_row` SMALLINT UNSIGNED NOT NULL DEFAULT 16,
  `x` INT NOT NULL DEFAULT 0,
  `y` INT NOT NULL DEFAULT 0,
  `created_at` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
  `updated_at` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
  PRIMARY KEY (`id`),
  UNIQUE KEY `uniq_uid` (`uid`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8;
ALTER TABLE `topology_nodes` ADD COLUMN `locked` TINYINT UNSIGNED NOT NULL DEFAULT 0 AFTER `ports_per_row`;
ALTER TABLE `topology_nodes` ADD COLUMN `kind` VARCHAR(16) NOT NULL DEFAULT 'switch' AFTER `ports_per_row`;
ALTER TABLE `topology_nodes` ADD COLUMN `icon_url` VARCHAR(255) NULL AFTER `kind`;
ALTER TABLE `topology_nodes` ADD COLUMN `open_url` VARCHAR(255) NULL AFTER `icon_url`;
CREATE TABLE IF NOT EXISTS `topology_ports` (
  `id` INT UNSIGNED NOT NULL AUTO_INCREMENT,
  `node_id` INT UNSIGNED NOT NULL,
  `port` SMALLINT UNSIGNED NOT NULL,
  `label` VARCHAR(64) NULL,
  `description` VARCHAR(255) NULL,
  `snmp_ip` VARCHAR(45) NULL,
  `snmp_ro` VARCHAR(128) NULL,
  `snmp_oid` VARCHAR(255) NULL,
  `bind_switch_id` INT UNSIGNED NULL,
  `bind_llid` INT UNSIGNED NULL,
  `last_status` TINYINT UNSIGNED NULL,
  `last_value` VARCHAR(255) NULL,
  `last_polled_at` DATETIME NULL,
  `updated_at` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
  PRIMARY KEY (`id`),
  UNIQUE KEY `uniq_node_port` (`node_id`, `port`),
  KEY `idx_poll_manual` (`snmp_ip`, `snmp_oid`),
  KEY `idx_bind` (`bind_switch_id`, `bind_llid`),
  CONSTRAINT `fk_topology_ports_node`
    FOREIGN KEY (`node_id`) REFERENCES `topology_nodes` (`id`)
    ON DELETE CASCADE
) ENGINE=InnoDB DEFAULT CHARSET=utf8;
CREATE TABLE IF NOT EXISTS `topology_links` (
  `id` INT UNSIGNED NOT NULL AUTO_INCREMENT,
  `uid` VARCHAR(32) NOT NULL,
  `from_node_id` INT UNSIGNED NOT NULL,
  `from_port` SMALLINT UNSIGNED NOT NULL,
  `to_node_id` INT UNSIGNED NOT NULL,
  `to_port` SMALLINT UNSIGNED NOT NULL,
  `length_m` INT UNSIGNED NULL,
  `description` VARCHAR(255) NULL,
  `created_at` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
  PRIMARY KEY (`id`),
  UNIQUE KEY `uniq_uid` (`uid`),
  UNIQUE KEY `uniq_from_port` (`from_node_id`, `from_port`),
  UNIQUE KEY `uniq_to_port` (`to_node_id`, `to_port`),
  CONSTRAINT `fk_topology_links_from`
    FOREIGN KEY (`from_node_id`) REFERENCES `topology_nodes` (`id`)
    ON DELETE CASCADE,
  CONSTRAINT `fk_topology_links_to`
    FOREIGN KEY (`to_node_id`) REFERENCES `topology_nodes` (`id`)
    ON DELETE CASCADE
) ENGINE=InnoDB DEFAULT CHARSET=utf8;
