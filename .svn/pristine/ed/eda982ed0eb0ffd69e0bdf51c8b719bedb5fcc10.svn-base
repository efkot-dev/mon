CREATE TABLE sklad_log (
  id BIGINT UNSIGNED AUTO_INCREMENT PRIMARY KEY,
  action ENUM('add','transfer','writeoff','returm','move','edit','akt') NOT NULL,
  product_id INT UNSIGNED NOT NULL,
  from_user_id INT UNSIGNED NULL,
  to_user_id INT UNSIGNED NOT NULL,
  akt_id INT UNSIGNED NOT NULL,
  quantity INT UNSIGNED NOT NULL,
  actor_id INT UNSIGNED NOT NULL,
  created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

CREATE INDEX idx_sklad_log_product ON sklad_log(product_id, created_at);
CREATE INDEX idx_sklad_log_to_user ON sklad_log(to_user_id, created_at);
ALTER TABLE `sklad_log`
CHANGE `akt_id` `akt_id` int(10) unsigned NULL DEFAULT '0' AFTER `product_id`;
ALTER TABLE `sklad_log`
CHANGE `action` `action` enum('add','transfer','writeoff','return','move','edit','akt') COLLATE 'utf8mb4_general_ci' NOT NULL AFTER `id`;