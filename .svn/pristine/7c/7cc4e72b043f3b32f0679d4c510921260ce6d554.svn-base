/* Backdrop */
.board-dialog::before {
  content: "";
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,.45);
  backdrop-filter: blur(2px);
  z-index: 9998;
}

/* Контейнер модалки */
.board-dialog {
  position: fixed;
  inset: 0;
  display: grid;
  place-items: center;
  z-index: 9999;
  padding: 16px;
}

/* Вміст модалки */
.board-dialog > * {
  box-sizing: border-box;
  width: min(680px, 100%);
  max-height: min(85vh, 800px);
  overflow: auto;
  background: #fff;
  color: #1f2937; /* slate-800 */
  border-radius: 12px;
  box-shadow:
    0 10px 15px -3px rgba(0,0,0,.1),
    0 4px 6px -2px rgba(0,0,0,.05);
  padding: 18px 20px;
  transform: translateY(8px);
  opacity: 0;
  animation: bd-fade-in .18s ease-out forwards;
  z-index: 9999999;
}

/* Заголовки/поля у вмісті за замовчуванням */
.board-dialog label {
  font-size: 13px;
  font-weight: 600;
  color: #374151; /* gray-700 */
  display: block;
  margin-bottom: 6px;
}

.board-dialog input[type="text"],
.board-dialog input[type="datetime-local"],
.board-dialog select,
.board-dialog textarea {
  width: 100%;
  padding: 10px 12px;
  border: 1px solid #e5e7eb; /* gray-200 */
  border-radius: 8px;
  outline: none;
  background: #fff;
  color: #111827; /* gray-900 */
  transition: border-color .15s ease, box-shadow .15s ease;
}

.board-dialog textarea {
  min-height: 120px;
  resize: vertical;
}

.board-dialog input:focus,
.board-dialog select:focus,
.board-dialog textarea:focus {
  border-color: #60a5fa;            /* blue-400 */
  box-shadow: 0 0 0 3px rgba(96,165,250,.25);
}

/* Кнопки у нижній панелі (яку додаємо скриптом) */
.board-dialog .m10b {
  appearance: none;
  border: none;
  border-radius: 10px;
  padding: 10px 14px;
  font-weight: 600;
  cursor: pointer;
  background: #10b981; /* emerald-500 */
  color: #fff;
  transition: transform .06s ease, filter .15s ease, background .15s ease;
}

.board-dialog .m10b + .m10b {
  background: #e5e7eb; /* gray-200 */
  color: #111827;       /* gray-900 */
}

.board-dialog .m10b:hover { filter: brightness(1.05); }
.board-dialog .m10b:active { transform: translateY(1px); }

/* Сумісність із Select2 усередині модалки */
.board-dialog .select2-container {
  width: 100% !important;
}
.board-dialog .select2-selection--single,
.board-dialog .select2-selection--multiple {
  min-height: 40px;
  border: 1px solid #e5e7eb !important;
  border-radius: 8px !important;
}
.board-dialog .select2-selection__rendered {
  padding: 6px 10px !important;
}
.board-dialog .select2-selection__arrow {
  height: 40px !important;
  right: 8px !important;
}

/* Темний режим (за наявності класу .dark на body/html) */
.dark .board-dialog > * {
  background: #111827; /* gray-900 */
  color: #e5e7eb;      /* gray-200 */
  box-shadow:
    0 10px 15px -3px rgba(0,0,0,.5),
    0 4px 6px -2px rgba(0,0,0,.3);
}
.dark .board-dialog label { color: #d1d5db; }
.dark .board-dialog input[type="text"],
.dark .board-dialog input[type="datetime-local"],
.dark .board-dialog select,
.dark .board-dialog textarea {
  background: #0b1220;         /* темний фон */
  color: #e5e7eb;
  border-color: #374151;       /* gray-700 */
}
.dark .board-dialog .m10b + .m10b {
  background: #374151; /* gray-700 */
  color: #e5e7eb;
}

/* Анімація появи */
@keyframes bd-fade-in {
  from { opacity: 0; transform: translateY(8px); }
  to   { opacity: 1; transform: translateY(0); }
}

/* Малий екрани */
@media (max-width: 420px) {
  .board-dialog > * {
    padding: 14px;
    border-radius: 10px;
  }
}
/* щоб вміст модалки не обрізав дропдаун */
.board-dialog > * {
  overflow: visible; /* було auto */
}

/* піднімаємо select2 контейнер і сам дропдаун вище за модалку/бекдроп */
.board-dialog .select2-container {
  z-index: 10000001 !important;
}
.board-dialog .select2-dropdown {
  z-index: 10000002 !important;
}

/* на всяк випадок: якщо select2 додається в body (legacy випадки) */
.select2-container .select2-dropdown {
  z-index: 10000002 !important;
}

