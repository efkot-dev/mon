<?php
if (!defined('PONMONITOR')){
	die('Hacking attempt!');
}
$timer = date('Y-m-d H:i:s');
require ROOT_DIR.'/inc/init.monitor.php';
$timeout = 100000;
$retries = 5;
if(isset($olt) && $olt>0){
	$id_device = intval($olt);
}
if(isset($id_device) && $id_device>0){
	$switch = $db->Fast('switch', '*', ['id' => $id_device]);
}
if(isset($switch['id']) && $switch['id'] > 0 && isset($switch['oidid'])){
    $oidid = $switch['oidid'];
	if ($oidid == 1 || $oidid == 41 ||$oidid == 43 || 
		$oidid == 2 ||$oidid == 7 ||$oidid == 34 || $oidid == 35 || 
			$oidid == 14) {
		$switch = $db->Fast('switch', '*', ['id' => $switch['id']]);
		if (isset($switch['oidid'])) {
			taskers_device_pmon($db, 29, $switch['id']);
			$sql_onus = $db->SimpleWhile("SELECT keyonu,zte_idport,type,idonu FROM onus WHERE olt = " . $switch['id']);
			if (isset($sql_onus) && count($sql_onus) > 0) {
				foreach ($sql_onus as $onus) {
					$data = [];
					if ($switch['oidid'] == 1) {
						$oid_vendor = '1.3.6.1.4.1.3320.101.10.1.1.1.' . $onus['keyonu'];
						$oid_model = '1.3.6.1.4.1.3320.101.10.1.1.2.' . $onus['keyonu'];
					} elseif ($switch['oidid'] == 7 || $switch['oidid'] == 34) {
						if($onus['type']=='gpon'){
							$oid_vendor = '1.3.6.1.4.1.3902.1012.3.50.11.2.1.1.' . $onus['zte_idport'] . '.' . $onus['keyonu'];
							$oid_model = '1.3.6.1.4.1.3902.1012.3.50.11.2.1.17.' . $onus['zte_idport'] . '.' . $onus['keyonu'];
						}else{
							$oid_vendor = '1.3.6.1.4.1.3902.1015.1010.1.7.4.1.5.' . $onus['keyonu'];
							$oid_model = '1.3.6.1.4.1.3902.1015.1010.1.1.1.1.1.2.' . $onus['keyonu'];
						}
					} elseif ($switch['oidid'] == 43) {
						$oid_vendor = '1.3.6.1.4.1.637.61.1.35.10.1.1.4.' . $onus['keyonu'];
						$oid_model = '1.3.6.1.4.1.637.61.1.35.10.1.1.3.' . $onus['keyonu'];
					} elseif ($switch['oidid'] == 35 || $switch['oidid'] == 41) {
						$oid_vendor = '1.3.6.1.4.1.17409.2.8.4.1.1.5.' . $onus['keyonu'];
						$oid_model = '1.3.6.1.4.1.17409.2.8.4.1.1.6.' . $onus['keyonu'];
					} elseif ($switch['oidid'] == 2) {
						$oid_vendor = '1.3.6.1.4.1.3320.10.3.1.1.9.' . $onus['keyonu'];
					} elseif ($switch['oidid'] == 14 && $onus['type'] == 'gpon') {
						$oid_model = '1.3.6.1.4.1.2011.6.128.1.1.2.45.1.4.' . $onus['zte_idport'] . '.' . $onus['keyonu'];
					}
					if (!empty($oid_vendor) || !empty($oid_model)) {
						$snmp_vendor = isset($oid_vendor) ? @snmp2_get($switch['netip'], $switch['snmpro'], $oid_vendor, $timeout, $retries) : null;
						$snmp_model = isset($oid_model) ? @snmp2_get($switch['netip'], $switch['snmpro'], $oid_model, $timeout, $retries) : null;
						if (!empty($snmp_vendor) || !empty($snmp_model)) {
							$data = [];
							$data['vendor'] = isset($snmp_vendor) ? trim(str_replace(['STRING:', ' ', '"'], '', $snmp_vendor)) : '';
							$data['model'] = isset($snmp_model) ? trim(str_replace(['STRING:', ' ', '"'], '', $snmp_model)) : '';						
							if (!empty($data) && !empty($onus['idonu'])) {
								$db->SQLupdate('onus', $data, ['idonu' => $onus['idonu']]);
							}
						}
					}
				}
			}
		}
	}
}
if (isset($id_device) && $id_device>0) {
	echo'ok';
}
?>
