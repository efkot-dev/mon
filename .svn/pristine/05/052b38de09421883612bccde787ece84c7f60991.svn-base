CREATE TABLE notes (
    id INT AUTO_INCREMENT PRIMARY KEY,
    deviceid INT,
    views INT,
    userid INT,
    title TEXT,
    descr TEXT,
    message TEXT,
    added TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);
ALTER TABLE `onus_log`
CHANGE `types` `types` enum('cron','system','user','switch','signal','status','reboot','mac') COLLATE 'utf8_general_ci' NULL DEFAULT 'system' AFTER `status`;
