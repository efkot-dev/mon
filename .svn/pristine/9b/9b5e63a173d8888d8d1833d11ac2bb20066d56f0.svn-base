<?php
if (!defined('PONMONITOR')){
	die('Hacking attempt!');
}
require ROOT_DIR.'/inc/init.monitor.php';
$added = date('Y-m-d H:i:s');
if(isset($olt) && $olt>0){
	$id_device = $olt;	
}	
if (isset($id_device) && $id_device > 0) {
    $timer = isset($confPMon['TIMER_CHANGE_RX']) && !empty($confPMon['TIMER_CHANGE_RX']) ? $confPMon['TIMER_CHANGE_RX'] : 10;
    $criticalCountChangeRx = isset($confPMon['CRITICAL_COUNT_CHANGE_RX']) && !empty($confPMon['CRITICAL_COUNT_CHANGE_RX']) ? $confPMon['CRITICAL_COUNT_CHANGE_RX'] : 5;
    $switch = $db->Simple("SELECT * FROM switch WHERE id = '{$id_device}' LIMIT 1");
	if(empty($switch['id'])){
		exit;
	}
    $sqlget = $db->SimpleWhile("SELECT * FROM switch_pon WHERE oltid = '{$switch['id']}'");
    if (!empty($sqlget)) {
        foreach ($sqlget as $switchpon) {
            if (!empty($switchpon['sfpid'])) {
                $statuses = ['up' => $lang['bades_signal'], 'down' => $lang['super_signal']];
                foreach ($statuses as $rxStatus => $signalLang) {
                    $countbadtoday = $db->Simple("SELECT count(idonu) as bad_rx FROM onus WHERE olt = " . $switchpon['oltid'] . "
                    AND portolt = " . $switchpon['sfpid'] . " AND rxstatus = '$rxStatus' AND changerx >= (NOW() - INTERVAL $timer MINUTE)");
                    if (!empty($countbadtoday['bad_rx']) && $countbadtoday['bad_rx'] > 0) {
                        $countcheckonu = (100 / $switchpon['count']) * $countbadtoday['bad_rx'];
                        $check = intval($countcheckonu);
                        if ($check > $criticalCountChangeRx) {
                            $sender = "[icon-" . ($rxStatus === 'up' ? 'myxa' : 'super') . "][b]" . $switch['place'] . "[/b] $signalLang [b]" . $switchpon['pon'] . "[/b] " . $lang['count'] . ": [b]" . $countbadtoday['bad_rx'] . "[/b]";
                            $db->SQLinsert('notification', [
                                'status' => 1,
                                'type' => 6,
                                'system' => 'pinger',
                                'message' => $sender,
                                'added' => $added
                            ]);
                        }
                    }
                }
            }
        }
    }
}
?>
