ALTER TABLE switch ADD pinger INT NULL DEFAULT NULL AFTER status;
ALTER TABLE onus ADD stikers INT NULL DEFAULT NULL AFTER idonu;
ALTER TABLE onus ADD addstikers INT NULL DEFAULT NULL AFTER idonu;
ALTER TABLE onusdata ADD `uid` INT NULL DEFAULT NULL AFTER tag;
ALTER TABLE onusdata ADD ponelement INT(11) NULL DEFAULT NULL AFTER uid;
ALTER TABLE onusdata ADD pontree INT(11) NULL DEFAULT NULL AFTER uid;
ALTER TABLE groups ADD group_types INT(11) NULL DEFAULT NULL AFTER id;
ALTER TABLE onus ADD clockstikers DATETIME DEFAULT '1970-01-01 00:00:00';
ALTER TABLE onus ADD rxolt DECIMAL(10,2) DEFAULT '0';
ALTER TABLE bandwidth ADD speed_port INT(11) NULL DEFAULT NULL AFTER id;
ALTER TABLE bandwidth MODIFY speed_port BIGINT;
CREATE TABLE `mac_router` (
  `id` int(11) unsigned NOT NULL AUTO_INCREMENT,
  `mac` text DEFAULT NULL,
  `deviceid` int(11) DEFAULT NULL,
  `inface` text DEFAULT NULL,
  `vlan` text DEFAULT NULL,
  `port` text DEFAULT NULL,
  `onu` text DEFAULT NULL,
  `portid` int(11) DEFAULT NULL,
  `onuid` int(11) DEFAULT NULL,
  `update` datetime DEFAULT NULL,
  `added` datetime DEFAULT NULL,
  PRIMARY KEY (`id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8 COLLATE=utf8_general_ci;
CREATE TABLE `spliters` (
  `id` int(11) unsigned NOT NULL AUTO_INCREMENT,
  `ponelementname` text DEFAULT NULL,
  `userid` int(11) DEFAULT NULL,
  `pontreeid` int(11) DEFAULT NULL,
  `ponelement` int(11) DEFAULT NULL,
  `spliterid` int(11) DEFAULT NULL,
  `added` datetime DEFAULT NULL,
  PRIMARY KEY (`id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8 COLLATE=utf8_general_ci;
CREATE TABLE `tracking_user` (
  `id` int(11) unsigned NOT NULL AUTO_INCREMENT,
  `lan` text DEFAULT NULL,
  `lon` text DEFAULT NULL,
  `userid` int(11) DEFAULT NULL,
  `userkey` text DEFAULT NULL,
  `userdevice` text DEFAULT NULL,
  `user` text DEFAULT NULL,
  `system` text DEFAULT NULL,
  `car` int(11) DEFAULT NULL,
  `location` int(11) DEFAULT NULL,
  `update` datetime DEFAULT NULL,
  `added` datetime DEFAULT NULL,
  PRIMARY KEY (`id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8 COLLATE=utf8_general_ci;
