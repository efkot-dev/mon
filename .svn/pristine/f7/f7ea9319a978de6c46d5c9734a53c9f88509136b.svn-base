ALTER TABLE skyscraper ADD `lan` TEXT NULL DEFAULT NULL AFTER added;
ALTER TABLE skyscraper ADD `lon` TEXT NULL DEFAULT NULL AFTER lan;
ALTER TABLE skyscraper ADD lastoffline INT NULL DEFAULT NULL AFTER lon;
ALTER TABLE ponelement ADD status INT(11) NULL DEFAULT NULL AFTER types;
ALTER TABLE ponelement ADD count INT(11) NULL DEFAULT NULL AFTER status;
CREATE TABLE `monitor_ip` (
  `id` int(11) unsigned NOT NULL AUTO_INCREMENT,
  `ip` text DEFAULT NULL,
  `name` text DEFAULT NULL,
  `status` int(11) DEFAULT NULL,
  `groups` int(11) DEFAULT NULL,
  `location` int(11) DEFAULT NULL,
  `lan` text DEFAULT NULL,
  `lon` text DEFAULT NULL,
  `added` datetime DEFAULT NULL,
  PRIMARY KEY (`id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8 COLLATE=utf8_general_ci;
ALTER TABLE monitor_ip ADD monitor ENUM('yes', 'no') DEFAULT 'no';
ALTER TABLE monitor_ip ADD updates DATETIME DEFAULT '1970-01-01 00:00:00' AFTER monitor;
ALTER TABLE monitor_ip ADD online DATETIME DEFAULT '1970-01-01 00:00:00' AFTER updates;
ALTER TABLE monitor_ip ADD offline DATETIME DEFAULT '1970-01-01 00:00:00' AFTER online;
ALTER TABLE monitor_ip ADD ttl text NULL DEFAULT NULL AFTER online;
ALTER TABLE monitor_ip ADD timer text NULL DEFAULT NULL AFTER ttl;
CREATE TABLE `monitor_ip_log` (
  `id` int(11) UNSIGNED NOT NULL AUTO_INCREMENT,
  `ip_id` int(11) DEFAULT NULL,
  `time` text,
  `ttl` int(11) DEFAULT NULL,
  `status` int(11) DEFAULT NULL,
  `added` datetime DEFAULT NULL,
  PRIMARY KEY (`id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8;
ALTER TABLE users ADD groups INT(11) NULL DEFAULT NULL AFTER id;
ALTER TABLE users ADD status INT(11) NULL DEFAULT NULL AFTER groups;
ALTER TABLE kabel_volokno  ADD krapochka  INT(11) NULL DEFAULT NULL AFTER kabelidid;
DROP TABLE pmon_poller;

ALTER TABLE `switch_port` ADD `error_count` bigint(22) NULL AFTER `llid`, ADD `error_today` bigint(22) NULL AFTER `error_count`;
