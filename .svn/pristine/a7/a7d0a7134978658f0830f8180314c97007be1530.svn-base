.block-optik{}

#connection-svg .active .block-optik:hover{
	fill: #b9b9b9;
}
#connection-svg{

}
#connection-svg .fibers .block-optik{
	fill: #222;
	stroke-width: 1px;
}
.connection-group .actimel{
	animation: blink_vols 0.5s linear infinite;
}
@keyframes blink_vols {
  25% {
    stroke: #fff;
  }  
  55% {
    stroke: #222;
  }  
  85% {
    stroke: red;
  }
}
.aiform{
    min-width: 60px;	
}
.iiform{
    display: block;
    min-width: 60px;
    height: 25px;
    line-height: 26px;
    font-size: 12px;
    padding: 0 4px;
    background-color: #ffffff;
    border: 1px solid rgb(102 129 200 / 44%);
    color: #000;
    border-radius: 3px;
    box-shadow: none;
    margin: 0;
}
 #vok-editor {
        width: 100%;
        height: 100vh;
        overflow: auto;
        position: relative;
    }
#connection-svg {
        display: block;
        width: 100%;
    height: 100%;
	    position: relative;
    overflow: visible; /* Allow overflow */
}

.tooltip {
	display:none;
	position:absolute;
	border:1px solid #333;
	background-color:#161616;
	border-radius: 5px;
	padding: 5px;
	color: #fff;
	font-size: 12px;
}
.colona .input1 {
    height: 70px;
    padding: 3px;
    font-size: 12px;
}
.menu-pon {
    position: absolute;
    background: #fff;
    border: 1px solid #ddd;
    padding: 5px 10px;
    z-index: 99;
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
    top: 43px;
    left: 3px;
}
#show-menu {
    padding: 6px 10px;
    margin-right: 6px;
}
.posilania:hover{
    opacity: 1;	
}
.posilania {
    opacity: 0.7;
}
.hidden {
    display: none;
}
.menu-pon p:hover{
	color: #222;
}
.menu-pon p {
    cursor: pointer;
    padding: 5px 10px;
}
.menu-pon p i {
    position: relative;
    top: 1px;
    margin-right: 10px;
}
#show-menu i {
    position: relative;
    top: 2px;
}
#pon-grid {
    display: flex;
    flex-direction: row;
    justify-content: flex-start;
    align-items: center;
    width: 100%;
    position: absolute;
    z-index: 999;
    top: 0px;
}
.pon_name_editor i {
    position: relative;
    top: 2px;
    margin-right: 10px;
}
.pon_name_editor a:hover{
	color:red;
}
.pon_name_editor a {
    color: #076dc7;
}
.pon_name_editor:hover{
	color: #222;	
}
.pon_name_editor {
    background: #ffffffa1;
    padding: 5px 10px 5px 8px;
    color: #4f627c;
    font-size: 13px;
    cursor: pointer;
    margin: 2px 5px 0 0px;
    border-radius: 5px;
}
.pon_name_added i {
    position: relative;
    top: 2px;
    margin-right: 10px;
}
.pon_name_added:hover{
    color: #222;	
}
.pon_name_added {
    padding: 5px 10px 5px 10px;
    color: #4f627c;
    font-size: 13px;
    cursor: pointer;
    margin: 2px 5px 0 0px;
}
.dir-chooser {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
}
.dir-chooser a i {
    position: relative;
    width: 24px;
    top: 3px;
    height: 24px;
    left: 5px;
}
.dir-chooser a {
    width: 24%;
    border: 1px solid #eee;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 5px;
	cursor:pointer;
    margin: 3px;
}
.dir-btn:hover{
	border: 1px solid red;
}
/* м'яке затемнення всіх ліній */
.trace-dim { opacity: .15; }
/* активний шлях */
.trace-active { opacity: 1; filter: drop-shadow(0 0 2px rgba(255,200,0,.8)); }
/* усі конектори на шляху */
.conn-trace { stroke: #222; stroke-width: 1.5px; }
/* фінальні точки */
.conn-end { stroke: #ff6a00; stroke-width: 2px; }
.fiber-trace-label {
    pointer-events: auto;
    paint-order: stroke;
    stroke: #e7edf3;
    stroke-width: 2px;
    stroke-linejoin: round;
}
#connection-svg .fibers {
    transition: opacity 0.15s ease, filter 0.15s ease;
}
#connection-svg .fibers.fiber-node-dim {
    opacity: 0.32;
}
#connection-svg .fibers.fiber-node-active {
    opacity: 1;
    filter: drop-shadow(0 0 2px rgba(255, 210, 0, 0.65));
}
#connection-svg .fibers .fiber-block {
    transition: stroke 0.15s ease, stroke-width 0.15s ease, fill 0.15s ease;
}
#connection-svg .fibers.fiber-node-active .fiber-block {
    stroke: #ffd200;
    stroke-width: 1.6px;
    fill: #2a2a2a;
}
#connection-svg .fiber-connector.fiber-port-hot .conn,
#connection-svg .fiber-connector.fiber-conn-active .conn {
    stroke: #ffd200;
    stroke-width: 1.4px;
}
#connection-svg .fiber-connector.fiber-conn-dim {
    opacity: 0.45;
}
#connection-svg .conn.has-port-note {
    stroke: #f7c948;
    stroke-width: 1.2px;
    cursor: help;
}
#connection-svg .port-note-dot {
    fill: #ffcf3a;
    stroke: #1f1f1f;
    stroke-width: 0.6px;
    pointer-events: none;
}
#connection-svg .switch .conn,
#connection-svg .cross .conn {
    cursor: pointer;
    transition: stroke 0.12s ease, stroke-width 0.12s ease, fill 0.12s ease;
}
#connection-svg .switch .conn:hover,
#connection-svg .cross .conn:hover {
    stroke: #ff2f2f !important;
    stroke-width: 1.8px;
}
