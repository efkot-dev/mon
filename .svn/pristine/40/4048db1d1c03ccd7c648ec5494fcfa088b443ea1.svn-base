defined('PONMONITOR') or die('Hacking attempt!');
$md5 = md5(time());
$title = $metatags['title'] ?? null;
$description = $metatags['description'] ?? null;
$html = ($title && $description)
    ? "<title>{$title}</title>\n<meta name=\"description\" content=\"{$description}\" />"
    : '';
$width = (!empty($system_navigation))
    ? '100%'
    : (!empty($confPMon['WIDTH_PAGE']) ? $confPMon['WIDTH_PAGE'] . '%' : '90%');
$var = <<<HTML
<script>
    var root = "/";
    var version = "{$pmon_index}";
    var author = "@momotuk88";
</script>
<style>
    :root { --primary-width: {$width}; }
</style>
HTML;
$ajax = implode("\n", [
    '<script src="../style/js/jquery-3.6.0.min.js"></script>',
    '<script src="../style/js/jquery.cookies.js"></script>',
    '<script src="../style/js/script.js?d=cvbcvbvcb"></script>',
    '<script src="../style/js/Chart.min.js"></script>',
]);
$pagesWithCharts = ['viewping3ping3', 'detail', 'rem', 'taskman', 'onu'];
if (!empty($metatags['page']) && in_array($metatags['page'], $pagesWithCharts, true)) {
    $ajax .= "\n" . implode("\n", [
        '<script src="https://cdn.amcharts.com/lib/5/index.js"></script>',
        '<script src="https://cdn.amcharts.com/lib/5/xy.js"></script>',
        '<script src="https://cdn.amcharts.com/lib/5/themes/Animated.js"></script>',
        '<script src="../style/map/leaflet.js"></script>',
    ]);
}
$ajax .= "\n<script src=\"../style/js/d3.v7.min.js\"></script>";
$css = implode("\n", [
    '<link rel="stylesheet" href="../style/css/styles.css?d='.$md5.'">',
