<tr><td>
<table class="olt-dev-olt {notsnmp}">
	<tr>
	<td class="olt-img">
		<div class="lg">
			<a href="{url}"><img src="../style/device/{imgmodel}"></a>
		</div>
	</td>
	<td class="olt-n">
		<div class="olt-nam"><a class="olt-name" href="{url}"><img src="../style/img/link.png">{place}</a></div>
		<div class="olt-notes">			
			<span class="olt-location">{location}</span>
			<span class="olt-model">{model}</span>
			{netip}	
			<span class="timer"><img src="../style/img/refresh.png">{time}</span>			
		</div>
	</td>
	<td class="new_onu">{new_onu}</td>
	<td class="olt-info">{badrx}{uptime}</td>
	<td class="olt-subs">
		<div class="olt-flex olt-pon">
			<span class="n">[lang:count_port_pons]</span>
			<span class="c">{pon_port}</span>
		</div>		
		<div class="olt-flex olt-onu">
			<span class="n">[lang:allonus]</span>
			<span class="c">{count}{todayonu}</span>
		</div>		
		<div class="olt-flex olt-onuon">
			<span class="n">[lang:online]</span>
			<span class="c">{online}</span>
		</div>		
		<div class="olt-flex olt-onuoff">
			<span class="n">[lang:offline]</span>
			<span class="c">{offline}</span>
		</div>
	</td>
</tr>
</table>
</td></tr>



