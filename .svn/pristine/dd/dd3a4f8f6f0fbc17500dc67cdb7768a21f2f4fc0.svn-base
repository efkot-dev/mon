<?php
if (!defined('PONMONITOR')){
	die('Hacking attempt!');
}
require ROOT_DIR.'/inc/init.monitor.php';
$time = date('Y-m-d H:i:s');
function savePortMonitor($db, $time, $lang, $place, $name, $descr, $status, $laststatus, $portid, $deviceid, $sms) {
    $sqlupdate = [];
    $text = '';
    if ($portid > 0 && isset($status)) {
        $status = is_numeric($status) ? statusMonitor($status) : $status;
        switch (true) {
            case $laststatus == 'down' && $status == 'up':
                $sqlupdate = ['timeup' => $time, 'operstatus' => 'up'];
                $text = '✅[b]'.$lang['up_port'].':[/b] '.$lang['port'].': [b]' . $name . '[/b] ' . ($descr ? '(' . $descr . ')' : '') . ' - ' . $place . '';
                break;
            case $laststatus == 'up' && $status == 'down':
                $sqlupdate = ['timedown' => $time, 'operstatus' => 'down'];
		$text = '⛔️[b]'.$lang['down_port'].':[/b] '.$lang['port'].':: [b]' . $name . '[/b] ' . ($descr ? '(' . $descr . ')' : ''). ' - ' . $place . '';
                break;
            case $laststatus == 'none' && $status == 'up':
                $sqlupdate = ['timeup' => $time, 'operstatus' => 'up'];
                break;
            case $laststatus == 'none' && $status == 'down':
                $sqlupdate = ['timedown' => $time, 'operstatus' => 'down'];
                break;
        }
        if (!empty($sqlupdate)) {
            $sqlupdate['updates'] = $time;
            $db->SQLupdate('switch_port', $sqlupdate, ['id' => $portid]);
        }
    }
    if ($sms == 'yes' && $deviceid > 0 && $portid > 0 && !empty($text)) {
        $db->SQLinsert('notification', [
            'status' => 1,
            'type' => 4,
            'system' => 'monitor',
            'message' => $text,
            'added' => date('Y-m-d H:i:s')
        ]);
    }
}
$switcharray = array();
$allswitch = $db->Multi('switch','*',['monitor' => 'yes']);
if(isset($allswitch) && count($allswitch)>0){
	foreach ($allswitch as $switch) {
		$switcharray[$switch['id']] = [
			'place' => $switch['place'],'oid' => $switch['oidid'],'monitor' => $switch['monitor']
		];
	}
}else{
	die('not_support');
}
$get_port = $db->Multi('switch_port','*',['monitor' => 'yes']);
if(isset($get_port) && count($get_port)>0){
	$arrayport = [];
	foreach ($get_port as $port) {
		if (isset($port['deviceid']) && $port['deviceid']>0 && $switcharray[$port['deviceid']]['monitor'] == 'yes') {
			$types = ($switcharray[$port['deviceid']]['oid'] == 15) ? 'port'.$port['typeport'] : 'port';
			$arrayport[$port['id']] = [
				'name' => $port['nameport'],
				'descr' => !empty($port['descrport']) ? $port['descrport'] : null,
				'portid' => $port['id'],
				'id' => $port['deviceid'],
				'sms' => !empty($port['sms']) ? $port['sms'] : null,
				'place' => $switcharray[$port['deviceid']]['place'],
				'ip' => !empty($switcharray[$port['deviceid']]['netip']) ? $switcharray[$port['deviceid']]['netip'] : null,
				'oidid' => $switcharray[$port['deviceid']]['oid'],
				'status' => $port['operstatus'],
				'oid' => '1.3.6.1.2.1.2.2.1.8.'.$port['llid']
			];
		}
	}
	$result_port = [];
	if(is_array_empty($arrayport)) {
		foreach ($arrayport as $portid => $data){
			if(!empty($data['oid'])){
				$result_port[$portid] = api__($config['monitorapi'],['do' => 'oid', 'oid' => $data['oid'], 'id' => $data['id']]);
			}
		}
	}
	if (!empty($result_port) && !empty($arrayport)) {
		foreach ($result_port as $id => $val) {
			if (!empty($arrayport[$id]['oidid'])) {
				if ($arrayport[$id]['oidid'] == 14) {
					$status = portstatusHuawei($val['result']);
				} elseif ($arrayport[$id]['oidid'] == 8) {
					if (isset($val['result'])) {
						if ($val['result'] == 6 || $val['result'] == 1) {
							$status = 1;
						} elseif ($val['result'] == 2) {
							$status = 2;
						} else {
							$status = 2;
						}
					} else {
						$status = '';
					}
				} else {
					$status = (!empty($val['result']) ? $val['result'] : '');
				}
				savePortMonitor(
					$db, $time, $lang,
					$arrayport[$id]['place'],
					$arrayport[$id]['name'],
					(!empty($arrayport[$id]['descr']) ? $arrayport[$id]['descr'] : ''),
					$status,
					$arrayport[$id]['status'],
					$arrayport[$id]['portid'],
					$arrayport[$id]['id'],
					(!empty($arrayport[$id]['sms']) ? $arrayport[$id]['sms'] : '')
				);
			}
		}
	}
}
?>
