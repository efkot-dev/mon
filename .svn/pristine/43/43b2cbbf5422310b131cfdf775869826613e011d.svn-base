<?php
if(!defined('PONMONITOR')){
	die('Hacking attempt!');
}
class Ont{
	private int $id;
	private Equipment $equipment;
	private $getModel;
    private $config;
    private $db;
    private $php_class_device;
    private $logger;
    private $device;
    private $cache;	
	public function __construct($id, $phpclass, $db, $logger, $config, $cacheManager, $php_class_device){
		if(is_numeric($id)){
			$this->config = $config;	
			$this->db = $db;	
			$this->php_class_device = $php_class_device;	
			$this->logger = $logger;	
			$this->cache = $cacheManager;	
			$this->id = $id;	
			$this->device = new Equipment($id, $this->db, $this->cache);
			$this->getModel = $this->initclass($id, $phpclass, $this->device);
		}
	}
	protected function loadfile($phpclass) {		
		if (isset($this->php_class_device[$phpclass])) {
			$get_file = ENGINE_DIR . 'classes/' . $this->php_class_device[$phpclass];
			if (file_exists($get_file)) {
				require $get_file;
			}
		}
	}
	protected function initclass($id, $phpclass, $oiddevice) {
		$this->loadfile($phpclass);
		if (!is_numeric($id)) {
			die('empty id or oidid');
		}
		$classMap = [
			'smartfiberepon' => SmartFiber_Epon::class,
			'smartfibergpon' => SmartFiber_Gpon::class,
			'gcomeponel5610' => GCOM5610_Epon::class,
			'huawei5608t' => HUAWEI_5608t::class,
			'huawei5608tr15' => HUAWEI_5608R015::class,
			'nokiaisam7300' => NOKIA_ISAM_7300::class,
			'zte320_1' => ZTE_c320_1::class,
			'zte320_2' => ZTE_c320_2::class,
			'zte220_2' => ZTE_c220_2::class,
			'zte300_2' => ZTE_c300_2::class,
			'zte300_1' => ZTE_c300_1::class,
			'bdcomepon' => BDCOM_Epon::class,
			'dlinkdgs1106' => DlinkDGS1106ME::class,
			'bdcomgpon' => BDCOM_Gpon::class,
			'cdataf1616sn' => CDATA_1616sn::class,
			'cdatafd1608' => CDATA_1608sn::class,
			'cdata1208sr2dap' => CDATA_1208sr2dap::class,
			'cdata1204' => CDATA_1204::class,
			'cdataf1216s' => CDATA_1216s::class,
			'cdata1108' => CDATA_1108::class,
			'planet2424' => Planet2424::class,
			'mkt2011rm' => Mikrotik2011RM::class,
			'zte600_1' => ZTE_c600_1::class,
			'zte620_1' => ZTE_c600_1::class,
			'hiosoha7302' => HiosoHA7302::class,
			'vsolv16' => Vsolv16_Gpon::class,
			'vsolv16d' => Vsolv16_Epon::class,
			'vsolv16d_1' => Vsolv16_Epon_1::class,
			'cdata1616v3' => CDATA_1616V3::class,
			'gcomgpon5610' => GCOM_Gpon::class,
			'fd1700s' => CDATA_FD1700s::class,
			'gcomgpon5610' => GCOM_Gpon::class,
		];
		if (isset($classMap[$phpclass])) {
			$className = $classMap[$phpclass];
			return new $className($id, $oiddevice, $this->db, $this->logger);
		}
		die('not support core');
	}
	public function Support() {
		return $this->getModel->Support('onu');
	}
	public function getApi($dataOnu) {
		$configApi = $this->getModel->ConfigApiOnu($dataOnu);
		$resultApi = fastApiRequest($this->config['monitorapi'],$configApi);
		return $this->getModel->Onu($resultApi, $dataOnu);
	}	
	public function getResult($dataOnu, $manualGet) {
		$configApi = $this->getModel->ConfigApiOnuGet($dataOnu);
		if (isset($manualGet) && $manualGet != false) {
			$existingTypes = explode(',', $configApi['types']);
			$manualTypes = explode(',', $manualGet);
			$allExist = !array_diff($manualTypes, $existingTypes);
			if ($allExist) {
				$configApi['types'] = $manualGet;
			}
		}
		$resultApi = api__($this->config['monitorapi'], $configApi);
		return $this->getModel->Onu($resultApi, $dataOnu);
	}

	public function getApiapp($dataOnu) {
		$configApi = $this->getModel->ConfigApiOnuGet($dataOnu);
		$resultApi = api__($this->config['monitorapi'],$configApi);
		return $this->getModel->Onu($resultApi, $dataOnu);
	}
}
?>
