CREATE TABLE `bdcom_epon_onu_pir` (
`id` int(11) unsigned NOT NULL AUTO_INCREMENT,
`name` text,
`olt` int(11) DEFAULT NULL,
`u_cir` int(11) DEFAULT NULL,
`u_pir` int(11) DEFAULT NULL,
`d_cir` int(11) DEFAULT NULL,
`d_pir` int(11) DEFAULT NULL,
`added` datetime DEFAULT NULL,
PRIMARY KEY (`id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8 COLLATE=utf8_general_ci;


CREATE TABLE `fdb_tables` (
`id` int(11) unsigned NOT NULL AUTO_INCREMENT,
`mac` text,
`inface` text,
`olt` int(11) DEFAULT NULL,
`idonu` int(11) DEFAULT NULL,
`vlan` int(11) DEFAULT NULL,
`keyonu` int(11) DEFAULT NULL,
`svlan` int(11) DEFAULT NULL,
`added` datetime DEFAULT NULL,
PRIMARY KEY (`id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8 COLLATE=utf8_general_ci;

CREATE TABLE `logging_alarm` (
`id` int(11) unsigned NOT NULL AUTO_INCREMENT,
`switchlog` text,
`logkey` text,
`deviceid` int(11) DEFAULT NULL,
`switch_time` datetime DEFAULT NULL,
`added` datetime DEFAULT NULL,
PRIMARY KEY (`id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8 COLLATE=utf8_general_ci;




