<!DOCTYPE html>
<html lang="uk">
<head>
<meta charset="UTF-8">
<meta http-equiv="X-UA-Compatible" content="IE=edge">
{html}
{ajax}
{css}
<link rel="icon" type="image/png" sizes="32x32" href="../style/img/favicon-32x32.png">
<link rel="icon" type="image/png" sizes="16x16" href="../style/img/favicon-16x16.png">
<meta name="generator" content="PMon">
<meta name="author" content="Momotiuk Oleksiy">
</head>
<body>
{var}
{vikno_flash}
<div class="side-menu" id="sideMenu">
    <div id="details_taskers" class="mtop5"></div>
</div>
<div class="nav-pmon"><div class="w-menu">
<a href="/"><div class="pmon-logo"><span class="title">PMON<div class="copir">_</div></span><span class="subtitle">[lang:syspmon] <sup>DRAGON</sup></span></div></a>
{menu}
</div></div>
<div id="statuscron"></div>
<div class="wrap">
<div class="wrap-center wrap-container">
<div class="cols fx-row" id="ajax_search">
<main class="col-middle fx-1 fx-col color1">
<div class="mmain">{content}</div>
</main>
{block-right}
</div>
</div>
</div>
<div id="ajax"></div>
<div id="loading" style="display:none"><div class="loading"> LOAD... </div></div>
<script src="../style/js/windows.js"></script>
<div id="popup">
    <div id="popup-box">
        <span id="popup-close" onclick="closePopup()"><img src="../style/img/popup-close.png"></span>
        <div id="popup-content"></div>
    </div>
</div>
<div id="toast" class="toast hidden">
    <span class="toast-icon"></span>
    <div class="toast-content"></div>
</div>
</body>
</html>
{debug}