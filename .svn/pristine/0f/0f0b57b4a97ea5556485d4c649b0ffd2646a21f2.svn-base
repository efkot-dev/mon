	case 'savestartpmon':
		$deviceid = isset($_POST['deviceid']) ? Clean::int($_POST['deviceid']) : null;
		$intervals = $_POST['interval_custom'] ?? [];
		$enables = $_POST['enable'] ?? [];
		$type_schedulers = $_POST['type_scheduler'] ?? [];
		$daily_times = $_POST['daily_time'] ?? [];
		$custom_times = $_POST['custom_time'] ?? [];
		$step = 0;
		foreach ($intervals as $workid => $interval) {
			$interval = intval($interval);
			$status = isset($enables[$workid]) ? 'enabled' : 'disabled';
			$type_scheduler = isset($type_schedulers[$workid]) ? Clean::text($type_schedulers[$workid]) : 'hourly';
			$daily_time = isset($daily_times[$workid]) ? Clean::text($daily_times[$workid]) : null;
			$custom_time = isset($custom_times[$workid]) ? Clean::text($custom_times[$workid]) : null;
			if ($type_scheduler === 'manual') {
				$daily_time = 'NULL';
			} elseif ($type_scheduler === 'daily') {
				$custom_time = 0;
				$daily_time = $daily_time ?: '00:00:00';
			} elseif ($type_scheduler === 'hourly') {
				$custom_time = 0;
				$daily_time = '00:00:00';
			}
			if ($status === 'enabled') {
				$sql = "INSERT INTO `taskers` 
						(`deviceid`, `workid`, `type`, `interval`, `status`, `userid`, `added`, `pmon`, `type_scheduler`, `daily_time`, `custom_time`) 
						VALUES 
						('{$deviceid}', '{$workid}', 'monitor', '{$interval}', 
						'pending', '{$USER['id']}', '{$added}', 'work', '{$type_scheduler}', 
							'{$daily_time}', '{$custom_time}')";
				$db->query($sql);
			}
		}
		$go->go('/?do=taskers');
		exit;
		break;
	case 'delete':			
		$deviceid = isset($_POST['deviceid']) ? Clean::int($_POST['deviceid']) : null;
