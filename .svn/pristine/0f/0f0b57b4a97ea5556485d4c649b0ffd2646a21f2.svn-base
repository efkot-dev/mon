	case 'signalpon':			
		$id = isset($_POST['id']) ? Clean::int($_POST['id']) : null;
		if(is_valid_id($id)){
			$switch = $db->Simple("SELECT id, oidid, place FROM switch WHERE id = '{$id}' LIMIT 1");
			$get_pon = get_pon_sfp($switch['id']);
			$oidid = $switch['oidid'];
			if ($oidid == 14) {
				$temp_pon[$switch['id']] = processSignalData('epon', $switch['id']);        
				$temp_pon[$switch['id']] = processSignalData('gpon', $switch['id']);
			} else {
				$temp_pon[$switch['id']] = processSignalData('pon', $switch['id']);
			}
			if(!empty($temp_pon)){
				echo'<table class="signal_sfp">';
				if ($oidid == 15) {
					if(isset($temp_pon[$switch['id']]['pon'])){
						foreach($temp_pon[$switch['id']]['pon'] as $llid => $pon_olt) {
							if (strpos($pon_olt, '1216') !== false){
								$llid = $llid + 4;
							}else{
								$llid = $llid;
							}
							if(isset($temp_pon[$switch['id']]['pon'][$llid])){
								echo format_sfp($get_pon,$llid,$switch,$temp_pon,'pon');
							}
						}
					}	
				}elseif ($oidid == 9) {
					$get_pon = get_pon_sfp_gcom($switch['id']);
					if(isset($temp_pon[$switch['id']]['pon'])){
						foreach($temp_pon[$switch['id']]['pon'] as $llid => $pon_olt) {
							if(isset($temp_pon[$switch['id']]['pon'][$llid])){
								echo format_sfp($get_pon,$llid,$switch,$temp_pon,'pon');
							}
						}
					}						
				}elseif ($oidid == 35) {
					if(isset($temp_pon[$switch['id']]['pon'])){
						foreach($temp_pon[$switch['id']]['pon'] as $llid => $pon_olt) {
							if(isset($temp_pon[$switch['id']]['pon'][$llid]) && strlen((string)$llid) >= 7){
								echo format_sfp($get_pon,$llid,$switch,$temp_pon,'pon');
							}
						}
					}						
				}elseif ($oidid == 14) {
					if(isset($temp_pon[$switch['id']]['gpon'])){
						foreach($temp_pon[$switch['id']]['gpon'] as $llid => $pon_olt) {
							if(isset($temp_pon[$switch['id']]['gpon'][$llid])){
								echo format_sfp($get_pon,$llid,$switch,$temp_pon,'gpon');
							}
						}
					}
