			if (isset($sqlonus) && count($sqlonus) > 0) {
				$onukeys = array_map(function ($ont) {
					return "'" . $ont['onukey'] . "'";
				}, $sqlonus);
				$onukeys = array_unique($onukeys);
				$id_onu = $db->SimpleWhile("SELECT idonu, inface, mac, sn FROM onus	WHERE mac IN (" . implode(',', $onukeys) . ") OR sn IN (" . implode(',', $onukeys) . ")");
				$sql_where = [];
				foreach ($id_onu as $ont) {
					$sql_where[] = $ont['idonu'];
					$temp_inface[$ont['idonu']]['idonu'] = $ont['idonu'];
					$temp_inface[$ont['idonu']]['inface'] = $ont['inface'];
					$temp_inface[$ont['idonu']]['mac'] = (isset($ont['mac']) ? $ont['mac'] : $ont['sn']);
				}
				if (!empty($sql_where)) {
					$ids = implode(",", $sql_where);
					$signals = $db->SimpleWhile("SELECT * FROM `historysignal` WHERE onu IN ($ids) AND datetime >= '{$last_month_date}' ORDER BY datetime ");
				} else {
					$signals = [];
				}
				$js_array_full = [];
				foreach ($signals as $row) {
					if(floatval($row['signal']) > -33) {
						if(floatval($row['signal']) < -14) {
							$js_array_full[$row['onu']][] = [
								'signal' => floatval($row['signal']),'idonu' => $temp_inface[$row['onu']]['idonu'],'mac' => $temp_inface[$row['onu']]['mac'],'inface' => $temp_inface[$row['onu']]['inface'],'datetime' => $row['datetime']
							];
						}
					}
				}
				header('Content-Type: application/json');
				echo json_encode($js_array_full, JSON_PRETTY_PRINT | JSON_UNESCAPED_UNICODE);	
				exit;
			}
		}
		break;	
	case 'find_problem_ports':
		$sw = $db->SimpleWhile("Select place, id FROM switch WHERE device = 'olt' AND monitor = 'yes'");
		$list_switch = [];
		foreach ($sw as $s) {
			$list_switch[$s['id']]['place'] = $s['place'];
		}		
		$swport = $db->SimpleWhile("SELECT id, oltid, pon, sfpid FROM switch_pon");
		$list_switch_port = [];
		foreach ($swport as $pon) {
			$list_switch_port[$pon['oltid']][$pon['sfpid']] = [
				'id'   => $pon['id'],
				'name' => $pon['pon']
			];
		}
		$interval_days = 7;
		$threshold_db  = 1.5;
		$sql = "
			SELECT 
				o.olt,
				o.portolt,
				COUNT(*) AS bad_onu_count
			FROM onus AS o
			JOIN (
				SELECT 
					onu,
					MAX(`signal`) AS maxsig,
					MIN(`signal`) AS minsig
				FROM historysignal
				WHERE datetime >= NOW() - INTERVAL {$interval_days} DAY
				  AND `signal` BETWEEN -39 AND -10
				GROUP BY onu
				HAVING ROUND(minsig - maxsig, 2) > {$threshold_db}
			) AS agg ON agg.onu = o.idonu
			WHERE o.status = '1'
			GROUP BY o.olt, o.portolt
			ORDER BY bad_onu_count DESC
		";
		$rows = $db->SimpleWhile($sql);
		$ports_to_check = [];
		foreach ($rows as $r) {
			if($r['bad_onu_count']>20){
				$ports_to_check[$r['olt']][] = $r['portolt'];
			}
		}
		echo "<pre>";
		echo "Порти, на яких відбувається масова деградація сигналів (>={$threshold_db} dB за {$interval_days} днів):\n";
		echo "=======================================================================\n\n";
		if (empty($ports_to_check)) {
			echo "Портів з проблемами не виявлено.\n";
		} else {
			foreach ($ports_to_check as $olt => $ports) {
				echo "{$list_switch[$olt]['place']}: ";
				#list_switch_port
				foreach ($ports as $pon) {
					if(!empty($list_switch_port[$olt][$pon]['id'])){
						echo "<a href='/?do=core&act=ai&olt={$olt}&portolt={$pon}'>".$list_switch_port[$olt][$pon]['name']."</a>";
					}
				}
				echo"\n";
			}
		}
		echo "</pre>";
		exit;
    break;		
	case 'ai2': 		
		$olt = intval($_GET['olt']);
		$portolt = intval($_GET['portolt']);
		$sql = "SELECT idonu, inface, mac, sn FROM onus WHERE olt = '{$olt}' AND portolt = '{$portolt}' AND status = '1'";
		$id_onu = $db->SimpleWhile($sql);
		$sql_where = [];
		$temp_inface = [];
		foreach ($id_onu as $ont) {
			$onukey = $ont['mac'] ?: $ont['sn'];
			$sqlonus = $db->Simple("SELECT pontree,ponelement,lan,lon FROM onusdata WHERE onukey = '" . $onukey."' LIMIT 1");
			$sqlpon = $db->Simple("SELECT * FROM ponelement WHERE id = '" . $sqlonus['ponelement']."' LIMIT 1");
			$sql_where[] = $ont['idonu'];
			$temp_inface[$ont['idonu']] = [
				'idonu' => $ont['idonu'],
				'inface' => $ont['inface'],
				'ponname' => $sqlpon['name'] ?? '',
				'pontree' => $sqlonus['pontree'] ?? '',
				'ponelemet' => $sqlonus['ponelement'] ?? '',
				'mac' => $onukey
			];
		}
		$ids = implode(",", $sql_where);
		$signals = $db->SimpleWhile("
			SELECT * FROM `historysignal` 
			WHERE onu IN ($ids) 
			  AND datetime >= NOW() - INTERVAL 7 DAY 
			ORDER BY onu, datetime ASC
		");
		$signal_history = [];
		foreach ($signals as $row) {
			$signal = floatval($row['signal']);
			if ($signal > -39 && $signal < -10) {
				$signal_history[$row['onu']][] = [
					'datetime' => $row['datetime'],'signal' => $signal
				];
			}
		}
		$worsening_report = [];
		foreach($signal_history as $onu_id => $entries){
			$prev = null;
			$trend = 0;
			$worsening_sequence = [];
			foreach ($entries as $entry) {
				if ($prev !== null) {
					if ($entry['signal'] < $prev['signal']) {
						$trend++;
						$worsening_sequence[] = $entry;
					} else {
						$trend = 0;
						$worsening_sequence = [];
					}
					if ($trend >= 3) {
						$first_signal = $worsening_sequence[0]['signal'];
						$last_signal = end($worsening_sequence)['signal'];
						$diff_db = round($last_signal - $first_signal, 2);
						if ($diff_db <= -0.5) {
							$worsening_report[$onu_id] = [
								'idonu' => $temp_inface[$onu_id]['idonu'],
								'mac' => $temp_inface[$onu_id]['mac'],
								'inface' => $temp_inface[$onu_id]['inface'],
								'ponname' => $temp_inface[$onu_id]['ponname'],
								'ponelemet' => $temp_inface[$onu_id]['ponelemet'],
								'pontree' => $temp_inface[$onu_id]['pontree'],
								'trend' => $worsening_sequence,
								'delta_db' => $diff_db,
								'description' => "Погіршення на $diff_db dB"
							];
						}
						break;
					}
				} else {
					$worsening_sequence[] = $entry;
				}
				$prev = $entry;
			}
		}
		echo "<pre>";
		echo "Звіт про погіршення сигналу за останні 7 днів\n";
		echo "=============================================\n\n";
		foreach ($worsening_report as $onu) {
			echo "ONU ID: {$onu['idonu']}\n";
			echo "MAC/SN: {$onu['mac']}\n";
			if($onu['ponname']){
				echo "Пон бокс: {$onu['ponname']}\n";
				echo "Пон дерево: {$onu['pontree']}\n";
			}
			echo "Інтерфейс: {$onu['inface']}\n";
			echo "Погіршення: {$onu['delta_db']} dB\n";
			echo "Сигнали:\n";
			foreach ($onu['trend'] as $entry) {
				echo "  - {$entry['datetime']} → {$entry['signal']} dB\n";
			}
			echo "---------------------------------------------\n";
		}
		if (empty($worsening_report)) {
			echo "Погіршень сигналу не виявлено.\n";
		}
		echo "</pre>";
		exit;
		break;		
	case 'ai':
		$olt     = intval($_GET['olt']);
		$portolt = intval($_GET['portolt']);
		$sql = "
			SELECT 
				o.idonu,
				o.inface,
				COALESCE(o.mac, o.sn)     AS onukey,
				od.pontree                AS pontree_id,
				od.ponelement             AS ponelem_id,
				pe.name                   AS ponname,
				pt.name                   AS treename
			FROM onus AS o
			LEFT JOIN onusdata   AS od ON od.onukey    = COALESCE(o.mac, o.sn)
			LEFT JOIN ponelement AS pe ON pe.id        = od.ponelement
			LEFT JOIN pontree    AS pt ON pt.id        = od.pontree
			WHERE o.olt     = '{$olt}'
			  AND o.portolt = '{$portolt}'
			  AND o.status  = '1'
		";
		$meta = $db->SimpleWhile($sql);
		$onu_ids      = [];
		$temp_inface  = [];
		foreach ($meta as $r) {
			$onu_ids[] = $r['idonu'];
			$temp_inface[$r['idonu']] = [
				'idonu'    => $r['idonu'],
				'inface'   => $r['inface'],
				'mac'      => $r['onukey'],
				'ponname'  => $r['ponname']   ?? '',
				'treename' => $r['treename']  ?? ''
			];
		}
		if (empty($onu_ids)) {
			exit('<pre>Немає активних ONU для цього порту.</pre>');
		}
		$ids     = implode(',', $onu_ids);
		$signals = $db->SimpleWhile("
			SELECT onu, datetime, `signal`
			FROM historysignal
			WHERE onu IN ({$ids})
			  AND datetime >= NOW() - INTERVAL 7 DAY
			ORDER BY onu, datetime ASC
		");
		$signal_history = [];
		foreach ($signals as $row) {
			$sig = floatval($row['signal']);
			if ($sig > -39 && $sig < -10) {
				$signal_history[$row['onu']][] = [
					'datetime' => $row['datetime'],'signal'   => $sig
				];
			}
		}
		$worsening_report = [];
		foreach ($signal_history as $onu_id => $entries) {
			$prev   = null;
			$trend  = 0;
			$seq    = [];
			foreach ($entries as $ent) {
				if ($prev !== null && $ent['signal'] < $prev['signal']) {
					$trend++;
					$seq[] = $ent;
				} else {
					$trend = 0;
					$seq   = [$ent];
				}
				if ($trend >= 2) {
					$first  = $seq[0]['signal'];
					$last   = end($seq)['signal'];
					$diff   = round($last - $first, 2);
					if ($diff <= -0.5) {
						$tmp = $temp_inface[$onu_id];
						$worsening_report[$onu_id] = [
							'idonu'       => $tmp['idonu'],
							'mac'         => $tmp['mac'],
							'inface'      => $tmp['inface'],
							'ponname'     => $tmp['ponname'],
							'treename'    => $tmp['treename'],
							'trend'       => $seq,
							'delta_db'    => $diff,
							'description' => "Погіршення на {$diff} dB"
						];
					}
					break;
				}
				$prev = $ent;
			}
		}
		echo "<pre>";
		echo "Звіт про погіршення сигналу за останні 7 днів\n";
		echo "=============================================\n\n";
		if (empty($worsening_report)) {
			echo "Погіршень сигналу не виявлено.\n";
		} else {
			foreach ($worsening_report as $onu) {
				echo "ONU ID: {$onu['idonu']}  |  MAC: {$onu['mac']}  |  Інтерфейс: {$onu['inface']}\n";
				if ($onu['treename'] || $onu['ponname']) {
					echo "PON дерево: {$onu['treename']}  |  Бокс: {$onu['ponname']}\n";
				}
				echo "Погіршення: {$onu['delta_db']} dB\n";
				echo "Сигнали в послідовності:\n";
				foreach ($onu['trend'] as $e) {
					echo "  - {$e['datetime']} → {$e['signal']} dB\n";
				}
				echo "---------------------------------------------\n";
			}
		}
		echo "</pre>";
		exit;
		break;
		
	case 'ponsignal': 		
		$portolt = isset($_GET['portolt']) ? Clean::int($_GET['portolt']) : null;
		$olt = isset($_GET['olt']) ? Clean::int($_GET['olt']) : null;
		if(is_valid_id($portolt)){
			$temp_inface = [];
			$sql = "SELECT idonu,inface,mac,sn FROM onus WHERE olt = '{$olt}' AND portolt = '{$portolt}' AND status = '1'";
			$id_onu = $db->SimpleWhile($sql);
			$sql_where = [];
			foreach ($id_onu as $ont) {
				$sql_where[] = $ont['idonu'];
				$temp_inface[$ont['idonu']]['idonu'] = $ont['idonu'];
				$temp_inface[$ont['idonu']]['inface'] = $ont['inface'];
				$temp_inface[$ont['idonu']]['mac'] = (isset($ont['mac']) ? $ont['mac'] : $ont['sn']);
			}
			if (!empty($sql_where)) {
				$ids = implode(",", $sql_where);
				$signals = $db->SimpleWhile("SELECT * FROM `historysignal` WHERE onu IN ($ids) ORDER BY datetime ASC LIMIT 10000");
			} else {
				$signals = [];
			}			
			$js_array_full = [];
			foreach ($signals as $row) {
				if(floatval($row['signal']) > -33) {
					if(floatval($row['signal']) < -10) {
						$js_array_full[$row['onu']][] = [
							'idonu' => $temp_inface[$row['onu']]['idonu'],
							'signal' => floatval($row['signal']),
							'mac' => $temp_inface[$row['onu']]['mac'],
							'inface' => $temp_inface[$row['onu']]['inface'],
							'datetime' => $row['datetime']
						];
					}
				}
			}
			header('Content-Type: application/json');
			echo json_encode($js_array_full, JSON_PRETTY_PRINT | JSON_UNESCAPED_UNICODE);	
			exit;
		}
		break;		
	case 'oltsignal': 
		$id = isset($_POST['id']) ? Clean::int($_POST['id']) : null;
		$signals = array();
		$counts = array();
		if(is_valid_id($id)){
			$sql_data = ['sql' => "SELECT rx, status FROM onus WHERE status = '1' AND olt = '{$id}'",'key' => 'main_char_signal_'.$id,'type' => 'while','time' => 1200];
			$getallrx = cache_simple_sql($sql_data);
			if(isset($getallrx) && count($getallrx)>3){
				foreach($getallrx as $item) {
					$rx = str_replace("-","",intval($item['rx']));
					if ($rx != 0 && $item['status'] == 1) {
						if (array_key_exists($rx,$signals)) {
							$counts[$rx]++;
						} else {
							$signals[$rx] = $item;
							$counts[$rx] = 1;
						}
					}
				}
				if(is_array($signals)){
					if(isset($counts) && count($counts)>=5){
						$count = count($counts);
						if ($count <= 5) {
							$with =  intval(30/count($counts));
						} elseif ($count > 5 && $count < 10) {
							$with =  intval(60/count($counts));		
						} elseif ($count >= 10 && $count <= 14) {
							$with =  intval(80/count($counts));		
						} else {
							$with = intval(150 / $count);
						}
					$maxvalue = max($counts);
					asort($signals);
					$chart_data = [];
					foreach ($signals as $rxs => $signal) {
						$minbad = (!empty($config['badsignalstart']) ? $config['badsignalstart'] : 26);
						$maxbad = (!empty($config['badsignalend']) ? $config['badsignalend'] : 31);
						if ($rxs < 15) {
							$color = '#fdb910';
						} elseif ($rxs < 18 && $rxs < $minbad) {
							$color = '#339fff';
						} elseif ($rxs < $minbad) {
							$color = '#08bf1c';
						} elseif ($rxs >= $minbad && $rxs < $maxbad) {
							$color = 'red';
						} else {
							$color = 'red';
						}
						$chart_data[] = ['signal' => '-'.$rxs,'count' => $counts[$rxs],'color' => $color];
					}
					}	
				}
			}
			if(isset($getallrx) && count($getallrx)>3){
			$data_json = json_encode($chart_data);
			echo charts_olt_signal($data_json,$id);
			}
		}
		break;
	case 'showdaynew': 
		$day = isset($_GET['day']) ? Clean::int($_GET['day']) : null;
		if ($day !== null && $day > 0) {
			$date = date('Y-m-').$day;
			$startDate = $date . " 00:00:00";
			$endDate = $date . " 23:59:59";
			$query = "
				SELECT 
					o.inface, o.type, o.idonu, o.added, o.online, o.offline, 
					o.status, o.mac, o.sn, o.rx, o.dist, o.olt, o.rxstatus, 
					s.place, s.id AS switch_id 
				FROM onus o
				JOIN switch s ON s.id = o.olt
				WHERE o.added BETWEEN :startDate AND :endDate
			";
			$stmt = $pdo->prepare($query);
			$stmt->execute([
				'startDate' => $startDate,
				'endDate' => $endDate
			]);
			$data = $stmt->fetchAll(PDO::FETCH_ASSOC);
			$tplresult = '<table class="pmon-tab-lite"><thead><tr>
				<th width="5%">'.$lang['status'].'</th>
				<th width="15%">OLT</th>
				<th>Mac Sn</th>
				<th width="10%">'.$lang['inface'].'</th>
				<th width="8%">'.$lang['dist'].'</th>
				<th width="8%">'.$lang['signal'].'</th>
				<th class="mobile" width="15%">
					<span class="inf_status">
						<span class="tim1">'.$lang['online'].'</span>
						<span class="tim2">'.$lang['offline'].'</span>
					</span>
				</th>
				</tr></thead><tbody>';	
			if(isset($data) && $data!=false){
			foreach($data as $ontid => $onu){
					$onukey = (!empty($onu['mac'])?$onu['mac']:(!empty($onu['sn'])?$onu['sn']:'n/a'));
					$onuname = (!empty($onu['name'])? '<span class="bad_name_onu">'.$onu['name'].'</span>':'');
					$tplresult .= '<tr>
					<td><span class="statusonu st_'.$onu['status'].'"</span></td>
					<td class="td_place"><a href="/?do=detail&act=olt&id='.$onu['olt'].'">'.$onu['place'].'</a></td>
					<td class="td_onu">
					<a href="/?do=onu&id='.$onu['idonu'].'">'.($onu['status']==2?'<font color="grey">':'').''.$onukey.' '.$onuname.'</a>
					<span class=\'copy\' onclick="enableCopyOnClick(\''.$onukey.'\')"><img src=\'../style/img/copy.png\'></span>
					</td>
					<td class="td_inface">'.strtoupper($onu['type']).' '.$onu['inface'].'</td>
					<td class="td_dist">'.($onu['dist'] ? metersToKilometers($onu['dist']) : '').'</td>';
					$ex_ono = '';
					if(isset($onu['rx']) && $onu['rx']!=false){
						$ex_ono = signalTerminal($onu['rx']).($onu['rxstatus']=='up' || $onu['rxstatus']=='down' ? '<span class="signaldown"><i class="fi fi-rr-angle-small-'.$onu['rxstatus'].'"></i></span>':'');
					}
					$tplresult .= '<td class="bad_list">'.($onu['status']==2?'':$ex_ono).'</td>';
					$tplresult .= '<td class="mobile">';
						if($onu['status']==1){
							$tplresult .= '<span class="on_">'.aftertime($onu['online']).'</span>';
						}else{
							$tplresult .= '<span class="off_">'.aftertime($onu['offline']).'</span>';
						}
					$tplresult .= '</td>';
					$tplresult .= '</tr>';
				}
			}else{
				$tplresult .= '<tr><td colspan="9">'.$lang['empty'].'</td></tr>';
			}
			$tplresult .= '</table>';
			echo $tplresult;
		} else {
			echo json_encode(['error' => 'Невірна дата']);
		}
		break;	
	case 'showdayoff': 
		$day = isset($_GET['day']) ? Clean::int($_GET['day']) : null;
		if ($day !== null && $day > 0) {
			$date = date('Y-m-').$day;
			$startDate = $date . " 00:00:00";
			$endDate = $date . " 23:59:59";
			$query = "
				SELECT 
					o.inface, o.type, o.idonu, o.added, o.online, o.offline, 
					o.status, o.mac, o.sn, o.rx, o.dist, o.olt, o.rxstatus, 
					s.place, s.id AS switch_id 
				FROM onus o
				JOIN switch s ON s.id = o.olt
				WHERE o.status = 2 AND o.offline BETWEEN :startDate AND :endDate
			";
			$stmt = $pdo->prepare($query);
			$stmt->execute([
				'startDate' => $startDate,
				'endDate' => $endDate
			]);
			$data = $stmt->fetchAll(PDO::FETCH_ASSOC);
			$tplresult = '<table class="pmon-tab-lite"><thead><tr>
				<th width="5%">'.$lang['status'].'</th>
				<th width="15%">OLT</th>
				<th>Mac Sn</th>
				<th width="10%">'.$lang['inface'].'</th>
				<th width="8%">'.$lang['dist'].'</th>
				<th width="8%">'.$lang['signal'].'</th>
				<th class="mobile" width="15%">
					<span class="inf_status">
						<span class="tim1">'.$lang['online'].'</span>
						<span class="tim2">'.$lang['offline'].'</span>
					</span>
				</th>
				</tr></thead><tbody>';	
			if(isset($data) && $data!=false){
			foreach($data as $ontid => $onu){
					$onukey = (!empty($onu['mac'])?$onu['mac']:(!empty($onu['sn'])?$onu['sn']:'n/a'));
					$onuname = (!empty($onu['name'])? '<span class="bad_name_onu">'.$onu['name'].'</span>':'');
					$tplresult .= '<tr>
					<td><span class="statusonu st_'.$onu['status'].'"</span></td>
					<td class="td_place"><a href="/?do=detail&act=olt&id='.$onu['olt'].'">'.$onu['place'].'</a></td>
					<td class="td_onu">
					<a href="/?do=onu&id='.$onu['idonu'].'">'.($onu['status']==2?'<font color="grey">':'').''.$onukey.' '.$onuname.'</a>
					<span class=\'copy\' onclick="enableCopyOnClick(\''.$onukey.'\')"><img src=\'../style/img/copy.png\'></span>
					</td>
					<td class="td_inface">'.strtoupper($onu['type']).' '.$onu['inface'].'</td>
					<td class="td_dist">'.($onu['dist'] ? metersToKilometers($onu['dist']) : '').'</td>';
					$ex_ono = '';
					if(isset($onu['rx']) && $onu['rx']!=false){
						$ex_ono = signalTerminal($onu['rx']).($onu['rxstatus']=='up' || $onu['rxstatus']=='down' ? '<span class="signaldown"><i class="fi fi-rr-angle-small-'.$onu['rxstatus'].'"></i></span>':'');
					}
					$tplresult .= '<td class="bad_list">'.($onu['status']==2?'':$ex_ono).'</td>';
					$tplresult .= '<td class="mobile">';
						if($onu['status']==1){
							$tplresult .= '<span class="on_">'.aftertime($onu['online']).'</span>';
						}else{
							$tplresult .= '<span class="off_">'.aftertime($onu['offline']).'</span>';
						}
					$tplresult .= '</td>';
					$tplresult .= '</tr>';
				}
			}else{
				$tplresult .= '<tr><td colspan="9">'.$lang['empty'].'</td></tr>';
			}
			$tplresult .= '</table>';
			echo $tplresult;
		} else {
			echo json_encode(['error' => 'Невірна дата']);
		}
		break;
	case 'stats_added':         
		$query = "SELECT DATE(added) as day, COUNT(*) as count 
				  FROM onus 
				  WHERE YEAR(added) = YEAR(CURDATE()) 
				  AND MONTH(added) = MONTH(CURDATE()) 
				  GROUP BY day 
				  ORDER BY day ASC";
		$stmt = $pdo->query($query);
		$data = $stmt->fetchAll(PDO::FETCH_ASSOC);
		$dates = [];
		for ($i = 6; $i >= 0; $i--) {
			$date = date('Y-m-d', strtotime("-{$i} days"));
			$day = date('d', strtotime($date));
			$dates[$day] = 0;
		}
		foreach ($data as $row) {
			$day = date('d', strtotime($row['day']));
			if ($row['count'] < 80) {
				$dates[$day] = (int)$row['count'];
			}
		}
		echo json_encode($dates);
		break;	
	case 'stats_disconnect':         
		$query = "SELECT DATE(offline) as day, COUNT(*) as count 
				  FROM onus 
				  WHERE YEAR(offline) = YEAR(CURDATE()) 
				  AND MONTH(offline) = MONTH(CURDATE()) AND status = 2
				  GROUP BY day 
				  ORDER BY day ASC";
		$stmt = $pdo->query($query);
		$data = $stmt->fetchAll(PDO::FETCH_ASSOC);
		$dates = [];
		for ($i = 6; $i >= 0; $i--) {
			$date = date('Y-m-d', strtotime("-{$i} days"));
			$day = date('d', strtotime($date));
			$dates[$day] = 0;
		}
		foreach ($data as $row) {
			$day = date('d', strtotime($row['day']));
			if ($row['count'] < 80) {
				$dates[$day] = (int)$row['count'];
			}
		}
		echo json_encode($dates);
		break;
	case 'taskers': 		
		$id = isset($_POST['id']) ? Clean::int($_POST['id']) : null;
		if(is_valid_id($id) && $access->get('dev' . $id)) {
			$sql_list_taskers = $db->SimpleWhile("SELECT * FROM `taskers` WHERE deviceid ='{$id}'");
			echo'<div id="min_list_taskers">';
			foreach ($sql_list_taskers as $taskers) {
				echo'<div class="list_taskers" >';
				echo"<a class=\"panel_house rr_1\" href=\"/#\" onclick=\"deleteTask('system','{$taskers['id']}',event)\">{$lang['delet']}</a>
				";
				echo'<div class="lang" onclick="taskers_get(\'Do you really want to complete the task?\','.$taskers['workid'].','.$id.')">'.$lang['taskers_'.$taskers['workid']].'</div>';
				echo'<div class="date">'.aftertime($taskers['last_run_time']).'</div>';
				//echo'<div class="runer">Get start</div>';
				echo'</div>';
				
			}
			echo'</div>';
		}
		exit;
		break;
}
exit;
?>