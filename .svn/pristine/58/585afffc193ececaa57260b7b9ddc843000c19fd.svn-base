if (isset($frog_onus) && count($data_pon) > 0) {
    foreach ($frog_onus as $ont_get) {
        $pontree[$ont_get['pontree']]['online'] = $onu_online[$ont_get['pontree']];
        $pontree[$ont_get['pontree']]['offline'] = $onu_offline[$ont_get['pontree']];
    }	
}
*/
}
?>
