<?php
if (!defined('PONMONITOR')){
	die('Hacking attempt!');
}
if(!checkAccess(4)){
	$go->redirect('main');	
}
switch($act){
	case 'porterror': 
		$db->query('TRUNCATE switch_port_err;');
		break;		
	case 'logger': 
		$db->query('TRUNCATE pmonstats;');
		$db->query('TRUNCATE swlogport;');
		$db->query('TRUNCATE pingstats;');
		break;	
	case 'voltage': 		
		$db->query('TRUNCATE mon_voltage;');
		break;	
	case 'historysignal': 
		$db->query('TRUNCATE historysignal;');
		break;		
	case 'historysignals': 
		$db->query('TRUNCATE rxolt_signal;');
		break;		
	case 'sender': 
		$db->query('TRUNCATE sender;');
		break;		
	case 'devicelogs': 
		$sqlcount = $db->Simple('TRUNCATE TABLE devicelogs');
		break;	
}
$go->redirect('operator');
die;
?>