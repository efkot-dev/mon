DirectoryIndex index.php index.html
Options -Indexes

RewriteEngine On

RewriteRule "(^|/)\." - [F,L]
RewriteRule ^vendor/ - [F,L]
RewriteRule ^install/ - [F,L]
RewriteRule ^export/ - [F,L]
RewriteRule ^\.svn/ - [F,L]
RewriteRule ^inc/ - [F,L]
RewriteRule ^engine/ - [F,L]
RewriteRule ^update\.php$ - [F,L]
RewriteRule ^cron\.php$ - [F,L]

<FilesMatch "\.(sql|sh|database|insert|bak|backup|ini|log|env|json)$">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    Header unset X-Powered-By
    Header unset X-Powered-CMS
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-XSS-Protection "1; mode=block"
</IfModule>
