ALTER TABLE `notification` CONVERT TO CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
ALTER TABLE `tmc_tovar`
CHANGE `model` `name` text COLLATE 'utf8_general_ci' NULL AFTER `id`,
CHANGE `sn` `mac` text COLLATE 'utf8_general_ci' NULL AFTER `name`,
ADD `inv_number` text COLLATE 'utf8_general_ci' NULL AFTER `mac`,
CHANGE `count_type` `length` int(11) NULL AFTER `price`,
CHANGE `count` `status` int(11) NULL AFTER `length`,
ADD `userid` int(11) NULL AFTER `status`,
ADD `provideid` int(11) NULL AFTER `userid`,
ADD `warehousemanid` int(11) NULL AFTER `provideid`,
ADD `invoiceid` int(11) NULL AFTER `warehousemanid`,
ADD `act_writing_id` int(11) NULL AFTER `invoiceid`,
CHANGE `devicetype` `types` int(11) NULL AFTER `act_writing_id`,
ADD `writtenoff` datetime NULL;
ALTER TABLE `tmc_category`
ADD `number` varchar(10) COLLATE 'utf8_general_ci' NULL AFTER `note`;

CREATE TABLE `tmc_nakladna` (
  `id` int(11) unsigned NOT NULL AUTO_INCREMENT,
  `provider` text DEFAULT NULL,
  `providerid` int(11) DEFAULT NULL,
  `nomer` text DEFAULT NULL,
  `userid` text DEFAULT NULL,
  `added` datetime DEFAULT NULL,
  PRIMARY KEY (`id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8 COLLATE=utf8_general_ci;

CREATE TABLE `tmc_move` (
  `id` int(11) unsigned NOT NULL AUTO_INCREMENT,
  `userid` int(11) DEFAULT NULL,
  `tovarid` int(11) DEFAULT NULL,
  `count` int(11) DEFAULT NULL,
  `nomer` text DEFAULT NULL,
  `added` datetime DEFAULT NULL,
  PRIMARY KEY (`id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8 COLLATE=utf8_general_ci;

CREATE TABLE `tmc_transport` (
  `id` int(11) unsigned NOT NULL AUTO_INCREMENT,
  `userid` int(11) DEFAULT NULL,
  `nomer` text DEFAULT NULL,
  `added` datetime DEFAULT NULL,
  PRIMARY KEY (`id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8 COLLATE=utf8_general_ci;

ALTER TABLE `tmc_move`
CHANGE `nomer` `nomer` int(11) NULL AFTER `count`;

CREATE TABLE `tmc_catalog` (
  `id` int(11) unsigned NOT NULL AUTO_INCREMENT,
  `model` text DEFAULT NULL,
  `image` text DEFAULT NULL,
  `note` text DEFAULT NULL,
  `types` int(11) DEFAULT NULL,
  `added` datetime DEFAULT NULL,
  PRIMARY KEY (`id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8 COLLATE=utf8_general_ci;

ALTER TABLE `tmc_tovar`
ADD `catalogid` int(11) NULL AFTER `userid`;

ALTER TABLE `appmessage`
RENAME TO `message`;

ALTER TABLE monitor_temp
ADD lan varchar(60) COLLATE 'utf8_general_ci' NULL AFTER energy,
ADD lon varchar(60) COLLATE 'utf8_general_ci' NULL AFTER lan;

ALTER TABLE `users`
ADD `access` ENUM('yes','no')
COLLATE utf8_general_ci
DEFAULT 'yes'
NULL
AFTER `hideonu`;


ALTER TABLE users MODIFY COLUMN password VARCHAR(255) NOT NULL;





