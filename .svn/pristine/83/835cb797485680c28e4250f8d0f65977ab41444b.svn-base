CREATE TABLE `ponmap` (
    `id` INT(11) UNSIGNED AUTO_INCREMENT PRIMARY KEY,
    `status` INT(11) NULL,
    `added` DATETIME NULL,
    `name` TEXT NULL,
    `note` TEXT NULL,
    `update` DATETIME NULL,
	`ponid` INT(11) NULL,
    `treeid` INT(11) NOT NULL,
    `elementid` INT(11) NOT NULL
);
CREATE TABLE `ponmap_elements` (
    `id` INT(11) UNSIGNED AUTO_INCREMENT PRIMARY KEY,
    `elementid` INT(11) NOT NULL,
    `name` TEXT NULL,
    `description` TEXT NULL,
    `type` TEXT NULL,
    `position` TEXT NULL,
    `top` INT(11) NULL,
    `left` INT(11) NULL
);
CREATE TABLE `ponmap_connectors` (
    `id` INT(11) UNSIGNED AUTO_INCREMENT PRIMARY KEY,
    `element_id` INT(11) UNSIGNED NOT NULL,
    `connector_type` ENUM('input', 'output') NOT NULL,
    `connector_name` TEXT NULL,
    `connected` TEXT NULL,
    FOREIGN KEY (`element_id`) REFERENCES `ponmap_elements`(`id`) ON DELETE CASCADE
);
CREATE TABLE `ponmap_connect` (
    `id` INT(11) UNSIGNED AUTO_INCREMENT PRIMARY KEY,
    `elementid` INT(11) NOT NULL,
    `name` TEXT NULL,
    `color` TEXT NULL,
    `connect1` TEXT NULL,
    `connect2` TEXT NULL,
        `in1` TEXT NULL,
    `in2` TEXT NULL,
    `border` INT(11) NULL
);

ALTER TABLE `ponmap_connect` ADD `connect` text COLLATE 'utf8_unicode_ci' NULL AFTER `name`;
ALTER TABLE `ponmap_connect` ADD `povorot` int(11) NULL;

ALTER TABLE `kabel_position`
CHANGE `xtop` `top` int(11) NULL AFTER `typesid`,
CHANGE `xleft` `left` int(11) NULL AFTER `top`;

ALTER TABLE `kabel_position`
CHANGE `typesid` `connectid` int(11) NULL AFTER `id`,
ADD `elementid` int(11) NULL AFTER `connectid`;
ALTER TABLE `kabel_position`
ADD `position` varchar(10) NULL;

ALTER TABLE `kabel_connector`
ADD `vokid` text(200) NULL AFTER `typesid`,
DROP `connectstart`,
DROP `connectend`;

ALTER TABLE `kabel_connector` ADD `elementid` int(11) NULL AFTER `typesid`;
ALTER TABLE `kabel_connector` ADD `element` int(11) NULL AFTER `typesid`;
ALTER TABLE `ponelement` ADD `mereja` varchar(255) COLLATE 'utf8_general_ci' NOT NULL AFTER `name`;
ALTER TABLE `pontree` ADD `mereja` varchar(50) COLLATE 'utf8_general_ci' NULL;
ALTER TABLE `ponmap_connect` ADD `p1` int(11) NULL AFTER `color`;
ALTER TABLE `ponmap_connect` ADD `p2` int(11) NULL AFTER `p1`;
