<?php
if (!defined('PONMONITOR')){
	die('Hacking attempt!');
}
define('VLANPARSER',true);
$timer = date('Y-m-d H:i:s');
$starttime = microtime(true);
require ROOT_DIR.'/inc/init.monitor.php';
require ROOT_DIR.'/inc/classes/vlan.class.php';
if(isset($olt) && $olt>0){
	$id_device = intval($olt);
}
if(isset($id_device) && $id_device>0){
	$res = $pdo->query("SELECT oidid, id, netip, snmpro, place FROM switch WHERE id = '{$id_device}' LIMIT 1");
	$getswitch = $res->fetch(PDO::FETCH_ASSOC);
	if (isset($getswitch['oidid']) && $getswitch['oidid']>0 && isset($getswitch['snmpro']) && isset($getswitch['netip'])) {
		$vlan_parser = new PMon_VLAN($getswitch['id'], $pdo, $getswitch, $confPMon);
		if ($getswitch['oidid'] == 1) {
			$vlan_parser->BDCOM_Vlan_Epon();
		}elseif($getswitch['oidid'] == 41){
			$vlan_parser->CDATA16v3_Vlan_Gpon();
		}elseif($getswitch['oidid'] == 6){	
			$vlan_parser->ZTE6_Vlan_Gpon();
		}elseif(($getswitch['oidid'] == 7) || ($getswitch['oidid'] == 34)){

		}elseif(($getswitch['oidid'] == 14) || ($getswitch['oidid'] == 33)){
			$vlan_parser->Huawei_Vlan();
		}elseif($getswitch['oidid'] == 35){			
			$vlan_parser->CDATA16v3_Vlan_Gpon();
		}elseif($getswitch['oidid'] == 13){
		
		}elseif($getswitch['oidid'] == 15){
			$vlan_parser->CDATA12_Vlan_Epon();
		}
	}	
}
?>
