CREATE TABLE `onus_log` (
  `id` int(11) UNSIGNED NOT NULL AUTO_INCREMENT,
  `idonu` int(11) DEFAULT NULL,
  `idolt` int(11) DEFAULT NULL,
  `iduser` int(11) DEFAULT NULL,
  `types` enum('cron','system','user','switch') DEFAULT 'system',
  `info` text,
  `added` datetime DEFAULT NULL,
  PRIMARY KEY (`id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8;

ALTER TABLE onusdata CONVERT TO CHARACTER SET utf8 COLLATE utf8_general_ci;
ALTER TABLE devicelogs CONVERT TO CHARACTER SET utf8 COLLATE utf8_general_ci;
ALTER TABLE kabel CONVERT TO CHARACTER SET utf8 COLLATE utf8_general_ci;
