CREATE TABLE competitor_locations (
    id INT(11) AUTO_INCREMENT PRIMARY KEY,
    act VARCHAR(20) NOT NULL,
    competitorid INT(11) NOT NULL,
    name VARCHAR(200) NOT NULL,
    color CHAR(7) NOT NULL,
    coordinates JSON NOT NULL,
    locationid INT(11),
    locationname VARCHAR(300),
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);
ALTER TABLE `competitor_locations`
CHANGE `act` `act` varchar(20) COLLATE 'utf8_unicode_ci' NULL AFTER `id`,
CHANGE `competitorid` `competitorid` int(11) NULL AFTER `act`,
CHANGE `name` `name` varchar(200) COLLATE 'utf8_unicode_ci' NULL AFTER `competitorid`,
CHANGE `color` `color` char(7) COLLATE 'utf8_unicode_ci' NULL AFTER `name`,
CHANGE `coordinates` `coordinates` longtext COLLATE 'utf8mb4_bin' NULL AFTER `color`,
CHANGE `created_at` `created_at` timestamp NULL DEFAULT current_timestamp() AFTER `locationname`;

UPDATE `rules` SET `descr` = 'rules_great_zvit' WHERE `types` = 'great_zvit';
UPDATE `rules` SET `descr` = 'rules_great_template' WHERE `types` = 'great_template';
UPDATE `rules` SET `descr` = 'rules_duble_onu' WHERE `types` = 'duble_onu';
UPDATE `rules` SET `descr` = 'rules_view_map' WHERE `types` = 'view_map';
UPDATE `rules` SET `descr` = 'rules_pon_load' WHERE `types` = 'pon_load';

ALTER TABLE `switch` ADD `snmp_access` enum('up','down','none') COLLATE 'utf8_general_ci' NULL AFTER `ping`, DROP `up1`,DROP `up2`,DROP `up3`,DROP `up4`,DROP `up5`,DROP `up6`,DROP `up7`,DROP `up8`,DROP `up9`,DROP `up10`;