<div class="nav-fiber p10">
<form action="/?do=fiber" method="post" id="savecabel">
<div class="add-kabel">
<input name="act" type="hidden" value="savekabel">
<label class="pol"><span class="val">[lang:kolirvog]:</span><span class="dal"><input class="selcolor" type="color" id="color" name="color"></span></label>
<label class="pol"><span class="val">[lang:modelkable]:</span><span class="dal"><input class="input2" type="text" id="name" name="name" autocomplete="off"  required /></span></label>
<label class="pol"><span class="val">[lang:countvolokon]:</span><span class="dal"><input class="input2 w50" type="text" id="volokon" name="volokon" ></span></label>
<label class="pol"><span class="val">[lang:countmodule]:</span><span class="dal"><input class="input2 w50" type="text" id="modules" name="modules" ></span></label>    
</div> 
<div id="colors"></div>
<div class="polebtn">
<button type="submit" form="savecabel" value="submit">[lang:add]</button>
</div>
</form>
<script>
document.getElementById("volokon").addEventListener("input", addColorFields);
document.getElementById("modules").addEventListener("input", addColorFields);
</script>
</div>