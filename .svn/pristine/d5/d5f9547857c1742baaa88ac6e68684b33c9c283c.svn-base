<?php

if (!defined('PONMONITOR')) {
    die('Hacking attempt!');
}
define('QUEUE', true);
define('CONFIG', true);
$data_pmon = date('Y-m-d');
require_once ROOT_DIR . '/inc/database.php';
require_once ENGINE_DIR . 'init.time.php';
require_once ENGINE_DIR . 'init.pmon.php';
require_once ENGINE_DIR . 'functions/pmon.php';
require_once ROOT_DIR . '/vendor/autoload.php';
require_once ENGINE_DIR . 'init.queue.php';
if (!defined('PMON_TASK_LOCK_SECONDS')) {
    define('PMON_TASK_LOCK_SECONDS', 1);
}
$current_time = time();
$pmon_time = date('Y-m-d H:i:s');
$stmt = $pdo->prepare("
    SELECT 
        id,
        workid,
        deviceid,
        type,
        last_run_time,
        `interval`,
        type_scheduler,
        daily_time
    FROM taskers
    WHERE pmon = 'work'
");
$stmt->execute();
$tasks = $stmt->fetchAll(PDO::FETCH_ASSOC);
if (!$tasks) {
    exit;
}
foreach ($tasks as $task) {
    $last_run_time = (
        !empty($task['last_run_time']) &&
        $task['last_run_time'] !== '0000-00-00 00:00:00'
    ) ? strtotime($task['last_run_time']) : 0;

    $should_run = false;
    if ($task['type_scheduler'] === 'manual') {
        if ($current_time >= ($last_run_time + (int)$task['interval'])) {
            $should_run = true;
        }
    } else {
        switch ($task['type_scheduler']) {
            case 'hourly':
                if ($last_run_time === 0 || $current_time >= $last_run_time + 3600) {
                    $should_run = true;
                }
                break;
            case 'daily':
                $daily_time = $task['daily_time'] ?: '00:00:00';
                $scheduled_timestamp = strtotime($data_pmon . ' ' . $daily_time);
                if ($last_run_time < $scheduled_timestamp && $current_time >= $scheduled_timestamp) {
                    $should_run = true;
                }
                break;
        }
    }
    if (!$should_run) {
        continue;
    }
    $lock = $pdo->prepare("
        UPDATE taskers
        SET last_run_time = :time,
            status = 'running'
        WHERE id = :id
          AND (
                last_run_time IS NULL
             OR last_run_time = '0000-00-00 00:00:00'
             OR last_run_time < :limit
          )
    ");
    $lock->execute([
        'time' => $pmon_time,
        'id' => $task['id'],
        'limit'=> date('Y-m-d H:i:s', $current_time - (int)PMON_TASK_LOCK_SECONDS)
    ]);
    if ($lock->rowCount() === 0) {
        continue;
    }
    $task_data = [
        'id' => (int)$task['id'],
        'workid' => (int)$task['workid'],
        'type' => ($task['type'] === 'monitor') ? 'monitor' : 'system',
    ];
    if ($task['type'] === 'monitor') {
        $task_data['device_id'] = (int)$task['deviceid'];
    }
    $message = $context->createMessage(json_encode($task_data));
    $context->createProducer()->send($queue, $message);
}
?>
