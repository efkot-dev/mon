<table width="100%"><tr>
<td width="10%">Шаблон</td>
<td>
<form action="/" method="get" class="flex">
<input type="hidden" name="do" value="regonu">
<input type="hidden" name="act" value="edit">
<input placeholder="[lang:name]" autocomplete="off" name="name" class="css_select" type="text" style="width:200px;" required>
<button type="submit" class="css_add" value="submit">[lang:save]</button>
</form>		
</td>
<td width="10%">Переміна</td><td>
<form action="/" method="post" class="flex">
<input type="hidden" name="do" value="regonu">
<input type="hidden" name="act" value="parametr">
<input placeholder="Назва" autocomplete="off" name="name" class="css_select" type="text" style="width:200px;" required>
<input placeholder="Параметр" autocomplete="off" name="value" class="css_select" type="text" style="width:200px;" required>
<button type="submit" class="css_add" value="submit">[lang:save]</button>
</form>
</td>
</tr>
</table>
</br>