function start_time(act,id) {
	var active;
    if (act === 'start') {
        active = 's';
    } else if (act === 'end') {
        active = 'e';
    } else {
        return;
    }
	$(".edit_" + act + "").hide();
	$.post(root + "ajax/calendar.php",{act:act,id:id}, function(response) {
		$("#" + act + "_time").html(response);
	}, "html");
}
function form_start_time(act, id) {
    var active;
    if (act === 'start') {
        active = 's';
    } else if (act === 'end') {
        active = 'e';
    } else {
        console.error('Invalid action type');
        return;
    }

    $(".block_" + act + "_time").hide();
    var timed = $('#form_' + act + '_time').val();
    
    $.post(root + "ajax/calendar.php", {act: 'edit_' + active, id: id, timed: timed}, function(response) {
        $("#" + active + "_time").html(response);
    }, "html");
}
