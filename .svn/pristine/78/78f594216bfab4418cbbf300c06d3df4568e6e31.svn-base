function validateForm() {
	var checkboxes = document.querySelectorAll('.checkcss');
	var isChecked = false;
	checkboxes.forEach(function(checkbox) {
	if (checkbox.checked) {
		isChecked = true;
	}
	});
	if (!isChecked) {
		alert('Будь ласка, виберіть хоча б одну лінію');
		return false;
	}	
	var selectedValue = document.getElementById('type_pillar').value;
    if (selectedValue === "0") {
        alert('Будь ласка, оберіть тип стовпа.');
        return false;
    }
	return true;
}
function switchMap(mapType) {
    if (map.hasLayer(layers[currentMap])) {
        map.removeLayer(layers[currentMap]);
    }
    map.addLayer(layers[mapType]);
    currentMap = mapType;
}
function PMonexportToExcel(table,namefile) {
    var table = document.getElementById(table); 
    var data = [[]];
    for (var i = 0; i < table.rows[0].cells.length; i++) {
        data[0].push(table.rows[0].cells[i].innerText);
    }
    for (var i = 1; i < table.rows.length; i++) {
        var row = [];
        for (var j = 0; j < table.rows[i].cells.length; j++) {
            row.push(table.rows[i].cells[j].innerText);
        }
        data.push(row);
    }
    var ws = XLSX.utils.aoa_to_sheet(data);
    var wb = XLSX.utils.book_new();
    XLSX.utils.book_append_sheet(wb, ws, "PMon");
    XLSX.writeFile(wb, "pmon_zvit_" + namefile + ".xlsx");
}
function get_object_port() {
	$('.load-port').each(function() {
		var element = $(this);
		var id = element.attr('id');
		var idArray = id.split('-');
		var device = idArray[1];
		var port = idArray[2];    
		$.post(root+'ajax/port.php', { act: 'status', device: device , port: port })
		.done(function(response) {
