function displayGraph(id) {
    fetch(root + "ajax/bandwidth.php?id=" + id)
    .then(response => response.json())
    .then(data => {
        const chartdiv = am5.Root.new("chartdiv" + id, am5.Root);
        const seriesIn = chartdiv.series.push(new am5xy.LineSeries());
        seriesIn.data.setAll(data.data.map((timestamp, index) => ({
            date: new Date(timestamp),
            value: data.traffic[index].in
        })));
        seriesIn.name = "Вхідний трафік";
        seriesIn.stroke = am5.color("blue");
        const seriesOut = chartdiv.series.push(new am5xy.LineSeries());
        seriesOut.data.setAll(data.data.map((timestamp, index) => ({
            date: new Date(timestamp),
            value: data.traffic[index].out
        })));
        seriesOut.name = "Вихідний трафік";
        seriesOut.stroke = am5.color("red");
        // Вимикаємо відображення точок
        seriesIn.points.template.disabled = true;
        seriesOut.points.template.disabled = true;
        // Встановлюємо опції графіка
        chartdiv.xAxes.push(new am5xy.DateAxis());
        chartdiv.yAxes.push(new am5xy.ValueAxis());
        // Опції для формату дати
        const dateAxis = chartdiv.xAxes.getIndex(0);
        dateAxis.renderer.labels.template.adapter.add("text", function(text) {
            return am5.timeFormatter({ input: "yyyy-MM-dd HH:mm:ss" }).format(text);
        });
    });
}

function displayGraph2(id) {
    fetch(root + "ajax/bandwidth.php?id=" + id)
    .then(response => response.json())
    .then(data => {
        const container = document.getElementById('graph' + id);
        const chartContainer = document.createElement('canvas');
        chartContainer.classList.add('graph-chart');
        container.appendChild(chartContainer);
        const ctx = chartContainer.getContext('2d');
        const myChart = new Chart(ctx, {
            type: 'line',
            data: {
                labels: data.data,
                datasets: [{
                    label: 'Вхідний трафік',
                    data: data.traffic.map(entry => entry.in),
                    borderColor: 'blue',
                    fill: false,
                    pointRadius: 0, // Вимкнення відображення точок
                    tension: 0.2 // Задання ступеня плавності
                }, {
                    label: 'Вихідний трафік',
                    data: data.traffic.map(entry => entry.out),
                    borderColor: 'red',
                    fill: false,
                    pointRadius: 0, // Вимкнення відображення точок
                    tension: 0.2 // Задання ступеня плавності
                }]
            },
            options: {
                scales: {
                    x: { // Вимикаємо вісь X
                        display: false
                    },
                    y: {
                        beginAtZero: true
                    }
                }
            }
        });
    });
}
function updateFields() {
    var count = parseInt($("#count_tovar").val(), 10);
    if (!isNaN(count) && count > 0) {
        $(".dynamic-fields").empty();            
        for (var i = 1; i <= count; i++) {
            var container = $("<div>").addClass("field-container");
            var labelInv = $("<label>").text("Інвентарний номер [" + i + "]");
            var inputInv = $("<input>").attr({
                type: "text",
                name: "sn[" + i + "]",
                class: "input_cut",
            });
            var formContainer = $("<div>").addClass("form_tovar");
            formContainer.append(labelInv).append(inputInv);
            container.append(formContainer);
            var labelMac = $("<label>").text("MAC [" + i + "]");
            var inputMac = $("<input>").attr({
                type: "text",
                name: "mac[" + i + "]",
                class: "input_cut",
            });
            var formContainer_ = $("<div>").addClass("form_tovar_m");
            formContainer_.append(labelMac).append(inputMac);
            container.append(formContainer_);
            $(".dynamic-fields").append(container);
        }
    }
}
