//Живой поиск
$(function(){
  var queryTimeout;  
  $('.form_search').on('input', function() {
    clearTimeout(queryTimeout);
    var query = $(this).find('input[name="zapros"]').val();
    if (query.length >= 2) {
      queryTimeout = setTimeout(function() {
        $.ajax({
          url: root + "ajax/search.php",
          type: "POST",
          data: {zapros: query},
          dataType: "text",
          success: function(data) {
            $("#ajax_search").html(data).fadeIn();
          }
        });
      }, 500); // Wait for 500 milliseconds before sending the request
    }
  });
});
//Живой пошук ОЛТ
$(function(){
  var queryTimeouts;  
  $('.searchform').on('input', function() {
    clearTimeout(queryTimeouts);
    var query = $(this).find('input[name="zapros"]').val();
	var typedevice = $('#typedevice').val();
    if (query.length >= 1) {
      queryTimeouts = setTimeout(function() {
        $.ajax({
          url: root + "ajax/search_olt.php",
          type: "POST",
          data: {zapros: query,typedevice: typedevice},
          dataType: "text",
          success: function(data) {
            $("#result-ajax").html(data).fadeIn();
          }
        });
      }, 500);
    }
  });
});

function get_object_sfp() {
	$('.load-sfp-data').each(function() {
    var element = $(this);
    var id = element.attr('id');
    var idArray = id.split('-');
    var iddevice = idArray[1];
    var idport = idArray[2];    
    $.post(root+'ajax/getsfp.php', { iddevice: iddevice, idport: idport })
    .done(function(response) {
        element.html(response);
    })
    .fail(function() {
        element.html('Error occurred while loading.');
    });
	});
}
function addColorFields() {
	var volokonCount = document.getElementById("volokon").value;
	var moduleCount = document.getElementById("modules").value;
	var colorsDiv = document.getElementById("colors");
	colorsDiv.innerHTML = "";	  
	if (moduleCount > 0) {
	for (var j = 1; j <= moduleCount; j++) {
		var moduleDiv = document.createElement("div");
		moduleDiv.id = "moduleblock";
		moduleDiv.innerHTML = "<div class=namemodule><span>Колір для модуля #" + j + "</span> <input class='selcolor' type='color' id='mon" + j + "' name='mod" + j + "' ></div>";
		for (var i = 1; i <= volokonCount; i++) {
			var label = document.createElement("label");
			label.for = "vol" + j + "_" + i;
			label.innerHTML = "<span>Колір волокна #" + i + "</span> <input class='selcolor' type='color' id='vol" + j + "_" + i + "' name='vol" + j + "_" + i + "'>";
			moduleDiv.appendChild(label);
		}
		colorsDiv.appendChild(moduleDiv);
	}
	}
}
