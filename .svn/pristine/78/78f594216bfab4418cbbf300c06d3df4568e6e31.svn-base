function car(act, id) {
    $("#loading").show();
    let postData = { act: act, id: id };
    if (act === 'takefinish') {
        postData.odometr = $('#odometr').val();
        postData.money = $('#money').val();
        postData.deadline = $('#deadline').val();
    }
    const handleResponse = (response) => {
        $("#ajax_tocar").html(response);
        $("#loading").hide();
    };
    const finalize = () => {
        if (act === 'todelet' || act === 'takefinish') {
            
        } else {
            $(".panel_to").hide();
        }
    };
    $.post(root + '?do=car', postData, handleResponse)
        .fail(() => {
            $("#loading").hide();
            alert('Помилка при виконанні запиту.');
        })
        .always(finalize);
}

