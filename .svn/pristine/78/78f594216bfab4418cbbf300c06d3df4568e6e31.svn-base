        klappText.style.display = 'block';
        klappBild.src = '/style/img/minus.gif';
        klappBild.title = 'Скрыть';
    } else {
        klappText.style.display = 'none';
        klappBild.src = '/style/img/plus.gif';
        klappBild.title = 'Показать';
    }
}
