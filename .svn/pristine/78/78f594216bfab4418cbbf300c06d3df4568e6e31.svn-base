function loadhouse(id, name) {
    const popupContent = document.getElementById(`popup-content-${id}`);
    if (popupContent.innerHTML === '<strong>Loading...</strong>') {
        // Виконуємо AJAX запит на сервер для отримання повної інформації
        fetch('/?do=house&act=info&id=' + id)
            .then(response => response.json())
            .then(data => {
                // Формуємо HTML з отриманих даних
                const photo = data.photo ? `<div class="corect_photo"><img src="/?do=thumb&type=photo&img=${data.photo}&s=1"></div>` : '';
                const html = `${photo}<a href="/?do=house&act=view&id=${id}">${name}</a><br>Onu: ${data.onus}/<font color="green">${data.online}</font>/<font color="red">${data.offline}</font>`;
                popupContent.innerHTML = html;
            })
            .catch(error => {
                popupContent.innerHTML = '<strong>Error loading data</strong>';
            });
    }
}
