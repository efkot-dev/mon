function console_pmon(act, olt, port) {
    var confirmed = confirm("Start work?");
    if (confirmed) {
		$("#loading").show();
		$(".loading").text(act);
        $.post(root + "ajax/function.php", {
            act: act,
            olt: olt,
            port: port
        }, function(response) {
            if (response === 'ok') {
                setTimeout(sayHi,2000);
            } else {
                console.error('Помилка відправлення даних:', response);
				setTimeout(sayHi,2000);
            }
        }, "html");
    } else {
        // користувач відмінив дію
    }
}
