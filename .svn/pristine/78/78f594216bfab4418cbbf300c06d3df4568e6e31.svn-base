/*TASKERS*/
function createChart(containerId, chartData, maxValue, colors, title) {
    d3.select("#" + containerId).selectAll("*").remove();
    const container = d3.select("#" + containerId);
    const containerWidth = container.node().getBoundingClientRect().width;
    const margin = { top: 30, right: 10, bottom: 40, left: 30 },
          width = containerWidth - margin.left - margin.right,
          height = 200 - margin.top - margin.bottom;    
    const svg = container
        .append("svg")
        .attr("width", width + margin.left + margin.right)
        .attr("height", height + margin.top + margin.bottom)
        .append("g")
        .attr("transform", `translate(${margin.left},${margin.top})`);
    svg.append("text")
        .attr("x", width / 2)
        .attr("y", -10)
        .attr("text-anchor", "middle")
        .attr("font-size", "14px")
        .text(title);
    const x = d3.scaleBand()
        .domain(chartData.map(d => d.hour))
        .range([0, width])
        .padding(0.1);    
    const y = d3.scaleLinear()
        .domain([0, maxValue])
        .nice()
        .range([height, 0]);    
    const getColor = (d, i) => Array.isArray(colors) ? colors[i % colors.length] : colors;    
    svg.append("g")
        .selectAll("rect")
        .data(chartData)
        .join("rect")
        .attr("x", d => x(d.hour))
        .attr("y", d => y(d.count))
        .attr("width", x.bandwidth())
        .attr("height", d => height - y(d.count))
        .attr("fill", (d, i) => getColor(d, i))
        .attr("class", "bar")
        .style("cursor", "pointer")
        .on("click", (event, d) => handleBarClick(containerId, d.hour));
    svg.append("g")
        .attr("transform", `translate(0,${height})`)
        .call(d3.axisBottom(x).tickFormat(d => d));
    svg.append("g")
        .call(d3.axisLeft(y).ticks(5));
    svg.selectAll(".bar-label")
        .data(chartData)
        .join("text")
        .attr("class", "bar-label")
        .attr("x", d => x(d.hour) + x.bandwidth() / 2)
        .attr("y", d => y(d.count) - 5)
        .attr("text-anchor", "middle")
        .attr("fill", "black")
        .style("font-size", "10px")
        .text(d => d.count);
}
function handleBarClick(containerId, hour) {
    const date = new Date().toISOString().split("T")[0];
    const url = `/?do=core&act=onulist&this=${containerId}&date=${date}&hour=${hour}`;
    const allGraphs = document.querySelectorAll(".graph-container");
    const clickedGraph = document.getElementById(containerId);
    if (clickedGraph.classList.contains("full-width")) {

    } else {

    }
    fetch(url, { method: "POST" })
        .then(response => response.text())
        .then(data => {
            document.getElementById("ajax_result_signal").innerHTML = data;
        });
}
