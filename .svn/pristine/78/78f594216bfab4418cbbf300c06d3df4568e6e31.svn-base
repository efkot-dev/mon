function sendDataOnChange(checkbox) {
	$("#loading").show();
    var switchId = $(checkbox).siblings('.checkbox-ya-switch').find('.checkbox-ya-feature').data('switch');
    var port = $(checkbox).siblings('.checkbox-ya-switch').find('.checkbox-ya-feature').data('port');
    var cmd = $(checkbox).siblings('.checkbox-ya-switch').find('.checkbox-ya-feature').data('status');
    var dataToSend = {
        'act': 'port',
        'status': cmd,
        'switch': switchId,
        'port': port
    };
    $.ajax({
        type: 'POST',
        url: root+"ajax/port.php",
        data: dataToSend,
        success: function(response) {
			if (response == 'ok') {
				window.location.href = "/?do=detail&act=olt&page=connect&id=" + switchId;
			}
        },
        error: function(xhr, status, error) {
			$("#loading").hide();
            console.error('Помилка відправлення даних:', error);
        }
    });
}
