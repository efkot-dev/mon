function funcpaneldel(act, idonu, olt, port) {
    $("#loading").show();
    $.post(root + "ajax/function.php", {
        act: act,
        idonu: idonu,
        olt: olt
    },
    function (response) {
		$("#loading").hide();
		$(".sd5").hide();
        if (response == 'ok') {
            window.location.href = "/?do=terminal&id=" + olt + "&port=" + port;
        } else if (response == 'onu') {
			window.location.href = "/?do=onu&id=" + idonu;
        } else {
            $("#block-ont-" + idonu).empty();
            $("#block-ont-" + idonu).html(response);
        }
    }, 'html');
}
function funcpaneldel_ok(act, idonu, olt, port, tochno) {
    $("#loading").show();
	var confirmed = confirm(tochno);    
		if (confirmed) {
		$.post(root + "ajax/function.php", {
			act: act,
			idonu: idonu,
			olt: olt
		},
		function (response) {
			$("#loading").hide();
			$(".sd5").hide();
			if (response == 'ok') {
				window.location.href = "/?do=terminal&id=" + olt + "&port=" + port;
			} else if (response == 'onu') {
				window.location.href = "/?do=onu&id=" + idonu;
			} else {
				$("#block-ont-" + idonu).empty();
				$("#block-ont-" + idonu).html(response);
			}
		}, 'html');
	}else{
		$("#loading").hide();
	}
}
