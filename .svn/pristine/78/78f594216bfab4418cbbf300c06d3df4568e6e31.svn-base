function insertTag(tag) {
    var textarea = document.getElementById('content');
    var start = textarea.selectionStart;
    var end = textarea.selectionEnd;
    var selectedText = textarea.value.substring(start, end);
    var beforeText = textarea.value.substring(0, start);
    var afterText = textarea.value.substring(end, textarea.value.length);
    var newText = beforeText + '[' + tag + ']' + selectedText + '[/' + tag + ']' + afterText;
    textarea.value = newText;
}
function updateMarkersVisibility() {
    var currentZoom = map.getZoom();
    markers.forEach(function(marker) {
        var imgElement = marker._icon.querySelector('.circle-zoom');
        var statsElements = marker._icon.querySelectorAll('.mapstats, .mapoffs, .mapoff, .maponline');
        if (imgElement) {
            if (currentZoom >= minZoomLevel) {
                imgElement.style.display = 'block';
                statsElements.forEach(function(el) {
                    el.classList.remove('collapsed');
                    el.classList.add('expanded');
                });
            } else {
                imgElement.style.display = 'none';
                statsElements.forEach(function(el) {
                    el.classList.remove('expanded');
                    el.classList.add('collapsed');
                });
            }
        }
    });
}
function confirmpmon(title) {
    return confirm(title);
}
function drawGrid(svg, xScale, yScale) {
    const gridGroup = svg.append("g").attr("class", "grid");
    gridGroup.selectAll(".grid-line-x").data(xScale.ticks(10)).enter().append("line").attr("class", "grid-line-x").attr("x1", d => xScale(d)).attr("x2", d => xScale(d)).attr("y1", margin.top).attr("y2", height - margin.bottom).attr("stroke", "#ccc").attr("stroke-dasharray", "2,2");
    gridGroup.selectAll(".grid-line-y").data(yScale.ticks(6)).enter().append("line").attr("class", "grid-line-y").attr("x1", margin.left).attr("x2", setWidth() - margin.right).attr("y1", d => yScale(d)).attr("y2", d => yScale(d)).attr("stroke", "#ccc").attr("stroke-dasharray", "2,2");
}
function drawCPUChart(data) {
    yScaleCPU.domain([0, 100]);
    xScale.domain(d3.extent(data, d => new Date(d.timestamp)));
    svgCPU.selectAll("*").remove();
    drawGrid(svgCPU, xScale, yScaleCPU);
    svgCPU.append("g").attr("transform", `translate(0,${height - margin.bottom})`).call(d3.axisBottom(xScale).ticks(10).tickFormat(d3.timeFormat("%H:%M:%S")));
    svgCPU.append("g").attr("transform", `translate(${margin.left},0)`).call(d3.axisLeft(yScaleCPU).ticks(6));
    svgCPU.append("path").datum(data).attr("fill", "#BFCE6C").attr("opacity", 0.5).attr("d", areaCPU);
    svgCPU.append("path").datum(data).attr("fill", "none").attr("stroke", "#9cc884").attr("stroke-width", 0.8).attr("d", lineCPU);
}
function renderChart_(data) {
    const margin = {top: 10, right: 10, bottom: 20, left: 30};
    const width = document.getElementById("chart").clientWidth - margin.left - margin.right;
    const height = 400 - margin.top - margin.bottom;
    const svg = d3.select("#chart")
        .append("svg")
        .attr("width", width + margin.left + margin.right)
        .attr("height", height + margin.top + margin.bottom)
        .append("g")
        .attr("transform", `translate(${margin.left},${margin.top})`);
    
    const color = d3.scaleOrdinal(d3.schemeCategory10);
    const onuKeys = Object.keys(data);
    const allSignals = [];
    onuKeys.forEach(onu => {
        data[onu].forEach(d => {
            allSignals.push(new Date(d.datetime));
        });
    });

    const x = d3.scaleTime().domain(d3.extent(allSignals)).range([0, width]);
    const y = d3.scaleLinear()
        .domain([d3.min(onuKeys, onu => d3.min(data[onu], d => d.signal)), 
                 d3.max(onuKeys, onu => d3.max(data[onu], d => d.signal))])
        .nice()
        .range([height, 0]);

    svg.append("g").attr("transform", `translate(0,${height})`).call(d3.axisBottom(x));
    svg.append("g").call(d3.axisLeft(y));

    const line = d3.line().x(d => x(new Date(d.datetime))).y(d => y(d.signal));

    const onuLines = {}; // Для збереження ліній для кожної онушки

    onuKeys.forEach((onu, index) => {
        const group = svg.append("g");
        const path = group.append("path")
            .datum(data[onu])
            .attr("fill", "none")
            .attr("stroke", color(index))
            .attr("stroke-width", 1.5)
            .attr("class", "onu-line")
            .attr("d", line)
            .on("mouseover", function () {
                d3.select(this)
                    .attr("stroke-width", 3);
            })
            .on("mouseout", function () {
                d3.select(this).attr("stroke-width", 1.5);
            })
            .on("click", function () {
                const path = d3.select(this);
                const currentOpacity = path.style("opacity");
                path.style("opacity", currentOpacity === "1" ? "0" : "1");
            })
            .on("contextmenu", function (event, d) {
                event.preventDefault();
                const path = d3.select(this);
                const idonu = data[onu][0]?.idonu;

                if (idonu) {
                    const elementToHide = document.getElementById(`onu-${idonu}`);
                    if (elementToHide) {
                        elementToHide.style.display = "none";
                    }
                }

                path.remove();
            })
            .append("title")
            .text(() => {
                const inface = data[onu][0]?.inface || "Невідомий інтерфейс";
                const mac = data[onu][0]?.mac || "Невідомий MAC";
                return `${mac}\nInterface: ${inface}`;
            });

        // Зберігаємо лінію в об'єкті для подальшого доступу
        onuLines[onu] = path;
    });

    document.querySelectorAll('tr[data-onu-id]').forEach(row => {
        row.addEventListener('click', function () {
            const onuId = this.getAttribute('data-onu-id');
            const line = onuLines[onuId];

            if (line) {
                // Додаємо ефект блимання
                line.transition()
                    .duration(500)
                    .style("opacity", 0)
                    .transition()
                    .duration(500)
                    .style("opacity", 1);
            }
        });
    });
}

