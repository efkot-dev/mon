function manual_menu(action, state) {
    $.post(root + "?do=send&act=menu", { action: action, show: state }, function(response) {
        var currentStatus = response.status;        
        if (currentStatus === 'true') {
            $('#view_' + action).html('<img src="../style/img/accept.png">');
            $('#view_' + action).attr('onclick', 'manual_menu(\'' + action + '\', \'hide\')');
        } else {
            $('#view_' + action).html('<img src="../style/img/hidden.png">');
            $('#view_' + action).attr('onclick', 'manual_menu(\'' + action + '\', \'view\')');
        }
    }, "json");
}
function enableCopyOnClick(textToCopy) {
    const textArea = document.createElement('textarea');
    textArea.value = textToCopy;
    document.body.appendChild(textArea);
    textArea.select();
    textArea.setSelectionRange(0, 99999);
    document.execCommand('copy');
    document.body.removeChild(textArea);
}
