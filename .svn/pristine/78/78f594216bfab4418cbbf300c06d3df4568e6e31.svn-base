function toggleMenu(menuId) {
	var menuContent = document.getElementById(menuId + '_content');
	var menuKey = document.getElementById(menuId + '_key');
	var allMenus = document.querySelectorAll('.menu_content');
	if (menuContent) {
    menuContent.classList.toggle('activemap');
    menuKey.classList.toggle('activekey');
    allMenus.forEach(function(menu) {
		if (menu.id !== menuId + '_content' && menu.classList.contains('activemap')) {
			menu.classList.remove('activemap');
		}
    });
  }
}

