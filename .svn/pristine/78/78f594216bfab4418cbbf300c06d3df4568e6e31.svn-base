    const height = 400 - margin.top - margin.bottom;
    const svg = d3.select("#chart")
        .append("svg")
        .attr("width", width + margin.left + margin.right)
        .attr("height", height + margin.top + margin.bottom)
        .append("g")
        .attr("transform", `translate(${margin.left},${margin.top})`);
    const color = d3.scaleOrdinal(d3.schemeCategory10);
    const onuKeys = Object.keys(data);
    const allSignals = [];
    onuKeys.forEach(onu => {
        data[onu].forEach(d => {
            allSignals.push(new Date(d.datetime));
        });
    });
    const x = d3.scaleTime().domain(d3.extent(allSignals)).range([0, width]);
    const y = d3.scaleLinear()
        .domain([d3.min(onuKeys, onu => d3.min(data[onu], d => d.signal)), 
                 d3.max(onuKeys, onu => d3.max(data[onu], d => d.signal))])
        .nice()
        .range([height, 0]);
    svg.append("g").attr("transform", `translate(0,${height})`).call(d3.axisBottom(x));
    svg.append("g").call(d3.axisLeft(y));
    const line = d3.line().x(d => x(new Date(d.datetime))).y(d => y(d.signal));
	const onuLines = {}; // Для збереження ліній для кожної онушки
    onuKeys.forEach((onu, index) => {
        const group = svg.append("g");
        const idonu = data[onu][0]?.idonu || "no-id-" + index; // Якщо idonu немає, генеруємо унікальний id
        group.append("path")
            .datum(data[onu])
            .attr("fill", "none")
            .attr("stroke", color(index))
            .attr("stroke-width", 1.5)
            .attr("class", "onu-line")
            .attr("id", "onu-line-" + idonu)  // Унікальний id для кожної лінії
            .attr("d", line)
            .on("mouseover", function () {
                d3.select(this).attr("stroke-width", 3);
            })
            .on("mouseout", function () {
                d3.select(this).attr("stroke-width", 1.5);
            })
            .on("click", function () {
                const path = d3.select(this);
                const lineId = "onu-line-" + idonu;
                const existingBlink = d3.select(`#${lineId}`).style("animation");
                if (existingBlink && existingBlink !== "none") {
                    d3.select(`#${lineId}`).style("animation", "none");
                } else {
                    d3.select(`#${lineId}`).style("animation", "blink 1s infinite");
                }
            })
            .on("contextmenu", function (event, d) {
                event.preventDefault();
                const path = d3.select(this);
                const idonu = data[onu][0]?.idonu;

                if (idonu) {
                    const elementToHide = document.getElementById(`onu-${idonu}`);
                    if (elementToHide) {
                        elementToHide.style.display = "none";
                    }
                }

                path.remove();
            })
            .append("title")
            .text(() => {
                const inface = data[onu][0]?.inface || "n/a inface";
                const mac = data[onu][0]?.mac || "n/a MAC";
                return `${mac}\nInterface: ${inface}`;
            });
    });
document.querySelectorAll('tr[data-onu-id]').forEach(row => {
    // Обробка лівого кліку
    row.addEventListener('click', function () {
        const onuId = this.getAttribute('data-onu-id');
        const line = document.getElementById(`onu-line-${onuId}`);
        if (this.classList.contains('active')) {
            this.classList.remove('active');
            if (line) {
                line.classList.remove('blinkers_1s');
            }
        } else {
            this.classList.add('active');
            if (line) {
                line.classList.add('blinkers_1s');
            }
        }
    });

    // Обробка правого кліку
    row.addEventListener('contextmenu', function (e) {
        e.preventDefault(); // Запобігає відкриттю стандартного контекстного меню
        const onuId = this.getAttribute('data-onu-id');
        const line = document.getElementById(`onu-line-${onuId}`);

        if (this.classList.contains('opiym')) {
            // Видаляємо класи, якщо вже були встановлені
            this.classList.remove('opiym');
            if (line) {
                line.classList.remove('hides');
            }
        } else {
            // Додаємо класи, якщо їх немає
            this.classList.add('opiym');
            if (line) {
                line.classList.add('hides');
            }
        }
    });
});

}
function stats_new_added(name_block) {
    const container = document.getElementById("stats_new_added-container");
    const width = container.clientWidth;
    const height = 250;
    const margin = { top: 40, right: 20, bottom: 40, left: 28 };

    d3.select("#stats_new_added-container svg").remove();

    fetch("/?do=core&act=stats_added")
        .then(response => response.json())
        .then(data => {
            const chartData = Object.entries(data)
                .map(([day, count]) => ({ day: parseInt(day), count: count }))
                .sort((a, b) => a.day - b.day);

            const total = chartData.reduce((acc, d) => acc + d.count, 0);
            const average = total / chartData.length;
            const threshold = average + (average / 2);

            const svg = d3.select("#stats_new_added-container")
                .append("svg")
                .attr("width", width)
                .attr("height", height);

            svg.append("text")
                .attr("x", width / 2)
                .attr("y", margin.top / 2)
                .attr("text-anchor", "middle")
                .style("font-size", "14px")
                .style("font-weight", "bold")
                .text(name_block);

            const x = d3.scaleBand()
                .domain(chartData.map(d => d.day.toString()))
                .range([margin.left, width - margin.right])
                .padding(0.1);

            const maxCount = d3.max(chartData, d => d.count) || 1;
            const y = d3.scaleLinear()
                .domain([0, maxCount])
                .nice()
                .range([height - margin.bottom, margin.top]);

            svg.append("g")
                .selectAll("rect")
                .data(chartData)
                .enter().append("rect")
                .attr("x", d => x(d.day.toString()))
                .attr("y", d => y(d.count))
                .attr("height", d => Math.max(2, y(0) - y(d.count)))
                .attr("width", x.bandwidth())
                .attr("fill", d => d.count > threshold ? "#46ba39" : "#86b1d6")
                .style("cursor", "pointer")
                .on("mouseover", function (event, d) {
                    d3.select(this).attr("fill", "orange");
                })
                .on("mouseout", function (event, d) {
                    d3.select(this).attr("fill", d.count > threshold ? "#46ba39" : "#86b1d6");
                })
                .on("click", (event, d) => showdaynew(d.day)); // Виправлено

            svg.append("g")
                .attr("transform", `translate(0,${height - margin.bottom})`)
                .call(d3.axisBottom(x).tickSizeOuter(0))
                .selectAll("text")
                .attr("dy", "8px")
                .attr("dx", "0px")
                .style("text-anchor", "middle")
                .attr("transform", "rotate(0)");

            svg.append("g")
                .attr("transform", `translate(${margin.left},0)`)
                .call(d3.axisLeft(y));
        });
}

function stats_disconnect(name_block) {
    const container = document.getElementById("stats_disconnect-container");
    const width = container.clientWidth;
    const height = 250;
    const margin = { top: 40, right: 20, bottom: 40, left: 28 };
    d3.select("#stats_disconnect-container svg").remove();
    fetch("/?do=core&act=stats_disconnect")
	.then(response => response.json())
	.then(data => {
		const chartData = Object.entries(data).map(([day, count]) => ({day: parseInt(day),count: count})).sort((a, b) => a.day - b.day);
		const total = chartData.reduce((acc, d) => acc + d.count, 0);
		const average = total / chartData.length;
		const threshold = average + (average / 2);
		const svg = d3.select("#stats_disconnect-container").append("svg").attr("width", width).attr("height", height);svg.append("text").attr("x", width / 2).attr("y", margin.top / 2).attr("text-anchor", "middle").style("font-size", "14px").style("font-weight", "bold").text(name_block);
		const x = d3.scaleBand().domain(chartData.map(d => d.day.toString())).range([margin.left, width - margin.right]).padding(0.1);
		const maxCount = d3.max(chartData, d => d.count) || 1;
		const y = d3.scaleLinear().domain([0, maxCount]).nice().range([height - margin.bottom, margin.top]);
			svg.append("g")
                .selectAll("rect")
                .data(chartData)
                .enter().append("rect")
                .attr("x", d => x(d.day.toString()))
                .attr("y", d => y(d.count))
                .attr("height", d => Math.max(2, y(0) - y(d.count)))
                .attr("width", x.bandwidth())
                .attr("fill", d => d.count > threshold ? "red" : "#86b1d6")
                .style("cursor", "pointer")
                .on("mouseover", function (event, d) {
                    d3.select(this).attr("fill", "orange");
                })
                .on("mouseout", function (event, d) {
                    d3.select(this).attr("fill", d.count > threshold ? "red" : "#86b1d6");
                })
                .on("click", (event, d) => showdayoff(d.day)); // Виправлено
		
		svg.append("g").attr("transform", `translate(0,${height - margin.bottom})`).call(d3.axisBottom(x).tickSizeOuter(0)).selectAll("text").attr("dy", "8px").attr("dx", "0px").style("text-anchor", "middle").attr("transform", "rotate(0)");
		svg.append("g").attr("transform", `translate(${margin.left},0)`).call(d3.axisLeft(y));
	});
}
function showdaynew(day) {
    const popup = document.getElementById("popup");
    const popupContent = document.getElementById("popup-content");
    popup.style.display = "flex";
    popup.style.opacity = "0";
    setTimeout(() => {
        popup.style.opacity = "1";
    }, 10);
	popupContent.innerHTML = '<img src="../style/img/ajax-loader-big.gif" style="display: block; margin: auto;">';
    fetch(`/?do=core&act=showdaynew&day=${day}`)
        .then(response => response.text())
        .then(html => {
            popupContent.innerHTML = html;
        })
        .catch(() => {
            popupContent.innerHTML = "<p style='text-align: center; color: red;'>Помилка завантаження</p>";
        });
}
function showdayoff(day) {
    const popup = document.getElementById("popup");
    const popupContent = document.getElementById("popup-content");
    popup.style.display = "flex";
    popup.style.opacity = "0";
    setTimeout(() => {
        popup.style.opacity = "1";
    }, 10);
	popupContent.innerHTML = '<img src="../style/img/ajax-loader-big.gif" style="display: block; margin: auto;">';
    fetch(`/?do=core&act=showdayoff&day=${day}`)
        .then(response => response.text())
        .then(html => {
            popupContent.innerHTML = html;
        })
        .catch(() => {
            popupContent.innerHTML = "<p style='text-align: center; color: red;'>Помилка завантаження</p>";
        });
}
function closePopup() {
    const popup = document.getElementById("popup");
    popup.style.opacity = "0";
    setTimeout(() => {
        popup.style.display = "none";
    }, 300);
}
function delete_taskers(title) {
    let checkboxes = $('input[name="delete_taskers[]"]:checked');
    if (checkboxes.length === 0) return;
    if (!confirm(title)) return;
    let scrollPosition = $(window).scrollTop();
    let t_list = [];
    checkboxes.each(function() {
        t_list.push($(this).val());
    });
    $.post(root + '?do=telnet&act=deletetaskers', { data: t_list}, function(response) {
        t_list.forEach(function(id) {
            $('#tasker-' + id).hide();
        });
    });

}
function delete_marker_ont(olt, title) {
    let checkboxes = $('input[name="delete[]"]:checked');
    if (checkboxes.length === 0) return;
    if (!confirm(title)) return;
    let scrollPosition = $(window).scrollTop();
    let ont_list = [];
    checkboxes.each(function() {
        ont_list.push($(this).val());
    });
    $.post(root + '?do=telnet&act=deleteont', { data: ont_list, olt: olt }, function(response) {
        ont_list.forEach(function(id) {
            $('#ont_' + id).hide();
        });
        $(window).scrollTop(scrollPosition);
    });
}
function selectall() {
    let checkboxes = document.querySelectorAll('input[name="delete[]"]');
    if (checkboxes.length === 0) return;
    let allSelected = checkboxes.length === Array.from(checkboxes).filter(checkbox => checkbox.checked).length;
    checkboxes.forEach(function(checkbox) {
        checkbox.checked = !allSelected;
    });
}
function get_status_sfp(olt) {
    var statusDiv = $('#status_' + olt);        
    statusDiv.html(LoadingBarmin);
    $.post(root + '?do=service&act=getsfp', { olt: olt }, function(data) {
        statusDiv.html(data);
    });
}











