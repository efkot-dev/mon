function register_quiq_huawei(id,olt) {
	var confirmed = confirm("Enable?");
    if (confirmed) {
		$("#loading").show();
		var ifindex = $('#onu_ifindex_' + id).val();
		var onu_sn = $('#onu_sn_' + id).val();
		var onu_inface = $('#onu_inface_' + id).val();
		var onu_id = $('#onu_id_' + id).val();
		var onu_name = $('#onu_name_' + id).val();
		var onu_vlan = $('#onu_vlan_' + id).val();
		var onu_invlan = $('#onu_invlan_' + id).val();
		var onu_lp = $('#onu_lp_' + id).val();
		var onu_sp = $('#onu_sp_' + id).val();
		if (!onu_id || !onu_name || !onu_vlan || !onu_invlan || !onu_lp  || !onu_sp ) {
			alert('Будь ласка, заповніть всі поля.');
			return;
		}
		var data = {
			ifindex: ifindex,olt: olt, onu_id: onu_id, onu_name: onu_name,onu_vlan: onu_vlan,onu_invlan: onu_invlan,onu_lp: onu_lp,onu_sp: onu_sp,onu_sn: onu_sn,onu_inface: onu_inface
		};
		$.post(root + '?do=telnet&act=huaweiregmod1', { data:data }, function(response) {
			$("#reger_" + id ).hide();
			$("#loading").hide();
			setTimeout(sayHi,1000);
		});
	}
}
