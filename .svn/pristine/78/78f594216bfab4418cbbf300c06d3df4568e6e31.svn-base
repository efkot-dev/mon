function updateMarkers(response) {
    var newMarkers = JSON.parse(response);
    map.eachLayer(function (layer) {
        if (layer instanceof L.Marker) {
            map.removeLayer(layer);
        }
    });    
	map.eachLayer(function (layer) {
        if (layer instanceof L.Polyline) {
			map.removeLayer(layer);
		}
    });
    for (var i = 0; i < newMarkers['pillar'].length; i++) {
        var marker = L.marker([newMarkers['pillar'][i].lan, newMarkers['pillar'][i].lon], {
            icon: L.divIcon({
                className: 'mapper',
                html: '<div class="' + newMarkers['pillar'][i].classicon + '"><img src="../style/img/' + newMarkers['pillar'][i].mappericon + '"></div>'
            })
        });
        marker.bindTooltip(newMarkers['pillar'][i].nomer_pillar);
        marker.addTo(map);
    }    
	for (var i = 0; i < newMarkers['line'].length; i++) {
		var lineCoords = [
			[parseFloat(newMarkers['line'][i].start_1), parseFloat(newMarkers['line'][i].end_1)],
			[parseFloat(newMarkers['line'][i].start_2), parseFloat(newMarkers['line'][i].end_2)]
		];		
		var polyline = L.polyline(lineCoords, { color: "red" }).bindTooltip(newMarkers['line'][i].name).addTo(map);
	}
}
function updateMarkers_(response) {
    var newMarkers = JSON.parse(response);
    map.eachLayer(function (layer) {
        if (layer instanceof L.Marker) {
            map.removeLayer(layer);
        }
    });
    for (var i = 0; i < newMarkers.length; i++) {
        var marker = L.marker([newMarkers[i].lan, newMarkers[i].lon], {
            icon: L.divIcon({
                className: 'mapper',
                html: '<div class="' + newMarkers[i].classicon + '"><img src="../style/img/' + newMarkers[i].mappericon + '"></div>'
            })
        });
        marker.bindTooltip(newMarkers[i].nomer_pillar);
        marker.addTo(map);
    }
}
