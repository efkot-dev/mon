document.addEventListener('DOMContentLoaded', function () {
    var lineElements = document.querySelectorAll('[id^="line-"]');
    lineElements.forEach(function (element) {
        element.addEventListener('mouseover', function () {
            highlightLineElements(element);
        });
        element.addEventListener('mouseout', function () {
            removeHighlightLineElements();
        });
    });
    function highlightLineElements(selectedElement) {
        var lineNumber = selectedElement.id.replace('line-', '');
        lineElements.forEach(function (element) {
            var elementNumber = element.id.replace('line-', '');
            if (elementNumber === lineNumber) {
                element.classList.add('highlight');
            }
        });
    }
    function removeHighlightLineElements() {
        lineElements.forEach(function (element) {
            element.classList.remove('highlight');
        });
    }
});
document.addEventListener('DOMContentLoaded', function () {
    var lineElements = document.querySelectorAll('[id^="prov-"]');
    lineElements.forEach(function (element) {
        element.addEventListener('mouseover', function () {
            highlightLineElements(element);
        });

        element.addEventListener('mouseout', function () {
            removeHighlightLineElements();
        });
    });
    function highlightLineElements(selectedElement) {
        var lineNumber = selectedElement.id.replace('prov-', '');
        lineElements.forEach(function (element) {
            var elementNumber = element.id.replace('prov-', '');
            if (elementNumber === lineNumber) {
                element.classList.add('highlight_p');
            }
        });
    }

    function removeHighlightLineElements() {
        lineElements.forEach(function (element) {
            element.classList.remove('highlight_p');
        });
    }
});
$(document).ready(function(){
    $('input[name="odometr"]').on('input', function() {
        var start_odometr = parseInt($('input[name="start_odometr"]').val());
        var finish_odometr = parseInt($(this).val());        
        if (!isNaN(start_odometr) && !isNaN(finish_odometr)) {
            var difference = finish_odometr - start_odometr;
            $('#sum').text('Намотав: ' + difference + ' km');
        }
    });
});
