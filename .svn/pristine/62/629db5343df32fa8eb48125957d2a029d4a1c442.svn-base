CREATE TABLE `snmp_data` (
  `id` int(11) NOT NULL AUTO_INCREMENT,
  `portid` int(11) NOT NULL,
  `in_bytes` bigint(20) DEFAULT NULL,
  `out_bytes` bigint(20) DEFAULT NULL,
  `in_bps` double DEFAULT NULL,
  `out_bps` double DEFAULT NULL,
  `timestamp` timestamp NOT NULL DEFAULT current_timestamp(),
  PRIMARY KEY (`id`),
  KEY `idx_portid` (`portid`),
  KEY `idx_timestamp` (`timestamp`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8 COLLATE=utf8_unicode_ci;
CREATE TABLE `traff_monitor` (
  `id` int(11) NOT NULL AUTO_INCREMENT,
  `deviceid` int(11) NOT NULL,
  `types` varchar(20) CHARACTER SET utf8 COLLATE utf8_general_ci NOT NULL,
  `llid` bigint(22) NOT NULL,
  `netip` varchar(50) NOT NULL,
  `snmpro` varchar(50) NOT NULL,
  `oid_in` text NOT NULL,
  `oid_out` text NOT NULL,
  `timestamp` timestamp NOT NULL DEFAULT current_timestamp(),
  PRIMARY KEY (`id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8 COLLATE=utf8_unicode_ci;

ALTER TABLE `traff_monitor` ADD `idonu` int(11) NULL AFTER `llid`;

