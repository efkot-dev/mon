<?php
if (!defined('PONMONITOR')){
	die('Hacking attempt!');
}
define('QUEUE',true);
require ROOT_DIR.'/inc/init.monitor.php';
require_once ENGINE_DIR . 'init.queue.php';
$pauseIntervalAll = 40;
$resultrxarray = [];
$counters = 0;
$starttime = microtime(true);
$time = date('Y-m-d H:i:s');
if (!is_valid_id($olt)) {
	die('unknown_device');
}
$sql_switch = ['sql' => "SELECT * FROM switch WHERE id = '{$olt}' LIMIT 1",'key' => "device_{$olt}",'time' => 60];
$getswitch = cache_simple_sql($sql_switch);
if (empty($getswitch['id'])) {
	die('unknown_device');
}
$getlistrxcheck = [];
$db->query("UPDATE switch SET status = 'go', updates_rx = '{$time}' WHERE id = '{$olt}'");
taskers_device_pmon($db, 56, $getswitch['id']);
$getmonitor = new Monitor($getswitch['id'], $getswitch['class'], $db, $logger, $classOLT, $cacheManager, $php_class_device);
$supportonu = $getmonitor->getSupportOnu();
if (!$supportonu) {
	die('unknown_device');
}
$getlistrxcheck = $getmonitor->getListSignal();
if (is_array_empty($getlistrxcheck)) {
	$resultrxarray = array_map(function ($getrxdata) use (&$counters, $pauseIntervalAll, $config) {
		print_R($getrxdata);
		$resrxapi = api__($config['monitorapi'], $getrxdata);
		print_R($resrxapi);
		$counters++;
		if ($counters % $pauseIntervalAll === 0) {
			$currentLoad = sys_getloadavg()[0];
			sleep(max(1, min(6, intdiv((int)$currentLoad, 2))));
		}
		return is_array($resrxapi) && is_array($getrxdata) ? array_merge($getrxdata, $resrxapi) : $getrxdata;
	}, $getlistrxcheck);
}
if (is_array_empty($resultrxarray)) {
	array_map(function($getdatarxont) use ($getmonitor) {
		match($getdatarxont['pon']) {
			'epon' => $getmonitor->tempSaveSignalEpon($getdatarxont),
			'gpon' => $getmonitor->tempSaveSignalGpon($getdatarxont)
		};
	}, $resultrxarray);
}
$executionTime = round(microtime(true) - $starttime, 4);
$logger->init([
	'log' => 'device',
	'type' => 'monitor_signal',
	'descr' => 'sec:['.$executionTime.'] '.$lang['monitorfinishsignal'].'',
	'deviceid' => $getswitch['id'],
	'who' => 'cron'
]);
$db->query("UPDATE switch SET status = 'no' WHERE id = '{$getswitch['id']}'");
?>
