.leaflet-marker-icon .m_on {

}
.leaflet-marker-icon .m_empty {

}
.leaflet-marker-icon .m_off {
	animation: blinkerping 3s linear infinite;
}
 .fiber_critical {
        animation: blink 1s infinite; /* Анімація триває 1 секунду та повторюється нескінченно */
    }

    @keyframes blink {
        0%, 100% {
            stroke: red;
        }
        50% {
            stroke: #FFC107;
        }
    }
@keyframes critacalmdu {
	50% {
		border-left: 3px solid #fff;
		color: red;
	}  
	100% {
		border-left: 3px solid red;
	}
}
@keyframes okeymdu {
	50% {
		border-left: 3px solid #fff;
	}  
	100% {
		border-left: 3px solid #6ecd00;
	}
}
