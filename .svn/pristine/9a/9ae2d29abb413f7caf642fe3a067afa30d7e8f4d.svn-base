/*--a,css:btn--*/
#url {
    background-color: #2b72b1;
    transition: all 0.3s cubic-bezier(0.26, 0.46, 0.45, 0.95) 0s;
    border-radius: 3px;
    font-size: 13px;
    height: 31px;
    line-height: 15px;
    top: 10px;
    margin: 10px 0px;
    color: #fff;
    display: inline-block;
    padding: 10px 18px;
    opacity: 0.8;
    position: relative;
}
#url:hover{
	background: #1159c4;
	opacity: 1;
}
