.overlay {
    position: fixed;
    left: 0;
    top: 0;
    z-index: 999999;
    width: 100%;
    height: 100%;
    background-color: rgb(0 0 0 / 13%);
    display: block;
}
.wrap {
    position: relative;
    padding: 10px 0px;
    margin: 0;
}
.main-head {
    display: block;
    width: 100%;
    float: left;
    height: 5px;
}
.w-menu {
    width: var(--primary-width);
    margin: 0 auto;
    position: relative;
    z-index: 20;
    height: 54px;
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    position: relative;
    z-index: 100003;
}
.wrap-center {
    width:var(--primary-width);
    margin: 0 auto;
    position: relative;
    z-index: 20;
}
.header {
    padding: 0px;
    position: relative;
    z-index: 100;
}
.fx-middle {
    -ms-flex-align: center;
    -webkit-align-items: center;
    align-items: center;
}
.fx-row{
    display: -ms-flexbox;
    display: -webkit-flex;
    display: flex;
    -ms-flex-wrap: wrap;
    -webkit-flex-wrap: wrap;
    flex-wrap: wrap;
    -ms-flex-pack: justify;
    -webkit-justify-content: space-between;
    justify-content: space-between;
}
.col-middle {

}
.mmain {

}
.fx-between {
    -ms-flex-pack: justify;
    -webkit-justify-content: space-between;
    justify-content: space-between;
}
.fx-1 {
    -ms-flex-preferred-size: 0;
    flex-basis: 0;
    -webkit-box-flex: 1;
    -ms-flex-positive: 1;
    flex-grow: 1;
    max-width: 100%;
    min-width: 50px;
}
.fx-col {
    display: -ms-flexbox;
    display: -webkit-flex;
    display: flex;
    -ms-flex-direction: column;
    -webkit-flex-direction: column;
    flex-direction: column;
}
.col-right {
    width: 250px;
    margin-left: 10px;
}
.fx-first {
    -ms-flex-order: -1;
    -webkit-order: -1;
    order: -1;
}
