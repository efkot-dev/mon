.terminal .signal2, .signal3, .signal1, .signal4 , .signal5 {
    padding: 5px 6px;
    border-radius: 3px;
    font-size: 13px;
}
.resp-tab .signal2, .signal3, .signal1, .signal4 , .signal5 {
