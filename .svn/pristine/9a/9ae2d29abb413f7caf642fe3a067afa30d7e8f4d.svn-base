html {
    background: linear-gradient(110.66deg,#e7edf3 11.08%, #dae4ee 43.29%);
    color: #5f7d95;
    font-size: 14px;
    line-height: 1.6;
}
#logont{
	width: 100%;
}
/*new style popup*/
#panel_switch_checker {
    display: flex;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    align-content: center;
    width: 100%;
    padding: 4px;
    margin: 5px 0 0 0;
}
#panel_switch_checker .update_device:hover {
    box-shadow: rgb(0 0 0 / 21%) 0px 2px 14px;
    background: #067ecd;
    color: #fff;
}
#panel_switch_checker .update_device:focus {
  outline: none;
  box-shadow: 0 0 0 4px #cbd6ee;
}
#panel_switch_checker .update_device {
    min-width: 50px;
    width: 33%;
    height: 29px;
    appearance: none;
    border: 0;
    margin: 0 3px;
    border-radius: 5px;
    line-height: 20px;
    color: #222;
    padding: 5px 4px;
    font-size: 12px;
    cursor: pointer;
}
#panel_switch_checker .tyc_olt{
	background: #f2f2f2;
}
#panel_switch_checker .tyc_signal {
    background: #f2f2f2;
}
#panel_switch_checker .tyc_rxsignal {
    background: #f2f2f2;
}
#panel_switch_checker .update_device div {
    position: relative;
    display: inline-block;
    width: 15px;
    margin-left: 3px;
}
#panel_switch_checker .wait{
	color: red;
}
#panel_switch_checker .update_device i {
    transition: transform 0.5s ease;
    font-size: 11px;
    position: relative;
    top: 1px;
}
.toast {
    position: fixed;
    bottom: 20px;
    right: 20px;
    max-width: 92%;
    display: flex;
    align-items: center;
    gap: 12px;
    background: #1e293b;
    color: #fff;
    padding: 14px 18px;
    border-radius: 12px;
    box-shadow: 0 10px 30px rgba(0,0,0,.25);
    opacity: 0;
    transform: translateY(20px);
    transition: all .35s ease;
    z-index: 9999;
    border-left: 6px solid transparent;
    font-size: 13px;
}
.toast.show {
    opacity: 1;
    transform: translateY(0);
}
.toast.hidden {
    pointer-events: none;
}
.toast.success {
    border-left-color: #22c55e;
}
.toast.warning {
    border-left-color: #facc15;
}
.toast.error {
    border-left-color: #ef4444;
}
.toast-icon {
    font-size: 20px;
    line-height: 1;
}
@media (max-width: 600px) {
    .toast {
        left: 50%;
        right: auto;
        bottom: 16px;
        transform: translate(-50%, 20px);
        text-align: center;
    }
    .toast.show {
        transform: translate(-50%, 0);
    }
}
/*new style popup*/
/*block_message_pmon*/
.pmon-message a:hover{
	color: red;	
}
.pmon-message a{
    text-decoration: underline;
    color: #007eb4;
}
.pmon-message {
    display: flex;
    gap: 14px;
    padding: 14px 18px;
    border-radius: 10px;
    border-left: 6px solid;
    background: #fff;
    box-shadow: 0 6px 16px rgba(0,0,0,0.08);
    margin: 15px 0;
    font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
}

/* ICON */
.pmon-message-icon {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background-size: 22px;
    background-position: center;
    background-repeat: no-repeat;
    flex-shrink: 0;
}

/* CONTENT */
.pmon-message-title {
    font-size: 15px;
    font-weight: 600;
    margin-bottom: 4px;
}

.pmon-message-text {
    font-size: 14px;
    line-height: 1.45;
    color: #444;
}

/* INFO */
.pmon-message.info {
    border-color: #3498db;
    background: #f2f8fd;
}
.pmon-message.info .pmon-message-icon {
    background-color: #3498db;
    background-image: url("data:image/svg+xml,%3Csvg fill='white' viewBox='0 0 24 24' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M11 9h2V7h-2v2zm0 8h2v-6h-2v6zm1-15C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2z'/%3E%3C/svg%3E");
}

/* SUCCESS */
.pmon-message.success {
    border-color: #2ecc71;
    background: #edf9f1;
}
.pmon-message.success .pmon-message-icon {
    background-color: #2ecc71;
    background-image: url("data:image/svg+xml,%3Csvg fill='white' viewBox='0 0 24 24' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M9 16.17l-3.88-3.88L4 13.41 9 18.41 20 7.41 18.59 6 9 16.17z'/%3E%3C/svg%3E");
}

/* WARNING */
.pmon-message.warning {
    border-color: #f39c12;
    background: #fff7e6;
}
.pmon-message.warning .pmon-message-icon {
    background-color: #f39c12;
    background-image: url("data:image/svg+xml,%3Csvg fill='white' viewBox='0 0 24 24' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M1 21h22L12 2 1 21zm12-3h-2v-2h2v2zm0-4h-2v-4h2v4z'/%3E%3C/svg%3E");
}

/* ERROR */
.pmon-message.error {
    border-color: #e74c3c;
    background: #fdecea;
}
.pmon-message.error .pmon-message-icon {
    background-color: #e74c3c;
    background-image: url("data:image/svg+xml,%3Csvg fill='white' viewBox='0 0 24 24' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm5 13.59L15.59 17 12 13.41 8.41 17 7 15.59 10.59 12 7 8.41 8.41 7 12 10.59 15.59 7 17 8.41 13.41 12 17 15.59z'/%3E%3C/svg%3E");
}

