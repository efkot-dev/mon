/*admin::main*/
.main-stats-tab a.tab-url span{display: block;font-size: 11px;line-height: 11px;background: #5c84ba;color: #fff;padding: 1px 4px;}
.main-stats-tab a.tab-active span {display: block;font-size: 11px;line-height: 11px;background: #5c84ba;color: #fff;padding: 1px 4px;}
.main-stats-tab a.tab-url {border: 1px solid #fff0;color: #5b7fa7;}
.main-stats-tab a.tab-active { border: 1px solid #99b3d0; color: #99b3d0;}
.main-stats-tab a.tab-url:hover {border: 1px solid #2b87b1;color: #2b87b1;}
.main-stats-tab {margin: 10px 10px 10px 10px;}
.main-stats-tab a i {position: relative;top: 2px;margin-right: 7px;}
.main-stats-tab a {padding: 2px 5px 7px 5px;margin: 0 3px 0 0;line-height: 18px;display: inline-block;transition: background 0.5s, border 0.5s, border-radius 0.5s, box-shadow 0.5s;}

.main-gr-tab a.tab-url span{display: block;font-size: 11px;line-height: 11px;background: #5c84ba;color: #fff;padding: 1px 4px;}
.main-gr-tab a.tab-active span {display: block;font-size: 11px;line-height: 11px;background: #5c84ba;color: #fff;padding: 1px 4px;}
.main-gr-tab a.tab-url {border: 1px solid #fff0;color: #5b7fa7;}
.main-gr-tab a.tab-active { border: 1px solid #99b3d0; color: #99b3d0;}
.main-gr-tab a.tab-url:hover {border: 1px solid #2b87b1;color: #2b87b1;}
.main-gr-tab {margin: 10px 10px 10px 10px;}
.main-gr-tab a i {position: relative;top: 2px;margin-right: 7px;}
.main-gr-tab a {
    padding: 7px 12px 7px 9px;
    margin: 0 3px 0 0;
    line-height: 18px;
    display: inline-block;
    transition: background 0.5s, border 0.5s, border-radius 0.5s, box-shadow 0.5s;
}
