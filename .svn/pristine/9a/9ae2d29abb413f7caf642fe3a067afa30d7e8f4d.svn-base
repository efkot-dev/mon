    align-items: flex-start;
    border: 1px solid #dbe0e0;
    padding: 5px;
    border-radius: 5px;
    background: #fff;
}
.min_to .dates {
    background: #eee;
    color: #222;
    margin-right: 5px;
    padding: 3px 5px;
}
.resp-tab .td_name{
    background: #fff;
    color: #0f73c3;
    padding-left: 20px;
    text-align: left;
    border-bottom: 1px solid #57a3c7;
    text-decoration: underline;
}
body .mmain .none {
    white-space: initial;
}
.resp-tab {
    border-radius: 5px;
    font-weight: normal;
    border: none;
    font-size: 13px;
    border-collapse: collapse;
    margin-bottom: 20px;
    width: 100%;
    max-width: 100%;
    white-space: nowrap;
    background-color: white;
    box-shadow: 0px 5px 10px rgb(0 0 0 / 12%);
}
.resp-tab .typesmac {
    text-align: left;
    padding: 0 20px;
}
#ontbdcomepon{padding:10px;}
.resp-tab .typesmac img {
    vertical-align: text-bottom;
    margin-right: 5px;
	cursor:pointer;
    width: 16px;
}
.resp-tab td, .resp-tab th {
    text-align: center;
    padding: 4px;
    font-size: 13px;
    border: none;
}
.resp-tab td {
    font-size: 13px;
    border-right: 1px solid #e6e4e452;
}
.resp-tab th {color: #ffffff;background: #2d6b9f;}
.resp-tab th:nth-child(odd) {background: #337AB7;}
.resp-tab tr:nth-child(even) {background: #F8F8F8;}
@media (max-width: 767px) {.resp-tab {display: block;width: 100%;}
.resp-tab .typesmac {
    text-align: left;
    padding: 3px 2px;
}
.name_onu_olt {
    display: inline-block;
    font-size: 10px;
    height: 10px;
    cursor: pointer;
    text-decoration: underline;
    margin-bottom: 0px;
    color: #166db3;
    padding: 0 10px;
}
.knopka_css {
    text-decoration: underline;
    color: #222;
    cursor: pointer;
    font-size: 12px;
    display: inline-block;
}
.resp-tab thead, .resp-tab tbody, .resp-tab thead th {font-size: 9px;}
.resp-tab thead {}
.resp-tab tbody {width: auto;position: relative;overflow-x: auto;}
.resp-tab td, .resp-tab th {
    padding: 0;
    box-sizing: border-box;
    width: 100%;
    font-size: 7px;
}
.resp-tab thead th {text-align: center;font-size: 9px;}
.resp-tab tbody tr {}
.resp-tab tbody tr:nth-child(odd) {background: none;}
.resp-tab tr:nth-child(even) {background: transparent;}
.resp-tab tr td:nth-child(odd) {background: #F8F8F8;border-right: 1px solid #E6E4E4;}
.resp-tab tr td:nth-child(even) {border-right: 1px solid #E6E4E4;}
.resp-tab td {text-align: center;}
}

