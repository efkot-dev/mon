    font-size: 12px;
}
.hide_btn {
	display: none;
}
.flav {
    display: flex;
    flex-direction: row;
    align-content: center;
    justify-content: flex-start;
    align-items: center;
}
#onu {
    background: #fff;
    padding: 10px;
    border-radius: 5px;
    margin: 0 10px 0 0px;
    box-shadow: 0 1px 20px 0 rgb(69 90 100 / 8%);
