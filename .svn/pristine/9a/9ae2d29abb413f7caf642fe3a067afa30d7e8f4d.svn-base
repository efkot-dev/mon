}
.circle-zoom {
    width: 32px;
	cursor:pointer;
    height: 32px;
    border-radius: 50%;
    overflow: hidden;
    display: inline-block;
    position: relative;
    border: 1px solid #fff;
    box-shadow: 0 1px 10px 0 #41708b9e;
    transition: all 0.3s ease;
}
.circle-zoom:hover {
	border: 1px solid #fff;
    box-shadow: 0 3px 13px 0 #043855e8;
}

/* Стилі для зуму менше ніж minZoomLevel */
.mapper .maponline.collapsed {
    top: -6px;
    left: calc(50% - 28px);
    background: #84ff84;
    color: #020202;
    border: 1px solid #fff;
    box-shadow: 0 1px 10px 0 #41708b9e;
}
.mapper .mapstats.collapsed {
    top: 14px;
    left: -22px;
    background: #2d8bbc;
    color: #fff;
    border: 1px solid #fff;
    box-shadow: 0 1px 10px 0 #41708b9e;
}
.mapper .mapoffs.collapsed {
    top: -10px;
    left: calc(50% - 21px);
    background: #2d8bbc;
    color: #fff;
    border: 1px solid #fff;
    box-shadow: 0 1px 10px 0 #41708b9e;
}
.mapper .mapoff.collapsed {
    top: 5px;
    right: -1px;
    background: red;
    color: #fff;
    border: 1px solid #fff;
    box-shadow: 0 1px 10px 0 #41708b9e;
}

/* Стилі для зуму більше або дорівнює minZoomLevel */
.mapper .maponline.expanded {
    top: -17px;
    left: calc(50% - 23px);
    background: #84ff84;
    color: #020202;
    border: 1px solid #fff;
    box-shadow: 0 1px 10px 0 #41708b9e;
}
.mapper .mapstats.expanded {
    top: 5px;
    left: -26px;
    background: #3d6bbf;
    color: #fff;
    border: 1px solid #fff;
    box-shadow: 0 2px 15px 0 #2b3d7a;
}
.mapper .mapoffs.expanded {
    top: -5px;
    left: calc(50% - 25px);
    background: #3d6bbf;
    color: #fff;
    border: 1px solid #fff;
    box-shadow: 0 2px 15px 0 #2b3d7a;
}
.mapper .mapoff.expanded {
    top: -24px;
    right: -10px;
    background: #ff4d4d;
    color: #fff;
    border: 1px solid #fff;
    box-shadow: 0 2px 15px 0 #b32d2d;
}
.mapper .maponline, .mapper .mapstats, .mapper .mapoff {
    position: absolute;
    width: 18px;
    height: 18px;
    display: flex;
    text-align: center;
    font-size: 10px;
    border-radius: 50%;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
}
.mapper .maponline:hover, .mapper .mapstats:hover, .mapper .mapoff:hover {
    width: 24px; 
    height: 24px;
    font-size: 14px;
}
