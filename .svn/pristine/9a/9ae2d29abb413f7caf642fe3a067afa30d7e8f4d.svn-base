#page-title i {
    position: relative;
    top: 2px;
    margin-right: 10px;
}
#page-title {
    font-size: 15px;
    font-weight: 300;
    margin: 0 10px 0px 10px;
    padding: 5px;
    color: #638aab;
}
#list-add {
    display: flex;
    width: 100%;
    padding: 10px 0px 0 0;
    flex-wrap: wrap;
}
#list-add .add-dev-one:hover {
    border: 1px solid #E91E63;
    box-shadow: 0 1px 20px 0 rgb(69 90 100 / 8%);
}
#list-add .add-dev-one {
    border-radius: 4px;
    max-width: 145px;
    min-height: 100px;
    position: relative;
    -webkit-box-flex: 1;
    margin: 0 10px 0 0px;
    margin-bottom: 10px;
    border: 1px solid #fff;
    transition: all 0.3s cubic-bezier(0.26, 0.46, 0.45, 0.95) 0s;
    background-color: #fff;
}
#list-add .add-url{
	position: absolute;
    inset: 0px;
    z-index: 20;
    display: block;
}
#list-add .add-name {
    font-weight: 300;
    font-size: 13px;
    line-height: 1;
    text-align: center;
    letter-spacing: -0.4px;
    color: rgb(4 105 155);
    transition: color 0.3s cubic-bezier(0.26, 0.46, 0.45, 0.95) 0s;
    padding-left: 5px;
    padding-right: 5px;
    padding-bottom: 10px;
}
#list-add .add-img{
    height: 70px;
    display: flex;
    width: 100%;
    -webkit-box-align: center;
    align-items: center;
    padding-left: 10px;
    padding-right: 10px;
}
#list-add .add-img .add-sub-img{
    width: 100%;
    text-align: center;
}
#list-add .add-img .add-sub-img img{
	width: 123px;
	vertical-align: middle;
}
