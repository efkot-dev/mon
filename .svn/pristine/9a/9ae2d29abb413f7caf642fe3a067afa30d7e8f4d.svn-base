/*MAIN:CONFIG*/
.pageform .select:hover{
    border: 1px solid tomato;
}
.pageform .subpole {
    padding: 5px;
    background: #eeeeee42;
    width: 97%;
    margin: 8px 2px 2px 2px;
}
.pageform .polebtn button:hover{
	background: #1159c4;
	opacity: 1;
}
.pageform .polebtn button {
    background-color: #2b72b1;
    transition: all 0.3s cubic-bezier(0.26, 0.46, 0.45, 0.95) 0s;
    border-radius: 3px;
    font-size: 13px;
    height: 31px;
    line-height: 15px;
    margin-right: 10px;
    padding: 0px 18px;
    opacity: 0.8;
}
.pole1 .img {
    width: 40px;
    text-align: center;
}
.pole1 .img img {
    height: 20px;
    position: relative;
    top: 4px;
}
.pageform .select {
    display: block;
    height: 31px;
    line-height: 35px;
    padding: 0 7px;
    background-color: #fff;
    color: #515356;
    border-radius: 1px;
    font-size: 14px;
    box-shadow: none;
    border: 1px solid #2423232e;
}
/*MAIN:CONFIG*/
/*MAIN:SFP*/
.olt-style {
    display: flex;
    flex-direction: column;
    width: 100%;
    justify-content: flex-start;
    align-items: flex-start;
    background: linear-gradient(110.66deg,#e7edf3 11.08%, #dae4ee 43.29%);
    padding: 4px;
    margin-bottom: 10px;
    border-radius: 5px;
}
.olt-style:hover{
	background: #fff;
	cursor:pointer; 
	transition: all .2s;
}
.main-switch-name {
    display: flex;
    flex-direction: row;
    flex-wrap: nowrap;
    line-height: 20px;
    margin-left: 7px;
    justify-content: flex-start;
    align-items: center;
}
.main-switch-name .m {
    background: #222;
    color: #fff;
    padding: 0 7px;
}
.main-switch-name .s {
    color: #222;
    margin-right: 10px;
    padding: 0 10px;
    background: #cccccca6;
}
.main-switch-name .n {
    color: #0173cd;
    text-decoration: underline;
    margin-right: 10px;
}
.main-switch-name span {
    margin: 5px 0;
    padding: 0;
    text-align: left;
}
.main-switch-olt {
    display: block;
    margin: 5px;
}
.main-switch-port {
    display: flex;
    flex-wrap: wrap;
    margin-left: 5px;
}
.main-switch-port .load-sfp:hover{
    border: 1px solid tomato;	
}
.search-model {
    font-size: 12px;
    max-width: 110px;
    min-width: 80px;
    line-height: 12px;
    color: #222;
    padding: 3px 2px;
    border-radius: 2px;
    background: #6c6c6d1f;
    border: 0;
    display: inline-block;
    margin: 0px;
}
.main-switch-port .load-sfp {
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    align-items: flex-start;
    width: 100px;
    background: #fff;
    margin: 0 5px 5px 0px;
    font-size: 10px;
    line-height: 14px;
    border: 1px solid #fff0;
    cursor: pointer;
    padding: 3px 0px 3px 6px;
    border-radius: 3px;
    box-shadow: 0 0.46875rem 2.1875rem rgb(61 94 165 / 3%), 0 0.9375rem 1.40625rem rgb(4 9 20 / 0%), 0 0.25rem 0.53125rem rgb(4 9 20 / 0%), 0 0.125rem 0.1875rem rgb(4 9 20 / 0%);
}
.load-sfp-data {
    display: flex;
    flex-wrap: wrap;
}
.main-switch-port .load-sfp .name-sfp {
    text-decoration: underline;
    color: #0464e2;
    font-size: 13px;
}
.main-switch-port .load-sfp .stats-sfp{}
.main-switch-port .load-sfp .stats-sfp .signal-sfp {
    font-size: 12px;
    font-weight: 600;
}
@media screen and (max-width: 9000px) {
	.admin-2 .main-panel {
	    grid-template-columns: repeat(16, 1fr);
	}
}
@media screen and (max-width: 2560px) {
	.admin-2 .main-panel {
	    grid-template-columns: repeat(10, 1fr);
	}
}
@media screen and (max-width: 2050px) {
	.admin-2 .main-panel {
	   grid-template-columns: repeat(7, 1fr);
	}
}
@media screen and (max-width: 1650px) {
	.admin-2 .main-panel {
	    grid-template-columns: repeat(6, 1fr);
	}
}
@media screen and (max-width: 1300px) {
	.admin-2 .main-panel {
	    grid-template-columns: repeat(4, 1fr);
	}
}
.grid8 {
    grid-template-columns: repeat(8, 1fr);
}
.nopinger{
    background: red;
    color: #fff;
}
.main-panel {
    display: grid;
    width: 100%;
    margin: 10px 0;
    padding: 0;
}
.main-panel a img {
    width: 120px;
    /*height: 48px;*/
}
.main-panel a span {
    width: 100%;
    text-align: center;
    padding: 3px 0px;
}
.admin-1 .main-panel a:hover{
	background: #ffffff8a;
	color:#222;	
	border-color: rgba(0, 0, 0, 0.1);
    box-shadow: rgba(0, 0, 0, 0.1) 0px 0px 25px;
}
.admin-1 .clickable:hover{
    opacity: 1;	
}
.admin-1 .clickable {
    position: absolute;
    opacity: 0.7;
    width: 16px;
    cursor: pointer;
    height: 16px;
    margin: -64px 0 0px -100px;
}
.admin-1 .clickable img {
    height: 16px;
    width: 16px;
}
.admin-1 .main-panel a {
    border-radius: 5px;
    padding: 5px;
    line-height: 14px;
    font-size: 14px;
    color: #1f5195;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
}
