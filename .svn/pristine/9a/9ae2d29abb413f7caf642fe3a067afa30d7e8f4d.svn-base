    width: 100%;
}
#detaillocation .informations {
    width: 100%;
    border-bottom: 2px solid #d7e6f696;
    padding: 5px 0 13px 0;
    margin-bottom: 0px;
}
#block-location {
    width: 100%;
    display: flex;
    flex-wrap: wrap;
    align-content: flex-start;
    justify-content: flex-start;
    align-items: flex-start;
}
#block-location .object {
    width: 170px;
    height: 90px;
    overflow: hidden;
    border-radius: 3px;
    display: flex;
    flex-direction: column;
    flex-wrap: nowrap;
    align-content: center;
    justify-content: flex-start;
    align-items: center;
}
#block-location .object .img {
    height: 50px;
}
#block-location .object .img img {
    height: 100%;
}
#block-location .object a:hover{
    color: red;
}
