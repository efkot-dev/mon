}
.ui.grid {
    display: flex;
    flex-flow: row wrap;
    align-items: stretch;
    padding: 10px 0;
}
.ui.grid>.column:not(.row) {
    padding-top: 1rem;
    padding-bottom: 1rem;
}
.ui.grid>.column:not(.row), .ui.grid>.row>.column {
    position: relative;
    display: inline-block;
    width: 33.25%;
    padding-left: 1rem;
    padding-right: 1rem;
    vertical-align: top;
}
.ui.list:first-child, ol.ui.list:first-child, ul.ui.list:first-child {
    margin-top: 0;
    padding-top: 0;
}
.ui.basic.button:hover {
