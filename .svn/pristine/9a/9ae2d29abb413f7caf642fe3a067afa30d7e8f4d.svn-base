/*TEMP*/
.list_block {
    display: flex;
    flex-direction: column;
    width: 100%;
    justify-content: flex-start;
    align-items: flex-start;
    border-radius: 5px;
    border: none;
    transition: all .5s ease-in-out;
    background: #fff;
    padding: 10px;
    margin: 5px 5px 15px 5px;
    box-shadow: 0 0.46875rem 2.1875rem rgba(4, 9, 20, 0.03), 0 0.9375rem 1.40625rem rgba(4, 9, 20, 0.03), 0 0.25rem 0.53125rem rgba(4, 9, 20, 0.05), 0 0.125rem 0.1875rem rgba(4, 9, 20, 0.03);
    align-content: flex-start;
    flex-wrap: nowrap;
}
.list_block_temp {
    display: flex;
    flex-direction: row;
    width: 100%;
    justify-content: flex-start;
    align-items: flex-start;
    border: none;
    flex-wrap: wrap;
}
.list_block_temp .bl_temp {
    display: flex;
    flex-direction: column;
    border-radius: 5px;
    cursor: pointer;
    height: 65px;
    width: 150px;
    padding: 5px 0 5px 0;
    flex-wrap: nowrap;
    text-align: center;
    justify-content: flex-start;
    border: 1px solid #fff;
    align-items: center;
    margin: 10px 5px 5px 0;
}
.list_block_temp .bl_temp:hover{
	background: #60cbff0d;
    border: 1px solid #3798c785;
}
.list_block_temp .bl_temp .sensor_temp span {
    font-size: 16px;
    opacity: 0.7;
}
.list_block_temp .bl_temp .sensor_temp {
    padding: 5px 0 5px 0;
    font-size: 24px;
    color: #4CAF50;
    font-weight: 300;
    line-height: 13px;
}
.list_block_temp .bl_temp .critical_sensor_temp {
    padding: 5px 0 5px 0;
    font-size: 24px;
    color: red;
    font-weight: 300;
    line-height: 13px;
}
.list_block_temp .bl_temp .sensor_name {
    color: #222;
    line-height: 14px;
    height: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
}
