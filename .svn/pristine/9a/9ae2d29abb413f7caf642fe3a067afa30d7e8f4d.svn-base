	background: #d8f3a6;	
}
table.pon_diagnostic .opiym td{
	color:grey;
}
table.pon_diagnostic .opiym{
	background: #eee;	
}
.pon_diagnostic td {
    color: #1083d8;
    font-size: 13px;
    padding: 4px 10px;
    border-bottom: 1px solid #5c84ba52;
    text-align: center;
}
.pon_diagnostic .pon_onu:hover{
    background: #d8f3a6;
    cursor: pointer;
}
.pon_diagnostic .black {
    background: #222;
}
.pon_diagnostic .blue {
    background: #0070c4;
}
.pon_onu .statusonu {
    position: relative;
    top: 4px;
}
