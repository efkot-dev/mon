.color_main_1{    background: -webkit-gradient(linear,left top,right top,from(#ba2158),color-stop(48.94%,#ed2424),to(#ba2158));
    background: -o-linear-gradient(left,#ba2158 0%,#ed2424 48.94%,#ba2158 100%);
    background: linear-gradient(90deg,#ba2158 0%,#ed2424 48.94%,#ba2158 100%);}
.color_main_2{background: -webkit-gradient(linear,left top,right top,from(#55969a),color-stop(48.94%,#1fba59),to(#55969a));
    background: -o-linear-gradient(left,#55969a 0%,#1fba59 48.94%,#55969a 100%);
    background: linear-gradient(90deg,#55969a 0%,#1fba59 48.94%,#55969a 100%);}
.color_main_3{background: -webkit-gradient(linear,left top,right top,from(#55969a),color-stop(48.94%,#46a9c8),to(#55969a));
    background: -o-linear-gradient(left,#55969a 0%,#46a9c8 48.94%,#55969a 100%);
