}
.block-cover {
    justify-content: flex-start;
    align-items: center;
    display: flex;
    position: relative;
    width: 98%;
    height: 160px;
    overflow: hidden;
    padding: 0 0 0 2px;
}
.hw100 {
    height: 100%;
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: flex-start;
    flex-direction: column;
    padding: 0;
}
.block-cover .cover_photo {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
}
.hw100:hover .cover_photo img {
	transform: scale(1.1); /* Збільшення картинки на 10% */
    transition: transform 0.8s ease-in-out; /* Плавний перехід */	
}
.block-cover .cover_photo img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover; /* Масштабувати зображення, щоб заповнити контейнер */
    z-index: 1; /* Зображення на задньому плані */
}
.block-cover .cover_photo::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(to bottom, rgb(82 81 81 / 19%) 20%, rgb(255 255 255 / 78%) 100%);
    z-index: 2;
    pointer-events: none;
}
