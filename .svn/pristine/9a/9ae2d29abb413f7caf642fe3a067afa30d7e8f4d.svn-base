    color: rgba(0, 0, 0, .6);
	padding: 2px 0px;
    font-size: 13px;
    border-radius: .28571429rem;
    text-transform: none;
    text-shadow: none !important;
    margin-bottom: 6px;
    box-shadow: 0 0 0 1px rgba(34, 36, 38, .15) inset;
}
