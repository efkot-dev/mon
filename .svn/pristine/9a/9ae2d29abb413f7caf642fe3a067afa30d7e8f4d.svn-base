/*BOARD*/
.board_time_view {
        display: flex;
        align-items: center;
        gap: 10px;
        font-family: sans-serif;
        margin-bottom: 10px;
    }
    .board_time_start, .board_time_end {
        width: 120px;
    }
    .board_time_progress {
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 5px;
    }
.progress_bar {
    background: #eee;
    border-radius: 5px;
    margin-top: 5px;
    height: 11px;
    overflow: hidden;
    position: relative;
}
    .progress_fill {
        height: 100%;
        width: 0%;
        transition: width 0.5s ease;
    }
    .progress_text {
        text-align: center;
        font-size: 14px;
    }
    .progress_fill_normal {
        background: linear-gradient(90deg, #00c853, #64dd17);
    }
    .progress_fill_expired {
        background: red;
        animation: blinkboard 1s infinite;
    }
    @keyframes blinkboard {
        0%, 50%, 100% { opacity: 1; }
        25%, 75% { opacity: 0.3; }
    }
.board_time {
    display: block;
    font-size: 12px;
    color: #0c80d2;
}
.board_time img {
    vertical-align: sub;
    margin-right: 3px;
}
sup {
    position: absolute;
    margin-top: -13px;
    padding: 2px 4px 1px 3px;
    background: #ffe30b;
    color: #020202;
    margin-left: -38px;
    border-radius: 2px;
}
