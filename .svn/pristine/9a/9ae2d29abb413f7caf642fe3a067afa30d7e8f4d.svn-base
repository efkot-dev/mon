    color: #6e89a7;
}
#ont .ont-label:hover{
	cursor:pointer;
	border: solid 1px #c1c1d442;
    box-shadow: 0px 10px 30px -10px rgb(13 43 64 / 8%);
}
#ont .ont-label {
    transition: background 0.3s, border 0.3s, border-radius 0.3s, box-shadow 0.3s;
    color: #000000;
    margin: 4px 4px 11px 4px;
    padding: 5px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    border: solid 1px #fff;
    box-shadow: 0px 10px 10px -10px rgb(13 43 64 / 0%);
    gap: 10px;
