/*main-search*/
.icon-search i:hover{
    color: #fff;
}
#block-main-right {
    position: relative;
    display: flex;
    flex-direction: row;
    flex-wrap: nowrap;
    justify-content: flex-start;
    align-items: center;
    height: 54px;
    position: absolute;
    right: 10px;
}
.block-main i {
    position: relative;
    top: 2px;
}
.block-main svg:hover {
    opacity: 1;
}
.dr-menu a:hover{
	background-color: #f2f2f2;
	color:#222;
}
.dr-menu a {
    color: #333;
    text-decoration: none;
    padding: 7px 20px;
    display: block;
    font-size: 13px;
}
nav li a i {
    position: relative;
    margin-right: 10px;
    top: 2px;
}
.dr-menu-info {
    margin: 0 4px 0 3px;
    position: relative;
    top: 0px;
}
.dr-menu {
    display: none;
    position: absolute;
    background-color: #fff;
    z-index: 999;
    box-shadow: 0 1px 10px 0 #9bacb673;
    padding: 0px;
    top: 44px;
    margin-left: -100px;
    min-width: 170px;
}
.block-main svg {
    position: relative;
    top: 4px;
    opacity: 0.8;
    height: 24px;
    width: 24px;
}
.block-main {
    position: relative;
    display: block;
    margin: 0 7px 0 0px;
}
.nav-pmon .menu_main:hover{
	color:#fff;
}
.nav-pmon .menu_main {
    outline: none;
    background: none;
    border: 0;
    color: #9dc1dc;
    margin: 0 11px 0 13px;
    font-weight: 300;
    font-size: 18px;
}
.icon-search {
    cursor: pointer;
    background: none;
    border: 0;
    color: #9dc1dc;
    font-weight: 300;
    font-size: 18px;
    text-decoration: none;
    padding: 9px 10px;
}
.form_search .search-input {
    width: 250px;
    background: #fff;
    display: none;
    border: none;
    height: 25px;
    font-size: 13px;
    position: relative;
    padding: 3px 4px;
    border-radius: 1px;
    box-shadow: 0 0 4px 0 rgb(0 0 0 / 35%);
    top: -3px;
}
body .block-main .show {
    display: inline;
}
