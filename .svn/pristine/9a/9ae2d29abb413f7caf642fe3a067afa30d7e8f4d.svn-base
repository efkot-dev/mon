    padding: 0 5px;
}
#commenthistory:hover{
	border: 1px solid #3995df;
    box-shadow: 0 1px 3px 0 rgb(49 177 239 / 37%);	
}
#commenthistory {
    background: #eeeeee00;
	 transition: background 0.5s, border 0.5s, border-radius 0.5s, box-shadow 0.5s;
    border: 1px solid #ffffff;
    box-shadow: 0 1px 3px 0 rgb(69 90 100 / 5%);
    padding: 5px;
    border-radius: 4px;
