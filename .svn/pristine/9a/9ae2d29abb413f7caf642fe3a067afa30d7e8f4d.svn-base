    width: 100%;
    position: relative;
    top: -20px;
}
#detaillocation .informations h2 a:hover{
	    color: red;
}
#detaillocation .informations h2 a {
    font-size: 13px;
    margin: 0 5px;
    font-weight: 300;
    color: blue;
    text-decoration: underline;
}
