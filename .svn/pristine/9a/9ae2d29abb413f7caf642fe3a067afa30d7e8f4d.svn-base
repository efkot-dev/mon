    background-color: #007bff; /* Колір фону кнопок */
    color: #fff; /* Колір тексту кнопок */
    border-radius: 3px; /* Закруглені краї кнопок */
    cursor: pointer; /* Зміна курсора на pointer при наведенні */
}

