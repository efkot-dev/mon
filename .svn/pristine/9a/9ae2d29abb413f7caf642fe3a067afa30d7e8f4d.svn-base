		font-size: 10px;
		color: #526d9ecc;
		border-radius: 3px;
		border: 1px solid #fff;
		width: 47%;
	}
	.content .moder-panel {
		display: flex;
		width: 100%;
		flex-wrap: wrap;
		align-items: flex-start;
		margin-bottom: 0;
	}
	.block-center .list-tree-object .pon-tree-object {
		width: 33%;
	}
	.mmain #onu .onu-inf {
		display: grid;
		grid-template-columns: 1fr;
		gap: 15px;
	}
	.wrap .sidebar .nav{
		width: 36px;
	}	
	.sidebar .nav-link .m {
		display: none;
	}
	.sidebar .nav-link:hover .m {
		display: block;
		position: fixed;
		padding: 3px 10px;
		border-radius: 6px;
		background: #3f4d67;
		box-shadow: 1px 0 15px 0 #3f4d676b;
		color: #a9b7d0;
		margin-left: 47px;
		margin-top: -22px;
	}	
	.wrap .sidebar .dropdown-toggle:before{
		display: none;
	}	
	.wrap .logo{
		display: none;
	}
	.col-left{
		width: 40px;	
	}
	.oltfon .list_pon_url {
		grid-template-columns: repeat(2, 1fr);
		gap: 5px;
		margin-bottom: 0px;
	}
	.oltfon .list_pon{
		grid-template-columns: repeat(2, 1fr);
		gap: 5px;
		margin-bottom: 0px;
	}
	.oltfon .olt-count {
		background: #328ed6;
		font-size: 8px;
		position: absolute;
		height: 10px;
		padding: 1px 4px 2px 4px;
		color: #fff;
		border-radius: 3px;
		margin: 0px 0px 0 2px;
	}
	.oltfon .bad-olt-count {
		background: red;
		font-size: 8px;
		position: absolute;
		height: 10px;
		padding: 1px 4px 2px 4px;
		color: #fff;
		border-radius: 3px;
		margin: 0px 0px 0 2px;
	}
	.oltfon .monitor-list-head h2 {
		font-size: 9px;
	}
	.oltfon .list_pon_url .sub-descr {
		font-size: 9px;
		line-height: 9px;
		top: 0px;
	}
	.oltfon .list_pon_url {
		grid-template-columns: repeat(2, 1fr);
		gap: 5px;
	}
	
	.mmain .oltfon {
		padding: 0px;
		position: relative;
		background: transparent;
		box-shadow: none;
		border-radius: 0;
		margin-bottom: 0;
	}
}
/*BOARD*/
.pmon_block {
    display: flex;
    flex-direction: row;
    width: 100%;
    justify-content: flex-start;
    align-items: flex-start;
    padding: 0;
    margin: 0;
}
.pmon_block .pmon_block_left{}
.pmon_block .pmon_block_right {
    margin-left: 10px;
}
#board_fault h3 {
    font-size: 14px;
    padding: 5px 0px 5px 0px;
    color: #222;
    font-weight: 300;
}
.house-number-item{
	margin: 3px 0;
    display: flex;
    flex-direction: row;
    justify-content: flex-start;
    align-items: center;
    color: #222;
    font-size: 15px;
}
#main-board{}
#main-board .board_status_kvadrat {
    height: 13px;
    width: 13px;
    background: red;
    display: inline-block;
    margin: 0 6px 0px 0;
    position: relative;
    border-radius: 3px;
    top: 2px;
}
#main-board strong {
    font-weight: 300;
    color: #222;
    text-decoration: underline;
}
#main-board .boad_line:hover{
	background: #fff;
}
#main-board .boad_line {
    border: 1px solid #ff0000;
    padding: 4px;
    margin: 5px 0;
    cursor: pointer;
    background: #ffffff;
    border-radius: 3px;
}
#main-board h3 {
    font-size: 14px;
    margin: 0;
    padding: 0;
    color: #000000;
}
.board_time_view {
    display: flex;
    flex-direction: row;
    flex-wrap: nowrap;
    justify-content: space-evenly;
    width: 100%;
	font-size: 14px;
    margin-bottom: 6px;
}
.board_time_view .board_time_start, .board_time_view .board_time_progress, .board_time_view .board_time_end {
    position: relative;
    font-size: 12px;
    text-align: center;
    padding: 5px 0;
    font-weight: 600;
    color: #000;
}
/* Старт */
.board_time_view .board_time_start {
    width: 33.9%;
    background: #5ac864;
    margin: 0 0 0 0;
}
.mb5{margin-bottom: 15px;}
.board_time_details h2 {
    color: #ff0707;
    font-weight: 300;
}
.ports-container .port {
    width: 32.6%;
    display: flex;
	font-size: 12px;
    flex-direction: row;
    justify-content: flex-start;
    align-items: center;
    color: #222;
    padding: 2px 5px 2px 0px;
}
.ports-container{
    margin-top: 10px;
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-start;
    align-content: flex-start;
    align-items: flex-start;
}
.board_panel {
    display: flex;
    flex-direction: row;
    margin-top: 10px;
    justify-content: flex-start;
    align-items: center;
}
.board_panel a {
    padding: 3px 10px;
    margin: 0 10px 0 0;
    font-size: 13px;
    border-radius: 4px;
}
.block_inform h5 {
    font-size: 13px;
    font-weight: 300;
    line-height: 14px;
	color: red;
}
.block_inform h4{
    font-size: 14px;
    line-height: 15px;
}
.block_inform {
    background: #ffecec;
    border: 2px solid red;
    font-size: 13px;
    padding: 7px 10px;
    margin-bottom: 10px;
    color: #ff1616;
}
.select_page{}
.board_panel .edit:hover{
	background-color: #006eb4;
}
.board_panel .edit {
    background-color: #326ebe;
    border: 1px solid #2e6fb9;
    color: #fff;
    text-shadow: 0 -1px 0 rgba(0, 0, 0, 0.3);
    -webkit-box-shadow: 0 1px 0 rgba(255, 255, 255, 0.2) inset;
    box-shadow: 0 1px 0 rgba(255, 255, 255, 0.2) inset;
}
.board_panel .end:hover{
	background-color: #609028;
}
.board_panel .end {
    background-color: #5baa00;
    border: 1px solid #5baa00;
    color: #fff;
    text-shadow: 0 -1px 0 rgb(62 159 0);
    -webkit-box-shadow: 0 1px 0 rgba(255, 255, 255, 0.2) inset;
    box-shadow: 0 1px 0 rgba(255, 255, 255, 0.2) inset;
}
.board_panel .mess:hover{
	background-color: #ffbe00;
}
.board_panel .mess {
    background-color: #ffd352;
    border: 1px solid #ffd352;
    color: #000000;
    text-shadow: 0 -1px 0 rgb(255 255 255 / 30%);
    -webkit-box-shadow: 0 1px 0 rgba(255, 255, 255, 0.2) inset;
    box-shadow: 0 1px 0 rgba(255, 255, 255, 0.2) inset;
}
.board_panel .del:hover{
	background-color: red;
}
.board_panel .del {
    background-color: #ff5c5c;
    border: 1px solid #ff3838;
    color: #fff;
    text-shadow: 0 -1px 0 rgba(0, 0, 0, 0.3);
    -webkit-box-shadow: 0 1px 0 rgba(255, 255, 255, 0.2) inset;
    box-shadow: 0 1px 0 rgba(255, 255, 255, 0.2) inset;
}
.board_time_details .board_description {
    color: #010101;
    padding: 10px 0;
}
.board_time_view .board_time_start::after {
    content: "";
    position: absolute;
    top: 50%;
    right: -7px;
    transform: translateY(-50%);
    border-top: 16px solid transparent;
    border-bottom: 15px solid transparent;
    border-left: 16px solid #5ac864;
    z-index: 2;
}
.board_time_view .board_time_progress {
    width: 33.9%;
    background: #9ec3dc;
    color: #000000;
    margin: 0 0 0 -10px;
    z-index: 1;
}
.board_time_view .board_time_progress::after {
    content: "";
    position: absolute;
    top: 50%;
    right: -16px;
    transform: translateY(-50%);
    border-top: 16px solid transparent;
    border-bottom: 15px solid transparent;
    border-left: 16px solid #9ec3dc;
    z-index: 2;
}
/* End */
.board_time_view .board_time_end {
    width: 33.9%;
    background: #ffd352;
    margin: 0 0 0 -10px;
}
