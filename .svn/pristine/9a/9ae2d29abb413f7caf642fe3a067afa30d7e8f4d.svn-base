/*olt-stats-block*/
.progress-cpu-block {
    margin: 0;
    width: 98%;
}
.content .progress-cpu-block h3 {
    color: #22345880;
    padding: 0;
    font-size: 13px;
    font-weight: 300;
    margin: 0;
}
.progress-cpu {
    background-color: #e7e5e5;
    border-radius: 3px;
	width: 100%;
	height: 10px;
}
.progress-bar { float: left; }
.progress-bar.orange {
	background-color: #39b54a;
	height: 100%;
}
.progress-bar.blue {
    height: 100%;
    background-color: #37a6f3;
    border-radius: 3px;
}
.progress-bar.yellow {
	background-color: yellow;
	height: 100%;
}
.progress-bar.blue-dark {
background: #246781;
	height: 100%;
}
