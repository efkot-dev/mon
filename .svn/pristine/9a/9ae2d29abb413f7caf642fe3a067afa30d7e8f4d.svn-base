.blob {
    background: #ef9292;
    border-radius: 50%;
    margin: 0px 10px 1px 2px;
    height: 10px;
    width: 10px;
    box-shadow: 0 0 0 0 rgb(249 124 124);
    transform: scale(1);
    animation: pulse 2s infinite;
    display: inline-block;
}
@keyframes pulse {
	0% {
		transform: scale(0.95);
		box-shadow: 0 0 0 0 rgb(249 124 124 / 44%);
	}
	70% {
		transform: scale(1);
		box-shadow: 0 0 0 10px rgb(249 124 124 / 4%);
	}
	100% {
		transform: scale(0.95);
		box-shadow: 0 0 0 0 rgb(249 124 124 / 0%);
	}
}
