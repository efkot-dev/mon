}
.calendar .day_curent {
    background: #ebffeb;
}
.calendar th {
    border: 1px solid #ddd;
    padding: 5px;
    vertical-align: top;
    background: #528eb9;
    color: #fff;
    height: 33px;
    width: calc(100% / 7);
    box-sizing: border-box;
    text-align: center;
}
.calendar td {
    border: 1px solid #ddd;
    padding: 5px;
    vertical-align: top;
    height: 100px; /* Встановлено фіксовану висоту */
    width: calc(100% / 7); /* Встановлено ширину для кожної комірки */
    box-sizing: border-box; /* Забезпечує коректний підрахунок ширини та висоти */
    text-align: center;
}

.calendar .calendar-day {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: 100%;
}

