}
.unit-switch{}
.unit-switch .nameswitch {
    width: 100%;
    padding: 5px 2px;
}
.unit-switch .nameswitch .poles b {
    padding: 3px 0px;
}
.unit-switch .nameswitch .poles .ip {
    padding: 3px 0px;
    display: inline-block;
    margin: 0 0px 0 10px;
    color: #4295dd;
}
.unit-switch .nameswitch .poles {
    line-height: 14px;
    margin-bottom: 5px;
}
.unit-switch .portswitch {
    padding: 5px;
    margin: 0px 0 15px;
    background: #ffffff;
    border-radius: 4px;
    overflow: auto;
    width: 100%;
}
.unit-switch .moder-panel-switch .replace:hover{opacity: 1;}
.unit-switch .moder-panel-switch .replace {
    color: #719bc8;
	opacity: 0.7;
}
.unit-switch .moder-panel-switch .unmount:hover{opacity: 1;}
.unit-switch .moder-panel-switch .unmount{
	color: tomato;
	opacity: 0.7;
}
.unit-switch .moder-panel-switch span i {
    position: relative;
    top: 2px;
    margin-right: 3px;
}
.unit-switch .moder-panel-switch span {
    transition: all 0.3s cubic-bezier(0.26, 0.46, 0.45, 0.95) 0s;
    cursor: pointer;
    font-size: 14px;
    font-weight: 300;
    padding: 3px 5px;
    margin: 0 5px 0 0;
    border-radius: 3px;
}
.unit-switch .moder-panel-switch {
    display: inline-block;
    float: right;
}
.unit-switch .portswitch .portswitchsfp {
    display: flex;
    flex-wrap: wrap;
    align-content: flex-start;
    justify-content: flex-start;
    align-items: flex-start;
    padding: 0 5px;
}
.unit-switch .portswitch .portswitchsfp .sfpswitch:hover{
	transition: all 0.3s cubic-bezier(0.26, 0.46, 0.45, 0.95) 0s;
	cursor:pointer;	
	background: #fff;
	border: 1px solid #4cabd5ed;
}
.unit-switch .portswitch .portswitchsfp .sfpswitch .sfpswitchup {
    height: 3px;
    width: 5px;
    float: right;
    position: relative;
    background: #8ce88c;
    margin-top: -28px;
    margin-right: 2px;
    z-index: 9999;
    animation: blinker 0.5s linear infinite;
}
.unit-switch .portswitch .portswitchsfp .sfpswitch .sfpswitchdown {
    height: 3px;
    width: 5px;
    float: right;
    position: absolute;
    background: red;
    margin-top: -14px;
    margin-left: 23px;
}
.unit-switch .portswitch .numberport {
    position: relative;
    top: -31px;
    font-size: 10px;
}
.unit-switch .portswitch .portswitchsfp .sfpswitch {
    display: flex;
    width: 85px;
    height: 60px;
    text-align: center;
    padding: 0px 2px;
    overflow: hidden;
    border-radius: 3px;
    margin: 0 5px 5px 0px;
    border: 1px solid #b3b8e500;
    flex-direction: column;
    align-content: center;
    justify-content: center;
    align-items: center;
    flex-wrap: nowrap;
}
.unit-switch .portswitch .portswitchsfp .sfpswitch span{
	height: 30px;
}
.unit-switch .portswitch .portswitchsfp .sfpswitch span img {

}
.unit-switch .portswitch .portswitchsfp .sfpswitch h3 {
    font-size: 10px;
    line-height: 11px;
}
