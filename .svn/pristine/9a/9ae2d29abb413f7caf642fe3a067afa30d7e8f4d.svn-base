#invoiceTable td.fis:nth-child(3) {
    width: 10%;
}

#invoiceTable th.col-purchase-price,
#invoiceTable td.fis:nth-child(4) {
    width: 10%;
}

#invoiceTable th.col-quantity,
#invoiceTable td.fis:nth-child(5) {
    width: 5%;
}

#invoiceTable th.col-total-purchase,
#invoiceTable td.fis:nth-child(6) {
    width: 7%;
}

#invoiceTable th.col-price-with-markup,
#invoiceTable td.fis:nth-child(7) {
    width: 10%;
}

#invoiceTable th.col-total-with-markup,
#invoiceTable td.fis:nth-child(8) {
    width: 10%;
}

#invoiceTable th.col-custom-price,
#invoiceTable td.fis:nth-child(9) {
    width: 10%;
}

#invoiceTable th.col-custom-total,
#invoiceTable td.fis:nth-child(10) {
    width: 10%;
}

#invoiceTable th.col-actions,
#invoiceTable td.fis:nth-child(11) {
    width: 5%;
}
