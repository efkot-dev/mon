.win-overlay {
    position: fixed;
    left: 0;
    top: 0;
    z-index: 10000;
    width: 100%;
    height: 100%;
    background-color: rgb(0 0 0 / 18%);
    display: block;
}
#okno {
    display: block;
    background: #fff;
    border-bottom-right-radius: 5px;
    border-bottom-left-radius: 5px;
    min-width: 600px;
    max-width: 900px;
    position: fixed;
    margin: 0 auto;
    top: 20%;
    left: 25%;
    box-shadow: 0px 10px 20px 0 rgb(44 44 44 / 14%);
    z-index: 9999;
}
#okno .title .close:hover{
    opacity: 1;
}
#okno .title .close{
    position: relative;
	
    float: right;
    padding: 3px;
    cursor: pointer;
opacity: 0.6;
}
#okno .title:hover{
    cursor: all-scroll;
}
