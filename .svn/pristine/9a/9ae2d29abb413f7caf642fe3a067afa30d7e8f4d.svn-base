.page_monitor {
    display: flex;
    width: 100%;
    flex-direction: column;
    padding: 0;
    flex-wrap: nowrap;
    justify-content: flex-start;
    align-items: flex-start;
    margin-bottom: 20px;
    background: #fff;
    border-radius: 10px;
}
.page_monitor_page {
    display: flex;
    flex-direction: column;
    flex-wrap: nowrap;
    width: 100%;
    justify-content: flex-start;
    align-items: flex-start;
}
.page_monitor_head {
    margin-bottom: 10px;
    border-bottom: 1px solid #2222223b;
    display: inline-block;
    background: #eeeeee75;
    width: 100%;
}
.page_monitor_list {
    width: 100%;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(9, 1fr);
    gap: 0px;
    justify-items: center;
}
.page_monitor_list .page_monitor_port {
    font-size: 12px;
    margin: 0 0 10px 0;
    display: flex;
    flex-direction: column;
    padding: 0;
    align-items: center;
    width: 100%;
    overflow: hidden;
}
