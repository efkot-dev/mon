    color: #fff;
    text-decoration: underline;
}
.list_time:hover .down_type {
    color: #fff;
    text-decoration: underline;
}
.list_time:hover {
    cursor: pointer;
    background: #2869df;
    color: #fff;
}
.list_time {
    display: flex;
	transition: background 0.5s, border 0.5s, border-radius 0.5s, box-shadow 0.5s;
    width: 100%;
    border-bottom: 1px solid #e4f5f7;
    padding: 2px 10px;
    flex-direction: row;
    flex-wrap: nowrap;
    justify-content: flex-start;
    align-items: center;
}
.list_time .down_type {
    display: inline-block;
    font-size: 13px;
    color: #123199;
}
.list_key_spoiler.open:before {
    transform: rotate(180deg);
}
