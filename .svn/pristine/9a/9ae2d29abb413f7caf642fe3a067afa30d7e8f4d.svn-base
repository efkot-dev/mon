/*etail::block*/
/*move*/
.prcy-1l4rpax {
    padding: 0;
    /* z-index: 999; */
    display: block;
    margin-left: 0px;
    margin-right: 0px;
    border-radius: 10px 10px 0 0;
    content: '';
    display: block;
    margin-bottom: -10px;
    height: 15px;
    background-image: repeating-linear-gradient(-45deg, #000, #000 11px, #ffb604 0, #ffe204 20px);
    -webkit-background-size: 28px 28px;
    background-size: 28px 28px;
    -webkit-animation: move 0.5s linear infinite;
    -webkit-animation: move 0.5s linear infinite;
    animation: move 0.5s linear infinite;
}
@-webkit-keyframes move{
  0%{-webkit-background-position:0 0;background-position:0 0;}
  100%{-webkit-background-position:28px 0;background-position:28px 0;}
}
@keyframes move{
  0%{-webkit-background-position:0 0;background-position:0 0;}
  100%{-webkit-background-position:28px 0;background-position:28px 0;}
}
