#onu-list {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
}
#loadingBar img {
    border-radius: 12px;
    height: 39px;
    box-shadow: 0 0.46875rem 2.1875rem rgb(61 94 165 / 3%), 0 0.9375rem 1.40625rem rgb(4 9 20 / 0%), 0 0.25rem 0.53125rem rgb(4 9 20 / 0%), 0 0.125rem 0.1875rem rgb(4 9 20 / 0%);
}
#loadingBar{
    text-align: center;
    position: absolute;
    margin: 0 50%;
    top: 200px;
}
.onu-item {
    padding: 5px 10px;
    border: 1px solid #ccc;
    border-radius: 4px;
    background: #f9f9f9;
    transition: opacity 0.3s ease, background 0.3s ease;
}

.onu-item:hover {
    background: #e0e0e0;
}
.blinkers_1s {
    animation: blinker 1s linear infinite;
}
@keyframes blinker {
    50% {
        opacity: 0;
    }    
	99% {
		stroke:#222;
    }
}
.pon_diagnostic {
	border-collapse: collapse;
    background: #ffffffab;
    padding: 3px;
    border-radius: 5px;
    top: 20px;
    position: relative;
}
