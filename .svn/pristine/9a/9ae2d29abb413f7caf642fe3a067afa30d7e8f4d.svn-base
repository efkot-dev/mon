/*VOLKNO*/
.kabel .volokno {
    width: 14px;
    position: relative;
    display: block;
    background: #222;
    height: 14px;
    margin: 1px 2px;
    border-radius: 50%;
    border: 2px solid #fff0;
    z-index: 9999999;
}
.module {
    display: flex;
    flex-direction: row;
    flex-wrap: nowrap;
    align-items: center;
    justify-content: center;
    padding: 2px;
    margin: 2px 2px 0 2px;
    background: #ffffff63;
    border-radius: 10px;
    border: 2px solid #ffff;
    font-size: 13px;
}
.kabel .volokno:hover{
	border: 2px solid red;
	box-shadow: 0 1px 20px 0 rgb(69 90 100 / 8%);	
}
.kabel:hover{
	border: 2px solid rgb(61 166 236);
	cursor: pointer;
	transition: background 0.5s, border 0.5s, border-radius 0.5s, box-shadow 0.5s;
}
.kabel {
    position: relative;
    background-color: #9e9e9e57;
    box-sizing: border-box;
    display: flex;
    padding: 5px 15px;
    text-align: center;
    margin: 5px;
    height: 55px;
    border-radius: 15px;
    align-items: center;
    flex-wrap: nowrap;
    justify-content: flex-start;
    border: 2px solid #fff;
    box-shadow: 0 1px 20px 0 rgb(69 90 100 / 8%);
    flex-direction: column;
    font-size: 13px;
}
.editor {
    position: relative;
    width: auto;
    height: 1000px;
    display: flex;
    padding: 5px;
}
svg.leader-line {
	pointer-events: auto!important;
}

.leader-line:hover g > use:first-of-type {
	animation: blinker 1s linear infinite;
}

@keyframes blinker {
	50% {
		opacity: 0.5;
	}  
	100% {
		opacity: 1;
	}
}
@keyframes activevolokno {
	50% {
		border: 2px solid red; 
	}  
	100% {
		border: 2px solid #fff;
	}
}
.module .highlighted {
	border: 2px solid red;
	animation: activevolokno 1s linear infinite;
}
.kabel-name a img {
    position: relative;
    height: 11px;
    top: 1px;
    margin-left: 5px;
}
.kabel-name {
    color: rgb(3 3 3);
    background: #fff;
    padding: 1px 5px;
    font-size: 12px;
    line-height: 13px;
    border-radius: 3px;
    margin: 0 0 3px 0;
}
.kabel-module {
    display: flex;
    flex-direction: row;
    padding: 0;
    align-items: center;
    justify-content: center;
}
