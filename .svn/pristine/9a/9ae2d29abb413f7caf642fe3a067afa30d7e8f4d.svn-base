/*PAGINATOR*/
.navs {margin: 0px 0px 10px 0px;border-spacing: 0px;margin-top: 20px;display: inline-block;}
.navs .clear{background: #e6e6e6;border-left: 1px solid #fff;}
.navs span {
    line-height: 28px;
    border-left: 1px solid #fff;
    float: left;
    text-decoration: none;
    padding: 0 11px;
    height: 28px;
    border-radius: 3px;
    color: #425a83;
    font-size: 15px;
    background: #ffffff;
    box-shadow: 0 1px 20px 0 rgb(69 90 100 / 8%);
}
.navs a {
    margin: 0 2px;
    border-radius: 3px;
    line-height: 28px;
    float: left;
    text-decoration: none;
    padding: 0 11px;
    height: 28px;
    color: #cec9c9;
    box-shadow: 0 1px 20px 0 rgb(69 90 100 / 8%);
    font-size: 15px;
    background: #fff;
}
.navs a:hover{transition: background 0.5s, border 0.5s, border-radius 0.5s, box-shadow 0.5s;border-radius: 3px;background-color:#616d84;color:#fff;}
.navs a i {
    position: relative;
    top: 2px;
}
