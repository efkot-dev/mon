    padding: 9px 0px;
    z-index: 9999;
    white-space: nowrap;
    overflow: hidden;
}
.finish_task {
    writing-mode: vertical-rl;
    position: absolute;
    letter-spacing: 0px;
    font-size: 12px;
    background: #222;
    color: #ffffff;
    padding: 9px 0px;
    z-index: 9999;
    white-space: nowrap;
    overflow: hidden;
}
