}
.port-meta { margin-left:auto; display:flex; gap:10px; color:#555; font-size:12px; }
.tag { padding:2px 6px; border:1px solid #ddd; border-radius:10px; background:#fff; }
.btn-range { padding:6px 10px; border:1px solid #ddd; background:#fff; cursor:pointer; border-radius:8px; }
.btn-range.btn-active { background:#f0f6ff; border-color:#99c2ff; }
