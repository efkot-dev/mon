/*loadonu*/
.classh {
    display: flex;
    flex-direction: row;
    align-items: flex-end;
    justify-content: center;
    width: 100%;
    height: 115px;
    overflow: hidden;
}
.classh .load-onu-stats {
    height: 100%;
    display: flex;
    flex-direction: column-reverse;
    justify-content: space-between;
    align-items: center;
    margin-right: 0.5%;
}
.classh .load-onu-stats .sig {
    width: 100%;
    font-size: 10px;
    text-align: center;
    display: flex;
    height: 20px;
    background: #eee;
    border-radius: 3px;
    justify-content: center;
    align-items: center;
    flex-direction: column;
    border-top: 2px solid #fff;
}
.classh .load-onu-stats:hover .load-onu{
    background: #9bacb626;
    cursor: pointer;
}
#bdmain {
    background: #fff;
    border-bottom: 3px;
    padding: 20px 20px;
    width: 100%;
}
.mtop5 {

}
.classh .load-onu-stats:hover .count-sig {
    background: #5c84babd;
    color: #fff;
}
.classh .load-onu-stats .load-onu {
    height: 100px;
    display: flex;
    width: 100%;
    align-items: flex-end;
    background: #eeeeee1f;
}
.classh .load-onu-stats .load-onu .load-sig {
    width: 100%;
    display: flex;
    float: left;
    position: relative;
}
.classh .load-onu-stats .count-sig {
    width: 100%;
    font-size: 10px;
    text-align: center;
    display: flex;
    height: 20px;
    background: #eeeeee24;
    border-radius: 3px;
    justify-content: center;
    align-items: center;
    flex-direction: column;
}
.color_sig_1 {
    background: linear-gradient(358deg,#46ba39 10%,#7ce94c 100%);
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
}
.color_sig_2 {
    background: linear-gradient(358deg,#d62c0e 10%,#ff5d5d 100%);
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
}
.color_sig_3{
    background: linear-gradient(358deg,#d62c0e 10%,red 100%);
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
}
.color_sig_4 {
    background: linear-gradient(358deg,#0e7ad6 10%,#00ceff 100%);
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
}
.color_sig_5 {
    background: linear-gradient(358deg,#ff9e00 10%,#f6fc5b 100%);
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
}
.ajax-load-onu {
    padding: 5px;
    margin: 0px 0 15px;
    background: #ffffff;
    border-radius: 4px;
    overflow: auto;
    display: flex;
    width: 100%;
    flex-wrap: wrap;
    align-content: flex-start;
}
.optic-terminal:hover{
	border: 1px solid #5682a380;	
}
.onu-1{}
.onu-2{}
.ajax-load-onu .onu-2 .bdf img{opacity: 0.3;}
.ajax-load-onu .onu-2 .inface a {
    color: #5682a396;
}
.optic-terminal {
    cursor: pointer;
    display: flex;
    flex-direction: row;
    justify-content: flex-start;
    align-items: center;
    margin: 4px;
    padding: 2px 0;
    border: 1px solid #fff;
}
.optic-terminal .bdf img {
    width: 37px;
}
.optic-terminal .bdf {
    display: flex;
    flex-direction: column;
    justify-content: center;
    width: 48px;
    margin-right: 5px;
    align-items: center;
}
.optic-terminal .sgf {
    display: flex;
    flex-direction: column;
    line-height: 14px;
    font-size: 13px;
    justify-content: flex-start;
    align-items: flex-start;
}
.optic-terminal .inface a:hover{
	color:red;
}
.optic-terminal .inface a {
    color: #2aa1f8;
    font-weight: 600;
    font-size: 12px;
    text-decoration: underline;
}
.optic-terminal .mac_sn {
    font-size: 12px;
    color: #90a2ad;
}
