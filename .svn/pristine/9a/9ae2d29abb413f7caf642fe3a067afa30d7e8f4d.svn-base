    width: 100%;
    flex-wrap: wrap;
    margin-bottom: 5px;
}
.list-fiber-conn span:hover{
    color: tomato;	
}
.list-fiber-conn span {
    color: #0281d9;
    font-size: 14px;
    text-decoration: underline;
}
.npon b:hover{
    color: red;
}
.npon b {
    color: #0079b3;
    font-weight: 600;
    font-size: 15px;
    text-decoration: underline;
}
#description{
    background: #fff;
    border: 1px solid rgb(102 129 200 / 44%);
    color: #000;
    padding: 5px;
    font-size: 13px;
}
.list-fiber-conn a .del_fiber:hover{
    opacity: 1;	
}
.f .npon .edit_ponbox:hover{
    color: #222;	
}
.f .npon .del_ponbox:hover{
    color: red;		
}
.f .npon .del_ponbox {
    font-size: 13px;
    text-decoration: underline;
    font-style: italic;
    color: tomato;
    margin-right: 5px;
}
.f .npon .edit_ponbox {
    font-size: 13px;
    color: #5e738a87;
}
.npon .link_fiber {
    height: 10px;
    margin-left: 2px;
}
.list-fiber-conn a .del_fiber {
    height: 16px;
    opacity: 0.3;
    position: relative;
    top: -1px;
}
.overlay-view {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    font-size: 14px;
    color: white;
    background-color: rgba(0, 0, 0, 0.6);
    padding: 10px 30px;
    border-radius: 5px;
    opacity: 0;
    transition: opacity 0.3s ease-in-out;
    text-align: center;
    position: absolute;
}
.image-container:hover .overlay-view {
  opacity: 1;
  z-index: 20;
}
.image-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    justify-content: flex-start;
	margin-bottom: 10px;
}
.image-grid-view {
    display: flex;
    width: 100%;
    background: #eeeeee70;
    flex-direction: row;
    border-bottom: 4px solid #9ac3e1c9;
    justify-content: flex-start;
    align-items: flex-start;
    padding: 10px 10px;
    margin-bottom: 20px;
}
.image-grid-view .ponmap_note h2 {
    color: #222;
    border-bottom: 1px solid #68b3eb;
    width: 100%;
    margin: 0 0 0 10px;
    padding: 0 0 5px 5px;
    display: flex;
    font-size: 15px;
}
.ma_r10{}
.ma_r10 a {
    margin-right: 10px;
}
.ponman_added {
    background: #1e5397;
    color: #fff;
    font-size: 13px;
    display: inline-block;
    padding: 2px 7px 0 5px;
    margin-right: 10px;
    font-weight: 300;
}
.ponman_edit_url{}
.ponman_edit_url a{}
.image-grid-view .ponmap_photo {
    width: 25%;
}
.image-grid-view .ponmap_note{
	width: 74%;
}
.photo_note {
    display: inline-block;
    color: #222;
    background: #ffffff;
    margin: 10px 0 0 10px;
    padding: 2px 10px;
    width: 100%;
}
.image-grid-view .ponmap_photo img{
	width: 100%;
}
.image-container {
    position: relative;
    overflow: hidden;
    height: 170px;
    flex: 1 0 calc(25% - 10px);
    max-width: calc(25% - 10px);
    border-radius: 6px;
}
.image-container img {
  position: absolute;
  top: 0;
  left: 0;
  height: 100%;
  width: 100%;
  object-fit: cover;
  transition: transform 0.3s ease-in-out;
}
.image-container:hover img {
  transform: scale(1.2);
  z-index: 10;
}

.list-fiber-conn a {
    display: flex;
    flex-wrap: nowrap;
    flex-direction: row;
    justify-content: flex-start;
    align-items: center;
    font-size: 13px;
    margin-right: 4px;
}
.list-fiber-conn a img {
    height: 8px;
    margin-right: 1px;
}
.satellite_border_out {
    background: #fff;
    border-radius: 5px;
    padding: 5px;
}
.img_ponbox:hover{
    border: 1px solid red;	
}
.img_ponbox {
    display: flex;
    height: 38px;
    width: 38px;
    align-items: center;
    justify-content: center;
}
.satellite_border_out tr:nth-child(even) {
    background: #6bd0ff21;
}
.satellite_border_out tr:hover {
    background: #f1ffde;
}
.satellite_border_out td {
    padding: 5px;
}
#trafficport{
	width: 100%;
}
.snmptraffic {
    background: #fff;
    width: 100%;
    display: flex;
    box-shadow: 0 1px 20px 0 rgb(69 90 100 / 8%);
    flex-direction: row;
    justify-content: space-around;
    align-items: center;
    border-radius: 5px;
    margin-bottom: 20px;
}
.snmptraffic .block_in {
    padding: 10px 5px 5px 5px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    color: #222;
}
.reger-loader{
    background: #fff;
    padding: 1px 5px;
    color: #197cd3;
    text-decoration: underline;
    margin-right: 10px;
}
.snmptraffic .block_in .tr_name {
    background: -webkit-linear-gradient(top,#dff0d8 0,#d0e9c6 100%);
    padding: 0 5px;
    color: #0e610e;
    border-radius: 3px;
}
.snmptraffic .block_in .tr_traff {
    font-size: 17px;
    font-weight: 600;
    color: #527952;
}
.snmptraffic .block_out{
	padding: 5px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    color: #222;
}
.snmptraffic .block_out .tr_name {
    background: -webkit-linear-gradient(top,#d9edf7 0,#c4e3f3 100%);
    padding: 0 5px;
    color: #375f88;
    border-radius: 3px;
}
.snmptraffic .block_out .tr_traff {
    font-size: 17px;
    font-weight: 600;
    color: #5f8ab0;
}
.satellite_border_out th {
    text-align: left;
    background: #14649008;
    padding: 5px;
    color: #5c84ba;
    font-weight: 300;
    border-bottom: 3px solid #416d8629;
}
.mmain .p10 {
    padding: 15px 20px;
}
.nav-fiber {
    padding: 5px;
    background: #fff;
    border-radius: 2px;
    margin-bottom: 10px;
    box-shadow: 0px 5px 10px rgb(0 0 0 / 12%);
}
.nav-fiber a {
    color: #2b9ecc;
    text-decoration: underline;
    margin: 0 5px;
}
.tt_tree {
    background-size: 41px 39px;
    background-repeat: no-repeat;
    background-position: 4px -4px;
    padding: 0 0px 0 50px;
    background-image: url(../img/icon-telecom-room.svg);
}
.block_tree h2 a {
    font-weight: 300;
    color: #0f5374;
    letter-spacing: -0.4px;
}
.block_tree h2 a:hover{
    color: #ff1c70;
    text-decoration: underline;
}
.block_tree h2 {
    font-size: 14px;
    line-height: 15px;
    padding: 0px;
    background: #3576931f;
    padding: 2px 6px;
}
.block_tree .location_tree {
    width: 100%;
    display: flex;
    flex-wrap: wrap;
    margin-bottom: 20px;
    background: #fff;
    border-radius: 3px;
    box-shadow: rgb(0 0 0 / 9%) 0px 2px 14px;
}
.tt_tree {
    display: flex;
    flex-direction: column;
    width: 100%;
    align-items: flex-start;
}
body .noactve_pon{

}
.block_tree .location_tree .tree_pon a:hover{
   color: red;	
}
.block_tree .location_tree .tree_pon a {
    color: #026ebe;
    font-size: 13px;
    text-decoration: underline;
    font-weight: 300;
}
.block_tree .location_tree .tree_pon a:hover{
	color: #2586dd;	
}
.block_tree .location_tree .tree_pon:hover {
    background-color: #e7edf3;
    color: #0065c0;
    box-shadow: inset 2px 2px 7px rgba(154, 147, 140, 0.5), 1px 1px 5px rgba(255, 255, 255, 1);
}
.block_tree .location_tree .tree_pon {
    background-image: url(../img/icon-fiber-cabling.svg);
    transition: all 0.3s cubic-bezier(0.26, 0.46, 0.45, 0.95) 0s;
    background-size: 40px 40px;
    background-repeat: no-repeat;
    background-position: 0px 1px;
    border-radius: 3px;
    padding: 10px 10px;
    cursor: pointer;
    min-width: 200px;
    margin: 2px;
    display: flex;
    flex-direction: column;
    flex-wrap: nowrap;
    line-height: 14px;
    color: #22222269;
    align-items: flex-start;
    justify-content: flex-start;
    padding-left: 44px;
}
.panel-fiber {
	display: flex;
	width: 100%;
}
.panel-fiber .ld .pon-map h2 span {
	
}
.panel-fiber .ld .pon-map span {
