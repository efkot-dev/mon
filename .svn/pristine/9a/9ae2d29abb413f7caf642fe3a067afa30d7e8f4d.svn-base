    margin-right: 2px;
    margin-left: 3px;
}
.comment {
    background: #9fc5d917;
    padding: 4px 10px 7px 10px;
    color: #4ea2d7;
    border-left: 3px solid #70aee2;
}
#commenthistory p {
    background: #fff;
    border-bottom: 1px solid #b3cbe2;
