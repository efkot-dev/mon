    color: #222;
}
.statspon .descrport {
    font-size: 13px;
    font-weight: 300;
    color: #808080e6;
}
.statspon {
    display: block;
    width: 100%;
    float: left;
    border-bottom: 1px solid #eee;
    margin-bottom: 5px;
    padding: 0px;
}
.loadpon {
    background-color: rgb(194 204 219);
    margin-top: 2px;
    margin-bottom: 2px;
    border-radius: 3px;
}
.descrport-terminal img {
    height: 12px;
    position: relative;
    top: 1px;
    margin-left: 4px;
    margin-right: 2px;
}
.descrport-terminal {
    background: #dceafd;
    display: block;
    font-size: 15px;
    padding: 5px;
    font-weight: 300;
    color: #0a547f;
    margin: 4px 0;
    border-radius: 5px;
}
.loadpon .load0, .loadli .load0{
	background-color: #73c9e8;
}
.loadpon .load1, .loadli .load1{
	background-color: #6ecd6e;
}
.loadpon .full, .loadli .full{
	background-color: red;
    opacity: 0.6;
}
.loadpon .load2, .loadli .load2 {
    background: linear-gradient(45deg,#06970c 10%,#9fd105 100%);
    opacity: 0.7;
}
.loadpon .load3, .loadli .load3 {
    background: linear-gradient(45deg,#429676 10%,#15c73d 100%);
    opacity: 0.7;
}
.loadpon .load4, .loadli .load4 {
    background-color: #23bb48;
}
.loadpon .load5, .loadli .load5 {
    background: linear-gradient(45deg,#e95020 10%,tomato 100%);
    opacity: 0.8;
	animation: blinker 1s linear infinite;
}
.loadpon .load {
    height: 8px;
    transition: all 0.3s cubic-bezier(0.26, 0.46, 0.45, 0.95) 0s;
    max-width: 100%;
}

