}
#location .location {
    float: left;
    -webkit-box-sizing: border-box;
    box-sizing: border-box;
    padding: 0px 10px 10px 0px;
}
/*page:location*/
/*page:unit*/
#unit{
    display: block;
    float: left;
    width: 100%;
}
#unit .box .classunit:hover .story-user__name {
	color:#456cc4;
}
#unit .box .classunit:hover {
    border: 1px solid #7091bd;
    background: #fff;
}
#unit .box .classunit {
    padding: 10px;
    line-height: 16px;
    background: #ffffff40;
    border: 1px solid #eee0;
    transition: all 0.3s cubic-bezier(0.26, 0.46, 0.45, 0.95) 0s;
    border-radius: 3px;
    min-width: 100px;
    text-align: center;
}
#unit .sub-content i {
    position: relative;
    top: 1px;
}
#unit .sub-content {
    color: #a7a9ac;
	font-size: 13px;
}
#unit .box {
    float: left;
    -webkit-box-sizing: border-box;
    box-sizing: border-box;
    padding: 10px;
}
/*page:unit*/
/*page:pondog*/
.block-center .pondog {
    display: flex;
    flex-direction: row;
    flex-wrap: nowrap;
    align-content: center;
    justify-content: flex-start;
    align-items: center;
    padding: 3px;
    color: grey;
}
.pondog .status {
    margin: 0 10px 0 0;
}
.pondog .cron_no span {
    border-radius: 2px;
    text-align: center;
    color: #ffff;
    background: #46da46;
    padding: 1px 4px;
}
.pondog .place {
    color: #222;
    margin-right: 10px;
}
.pondog .model {
    color: #222;
    margin-right: 10px;
    background: #8080801a;
    padding: 0 5px;
}
.pondog .priority {
    background: #7171ad;
    margin-right: 10px;
    color: #fff;
    padding: 0 5px;
}
.pondog .added {
    color: #ee670e;
    margin-right: 10px;
}
.pondog .interval {
    background: #ffe7e7ba;
    color: red;
    margin-right: 10px;
    padding: 0 5px;
}
.pondog .btnkey span {
    font-weight: 500;
    color: #107ccf;
    font-size: 14px;
    margin-left: 5px;
	cursor:pointer;
    border-bottom: 1px dashed #107ccf;
}
.pondog .btnkey span:hover{
    color: red;
    border-bottom: 1px dashed red;
}
/*page:pondog*/
/*page:olt:panel,photo*/
.moder-panel {
    /* background-color: #fff; */
    display: flex;
    width: 100%;
    flex-wrap: wrap;
    align-content: center;
    justify-content: flex-start;
    align-items: center;
    padding: 7px 0;
    /* border-radius: 5px; */
    margin-bottom: 0;
    margin-top: 5px;
}

.moder-panel a:hover {
    border: 1px solid #4fb5ec;
    background: #fff;
    color: #2996d1;
}
.moder-panel img {
    height: 17px;
    position: relative;
    vertical-align: middle;
    margin-right: 7px;
    top: -1px;
}
.moder-panel a {
    background-color: #fff;
    transition: background 0.5s, border 0.5s, border-radius 0.5s, box-shadow 0.5s;
    font-weight: 600;
    padding: 4px 10px;
    margin: 0 7px 0 0px;
    font-size: 13px;
    color: #526d9ecc;
    border-radius: 3px;
    border: 1px solid #fff;
}
.gallery{
	display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 10px;
    grid-template-rows: auto;
    padding-top: 5px;
    user-select: none;
    margin-bottom: 10px;
}
.gallery .photo:hover {
    opacity: 1;
}
.gallery .photo {
    display: block;
    transition: background 0.5s, border 0.5s, border-radius 0.5s, box-shadow 0.5s;
    cursor: pointer;
    padding: 5px;
    border-radius: 5px;
}
.gallery .photo .img {
    height: 200px;
    overflow: hidden;
    border: 1px solid #fff0;
    box-shadow: rgb(0 0 0 / 10%) 0px 4px 3px;
    border-radius: 2px;
}
.gallery .photo .img img:hover{
	transform: scale(1.1); /* Збільшення картинки на 10% */
    transition: transform 0.3s ease-in-out; /* Плавний перехід */
}
.timed img {
    position: relative;
    top: 2px;
    height: 13px;
    margin-right: 6px;
}
.timed_block {
    position: absolute;
    display: flex;
    flex-direction: column;
    flex-wrap: nowrap;
    justify-content: flex-start;
    z-index: 99999;
    align-items: flex-start;
    align-content: flex-start;
}
.timed {
    background: #fff;
    font-size: 12px;
    color: #222;
    padding: 0 10px;
    line-height: 17px;
}
.btn_style_im:hover{
	border:1px solid red;
	box-shadow: rgb(0 0 0 / 10%) 0px 4px 3px;
}
.btn_style_im_added span {
    color: #fff;
    font-size: 12px;
    border-radius: 3px;
    margin-left: 10px;
    background: #0371c5;
    line-height: 16px;
    padding: 0 5px;
}
.btn_style_im_added{
	border:1px solid #fff;
	transition: transform 0.3s ease-in-out; /* Плавний перехід */
    margin: 5px 5px 0 5px;
    background: #fff;
    padding: 2px 5px 2px 5px;
    display: flex;
	cursor:pointer;
    justify-content: center;
    align-items: center;
    border-radius: 3px;	
}
.btn_style_im{
	border:1px solid #fff;
	transition: transform 0.3s ease-in-out; /* Плавний перехід */
    margin: 5px 5px 0 5px;
    background: #fff;
    padding: 4px 5px;
    display: flex;
	cursor:pointer;
    justify-content: center;
    align-items: center;
    border-radius: 3px;
}
.gallery .photo .img img {
    width: 100%;
}
.gallery .photo .name h2 {
    font-size: 13px;
    line-height: 16px;
    font-weight: 300;
    color: #626367;
}
.gallery .photo .name .date {
    background-color: #5176ad;
    color: #fff;
    display: inline;
    padding: 2px 5px;
    position: absolute;
    font-size: 12px;
    margin-top: -41px;
    margin-left: -3px;
}
.gallery .photo .name {
    background: #ffffff70;
    display: block;
    width: 100%;
    padding: 3px 4px;
    font-size: 13px;
    height: 40px;
    color: #495057;
    margin: 5px 0 0px 0;
    overflow: hidden;
}
.viewphoto {
    display: flex;
    flex-direction: column;
    align-content: center;
    justify-content: flex-start;
    align-items: flex-start;
    flex-wrap: nowrap;
}
.viewphoto .img{width: 60%;}
.viewphoto .img .i {
    width: 100%;
    height: 400px;
    overflow: hidden;
}
.viewphoto .img .i img{ width: 100%;}
.viewphoto .name .date {
    background: #5775a8;
    color: #fff;
    display: inline-block;
    padding: 5px 10px;
    margin: 0 0 5px 0;
}
.viewphoto .name .descr {
    font-size: 12px;
    color: #6a6a6a;
    padding: 4px;
}
.viewphoto .name h2 a{
    font-size: 13px;
    color: #73a3e4;
}
.viewphoto .name h2 a:hover{
    font-size: 13px;
    color: tomato;
}
.viewphoto .name h2 {
    color: #404040;
    font-weight: 300;
    font-size: 16px;
    padding: 4px;
    border-bottom: 1px solid #3e58b245;
    margin-bottom: 5px;
}
.viewphoto .name {
    width: 40%;
    line-height: 15px;
    padding: 5px 10px;
    font-size: 14px;
}
/*page:olt:panel,photo*/
/*page:olt:list,block?online*/
.listcheck {
    display: block;
    width: 100%;
    font-size: 13px;
}
.listcheck span b {
    margin: 0 5px;
    color: #222;
    border-bottom: 1px dashed #030303d1;
}
.listcheck span img {
    vertical-align: sub;
    margin-right: 5px;
}
.listcheck span {
    display: block;
    padding: 0;
}
.onu-offline{
    padding-top: 5px;
    width: 100%;
    font-weight: 300;
    font-size: 14px;
    line-height: 1.1;
    color: rgb(30, 30, 32);
    padding-right: 5px;
    transition: all 0.3s cubic-bezier(0.26, 0.46, 0.45, 0.95) 0s;
    transform: translateZ(0px);
    backface-visibility: hidden;
}
.listcheck .onu-offline h2{
	color: #7d90a2;
    font-size: 13px;
    font-weight: 300;
}
.onu-offline .onu-bar{
	background-color: rgb(233, 233, 233);
    border-radius: 4px;
    margin-top: 4px;
}
.onu-offline .onu-load{
	background-color: #a6bcca;
	border-radius: 3px;
    height: 7px;
    transition: all 0.3s cubic-bezier(0.26, 0.46, 0.45, 0.95) 0s;
    max-width: 100%;
}

.onu-online{
    padding-top: 5px;
    width: 100%;
    font-weight: 300;
    font-size: 14px;
    line-height: 1.1;
    color: rgb(30, 30, 32);
    padding-right: 5px;
    transition: all 0.3s cubic-bezier(0.26, 0.46, 0.45, 0.95) 0s;
    transform: translateZ(0px);
    backface-visibility: hidden;
}
.listcheck .onu-online h2{
	color: #7d90a2;
    font-size: 13px;
    font-weight: 300;
}
.onu-online .onu-bar{
	background-color: rgb(233, 233, 233);
    border-radius: 4px;
    margin-top: 4px;
}
.onu-online .onu-load{
	background-color: #6ecd6e;
	border-radius: 3px;
    height: 7px;
    transition: all 0.3s cubic-bezier(0.26, 0.46, 0.45, 0.95) 0s;
    max-width: 100%;
}
