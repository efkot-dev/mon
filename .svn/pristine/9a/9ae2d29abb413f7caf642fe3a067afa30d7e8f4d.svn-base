		padding: 2px 2px;
		font-size: 9px;
	}
	.mmain .name_inface_count {
		width: 20px;
	}
}
@media screen and (max-width: 480px) {
	.tpl_type_olt .tpl_type_list_p .dip{
	    grid-template-columns: repeat(2, 1fr);
	}
}
.tpl_type_olt .tpl_type_list_p .dip {
    display: grid;
    gap: 5px;
    grid-template-rows: auto;
    user-select: none;
    margin-bottom: 5px;
    width: 100%;
}
