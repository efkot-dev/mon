/*--page:unit,css:fiber--*/
.fiber:hover{ 
	background: #eeeeee3d;
}
.fiber {
	transition: all 0.3s cubic-bezier(0.26, 0.46, 0.45, 0.95) 0s;
    cursor: pointer;
    display: flex;
    flex-direction: row;
    flex-wrap: nowrap;
    align-content: space-around;
    justify-content: flex-start;
    align-items: flex-start;
    margin: 3px 0;
    border-radius: 3px;
    padding: 3px;
}
.fiber .type_first .ml{
	height: 10px;
    margin-right: 3px;
    opacity: 0.7;	
}
.fiber .type_first {
    color: #67a8f4;
    font-size: 14px;
    padding: 1px 5px;
}
.fiber .type_first {
    margin-right: 10px;
}
.fiber .type_panel {
    margin-left: 3%;
}
.fiber .type_end .ml{
	height: 10px;
    margin-right: 3px;
    opacity: 0.7;	
}
.fiber .type_end {
    color: #67a8f4;
    font-size: 14px;
    padding: 1px 5px;
}
.fiber .type_panel span:hover{
	color:tomato;
}
.fiber .type_panel span {
    line-height: 14px;
    color: #1198d1;
    text-decoration: underline;
    font-style: italic;
    font-size: 13px;
    margin: 0 0px 0 5px;
}
.fiber .color_fiber {
    display: block;
    font-size: 12px;
    width: 60px;
    text-align: center;
    margin-right: 10px;
    position: relative;
    line-height: 13px;
    top: 5px;
    border-radius: 3px;
}
.fiber .type_fiber {
    color: #28c5cf;
	margin-right: 5px;
}
.fiber .type_metr {
    color: grey;
	margin-right: 5px;
}
/*--page:unit,css:fiber--*/
/*--page:unit,css:device--*/
.vyzolpanel {
    display: flex;
    flex-direction: column;
    flex-wrap: nowrap;
    align-content: flex-start;
    justify-content: center;
    align-items: flex-start;
    padding: 0 10px;
}
.vyzolpanel .key-vyzol {
    display: flex;
    flex-direction: row;
    flex-wrap: nowrap;
    align-content: center;
    justify-content: flex-start;
    align-items: center;
    margin: 5px 0;
	    color: #859ac4;
    transition: all 0.3s cubic-bezier(0.26, 0.46, 0.45, 0.95) 0s;
    cursor: pointer;
}
