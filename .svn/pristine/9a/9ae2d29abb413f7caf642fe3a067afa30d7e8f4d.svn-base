.curentmap span {
	animation: blinkeronu 1s linear infinite;
	z-index:999;
}
@keyframes blinkeronu {
  50% {
    box-shadow: 0 3px 12px 1px rgb(108 249 25 / 87%);
    border: 1px solid #fff;
  }  
  30% {
    box-shadow: 0 3px 12px 1px rgb(108 249 25 / 87%);
    border: 1px solid red;
  }
}
