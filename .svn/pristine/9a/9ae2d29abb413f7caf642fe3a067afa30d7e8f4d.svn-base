/*block_signal_onu_right*/
.signal-box {
    background: #fff;
    border-radius: 8px;
    padding: 7px;
    width: 100%;
    margin: 0 0 18px 0;
}
.signal-row {
    display: grid;
    grid-template-columns: 100px 100px 1fr;
    padding: 5px;
    border-bottom: 1px solid #eee;
    font-size: 13px;
    transition: background 0.2s;
}
.signal-row:hover { background: #f0f8ff; }
.signal-header {
    font-weight: bold;
    background: #f1f1f1;
    border-bottom: 1px solid #ddd;
}
.rx-onu { color: #1f77b4; font-weight: 600; text-align:center; }
.rx-olt { color: #d9534f; font-weight: 600; text-align:center; }
.signal-row .time { font-family: monospace; text-align:left; }
.empty { text-align:center; color:#888; padding:15px; }
#pagination { margin-top: 10px; text-align:center; }
.page-btn {
    border:1px solid #ccc;
    background:#fff;
    padding:5px 10px;
    margin:2px;
    border-radius:4px;
    cursor:pointer;
    font-size:12px;
}
.page-btn.active { background:#1f77b4; color:#fff; border-color:#1f77b4; }
.page-btn:hover { background:#e9eef6; }
/*block_signal_onu_right*/
/*ON|OFF*/
.td-access {
	text-align: center;
}
.btn-access {
    display: inline-block;
    min-width: 36px;
    padding: 1px 10px;
    border-radius: 4px;
    font-size: 10px;
    font-weight: bold;
    text-decoration: none;
    color: #fff;
}
.btn-access.on {
	background: #2ecc71;
}
.btn-access.off {
	background: #e74c3c;
}
.btn-access:hover {
	opacity: 0.8;
}
