    box-shadow: 0 1px 20px 0 rgb(69 90 100 / 8%);
}
#form_result_page {
    background: #fff;
    width: 100%;
    margin: 10px 0 0 0;
}
.onu_model {
    border: 1px solid #5780ac;
    line-height: 14px;
    font-size: 13px;
    margin-left: 5px;
}
.onu_model span {
    background: #5780ac;
    color: #fff;
    padding: 0px 3px;
    font-size: 13px;
}
.search-block {
    background-color: #ffffff;
    box-shadow: 0 1px 20px 0 rgb(69 90 100 / 8%);
    color: #fff;
    padding: 5px;
    margin-top: 10px;
    box-shadow: rgb(0 0 0 / 0%) 0px 2px 14px;
    border-radius: 3px;
}
.search-page .search-block .item-search {
    clear: both;
    color: #fff;
    font-size: 0;
    min-height: 55px;
    line-height: 20px;
    position: relative;
    padding: 0px 5px 5px;
    text-transform: uppercase;
}
.search-page .search-block .item-search.block-select {
    display: flex;
    width: 100%;
}
.search-page .search-block .item-search, .search-page .search-block .item-search .full {

}
.search-page .search-block .item-search .block {
    max-width: 250px;
    min-width: 150px;
    margin-right: 10px;
}
.search-block .item-search h3 {
    color: #93a7d3;
    font-size: 11px;
    font-weight: 300;
    line-height: 14px;
    padding: 0 0px 0 2px;
    margin-top: 8px;
    text-transform: uppercase;
}
.filter-random .search-block .item-search .block .sort.open, .search-page .search-block .item-search .block .sort.open {
    background-color: #f4f6fa61;
    border-color: #eaeaea #eaeaea transparent;
}
.search-page .search-block .item-search .block .sort {
    height: 29px;
    padding: 2px 10px;
    cursor: pointer;
    margin-top: 6px;
    line-height: 16px;
    position: relative;
    min-width: 150px;
    max-width: 250px;
    border-radius: 2px;
    background-color: #fff;
}
.search-page .search-block .item-search .block .sort span {
    color: #8f95a3;
    padding: 0 5px;
    font-size: 12px;
    text-align: left;
    font-weight: 700;
    text-transform: initial;
}
.items-search{}
.search-page .search-block .item-search .block .sort .sort-items {
    top: 35px;
    left: 0;
    z-index: 22;
    display: none;
    cursor: pointer;
    position: absolute;
    padding-bottom: 10px;
    background-color: #f4f6fa;
    border-left: 1px solid #eaeaea;
    border-right: 1px solid #eaeaea;
    border-bottom: 1px solid #eaeaea;
}
.search-page .search-block .item-search .block .sort.icon-arowDown:after {
    color: #8f95a3;
    font-size: 6px;
}
.search-page .search-block .item-search .block .sort .sort-items .sort-item {
    width: 238px;
}
.search-page .search-block input.search {
    width: 100%;
    height: 29px;
    color: #4574e1;
    cursor: inherit;
    position: relative;
    border-radius: 2px;
    padding: 0 10px 0 40px;
    font-size: 14px;
    margin: 5px 0 0px;
    -webkit-appearance: textfield;
    text-rendering: optimizelegibility;
    background: url(../../style/img/search.svg) #fff no-repeat 11px center;
    background-size: 13px;
    border: 1px solid #88c8eb82;
}
.input-search {
    width: 100%;
    position: relative;
    display: inline-block;
    padding: 0 6px;
}
.search-footer {
    clear: both;
    height: 51px;
    display: flex;
    position: relative;
    padding: 0 0px 0px 6px;
}
.items-search input {
    position: relative;
    top: 2px;	
}
.items-search {
    position: relative;
    font-size: 15px;
    line-height: 13px;
    display: block;
    margin: 14px 0 0 35px;
    height: 16px;
}
.icon-chekR {
    color: #7379ce;
    font-size: 13px;
}
.search-footer .go {
    width: 110px;
    padding: 5px 7px;
    transition: .3s;
    border: 0;
    color: #7379ce;
    height: 28px;
    font-size: 12px;
    cursor: pointer;
    margin: 10px 0 0;
    font-weight: 600;
    line-height: 15px;
    text-align: center;
    border-radius: 2px;
    text-transform: uppercase;
    background-color: #ffffff;
    box-shadow: 0 0 1px 3px #7b819000;
}
.search-page {
    width: 100%;
}
