/*MODULE*/
/*LOAD CSS*/
#pmon_load {
    display: block;
    z-index: 999999999;
    position: fixed;
    text-align: center;
    top: 0;
    width: 100%;
    height: 100%;
    left: 0;
    right: 0;
    border-radius: 3px;
    background: #80aed72e;
    margin: 0 auto;
    flex-direction: row;
    justify-content: center;
    align-items: center;
}
.loader {
    width: 50px;
    display: block;
    margin: auto;
    top: 40%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: #000;
    box-shadow: 0 0 0 0 #0004;
    animation: l2 1.5s infinite linear;
    position: relative;
}
.loader:before,
.loader:after {
  content: "";
  position: absolute;
  inset: 0;
  border-radius: inherit;
  box-shadow: 0 0 0 0 #0004;
  animation: inherit;
  animation-delay: -0.5s;
}
.loader:after {
  animation-delay: -1s;
}
@keyframes l2 {
    100% {box-shadow: 0 0 0 40px #0000}
}


@keyframes l28 {
  10% {color: #050505;}
  50% {color: red;}
  100% {transform: rotate(1turn)}
}
/*LOAD CSS*/
/*SLIDE MENU*/
.side-menu {
    position: fixed;
    left: -400px;
    top: 0px;
    width: 400px;
    height: 100%;
    background-color: #ffffff;
    color: #fff;
    display: block;
    overflow-y: auto;
    z-index: 9999999999;
    transition: left 0.3s ease;
    padding: 0px 10px 0 10px;
	box-shadow: 0 0.46875rem 2.1875rem rgba(4, 9, 20, 0.03), 0 0.9375rem 1.40625rem rgba(4, 9, 20, 0.03), 0 0.25rem 0.53125rem rgba(4, 9, 20, 0.05), 0 0.125rem 0.1875rem rgba(4, 9, 20, 0.03);
}
.side-menu.open {
	left: 0;
}
.menu-trigger i {
    position: relative;
    top: 3px;
}
.content .right{
	left: 400px;	
}
.menu-trigger {
    position: fixed;
    top: 54px;
    left: 0px;
    width: 26px;
    height: 27px;
    background-color: red;
    color: #fff;
    display: flex;
	transition: left 0.3s ease;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 99999999;
}
.menu-trigger:hover {
    background-color: #0056b3;
}
