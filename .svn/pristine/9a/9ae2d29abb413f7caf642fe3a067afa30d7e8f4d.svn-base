    font-size: 12px;
    color: #3f98e1;
    text-decoration: underline;
}
.historycomm img {
    vertical-align: sub;
    margin: 0 3px 0 10px;
}
.editcommimg img {
    vertical-align: sub;
    margin: 0 3px 0 0px;
}
.olt-count{
    background: #328ed6;
    font-size: 12px;
    position: absolute;
    height: 15px;
    padding: 1px 4px 2px 4px;
    color: #fff;
    border-radius: 3px;
    margin: 0px 5px 0 5px;
}
.olt-onu-off {
	background: #d55844;
    font-size: 12px;
    position: absolute;
    height: 15px;
    padding: 1px 4px 2px 4px;
    color: #fff;
    border-radius: 3px;
    margin: 0px 5px 0 5px;
}

.bad-olt-count{
    background: tomato;
    font-size: 12px;
    position: absolute;
    height: 14px;
    padding: 1px 4px 2px 4px;
    color: #fff;
    border-radius: 3px;
    margin: 0px 5px 0 5px;
}
.style_pon .pon-onu {
    max-width: 36px;
    position: relative;
