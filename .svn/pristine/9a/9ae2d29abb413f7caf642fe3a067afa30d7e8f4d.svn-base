    flex-wrap: wrap;
    align-content: flex-start;
    justify-content: flex-start;
    align-items: flex-start;
}
.statusoffline {
    display: inline-block;
    width: 11px;
    background: tomato;
    position: relative;
    height: 11px;
    margin-right: 4px;
    border-radius: 3px;
    top: 1px;
}
.statusonline {
    display: inline-block;
    width: 11px;
    background: #19db19;
    position: relative;
    height: 11px;
    margin-right: 4px;
    border-radius: 3px;
    top: 1px;
}
.get-ponbox-list-ont .inface {
    font-weight: 600;
    color: #5d83c6;
}
.get-ponbox-list-ont .sernum {
    color: #418ea5;
    text-decoration: underline;
	padding: 2px;
}
.get-ponbox-list-ont .ont-ponbox-one .im .statusoffline {
    position: absolute;
    height: 10px;
    width: 10px;
    background: tomato;
    border-radius: 3px;
}
.get-ponbox-list-ont .ont-ponbox-one .im {
    width: 40px;
    margin-right: 5px;
}
.get-ponbox-list-ont .ont-ponbox-one .im .img-onu{ width: 35px;}
.get-ponbox-list-ont .ont-ponbox-one .nm {
    font-size: 13px;
    line-height: 13px;
}
.get-ponbox-list-ont .ont-ponbox-one .nm div{}
.view-ponbox-list-ont {
    display: flex;
    width: 100%;
    padding: 10px 10px;
    border: 1px solid #eee;
    margin: 5px 0;
    border-radius: 4px;
    flex-wrap: wrap;
    align-content: center;
    justify-content: flex-start;
    align-items: flex-start;
}
.view-ponbox-list-ont .block-ont:hover{
	background: #cbdaf01a;
}
.view-ponbox-list-ont .block-ont {
    transition: all 0.3s cubic-bezier(0.26, 0.46, 0.45, 0.95) 0s;
    width: 19%;
    cursor: pointer;
    padding: 5px;
    height: 40px;
    margin: 5px;
    font-size: 12px;
    display: flex;
    flex-direction: row;
    flex-wrap: nowrap;
    align-content: center;
    justify-content: flex-start;
    align-items: center;
    border-radius: 3px;
    border: 1px solid #fff;
}
.view-ponbox-list-ont .block-ont .ofl{
    background: tomato;
    color: #fff;
    padding: 0 3px;
	font-size: 10px;
    line-height: 13px;
}
.block_onus {
    display: flex;
    flex-direction: column;
    flex-wrap: nowrap;
    justify-content: flex-start;
    align-items: flex-start;
}
.block_onus .bl_online {
    color: #55de55;
    margin: 3px 0 1px 0;
    line-height: 13px;
    font-size: 11px;
}
.block_onus .bl_online .nm{
	background: #29c129;
	border-top: 1px solid #29c129;
	border-bottom: 1px solid #29c129;
    color: #fff;
	padding: 0 4px;
}
.block_onus .bl_online .cout {
    padding: 0 4px;
	border: 1px solid #55de55;
    color: #3dc63b;
}
.view-ponbox-list-ont .block-ont .srnum {
    border: 1px solid #36629852;
    color: #366298;
    border-radius: 3px;
    display: inline-block;
    padding: 2px 5px;
    margin: 2px 0 0 0;
}
.block_onus .bl_offline {
    color: tomato;
    margin: 3px 0;
    line-height: 13px;
    font-size: 11px;
}
.block_onus .bl_offline .nm{
	background: tomato;
	border-top: 1px solid tomato;
	border-bottom: 1px solid tomato;
    color: #fff;
	padding: 0 4px;
}
.block_onus .bl_offline .cout {
    padding: 0 4px;
	border: 1px solid tomato;
    color: red;
}
.view-ponbox-list-ont .block-ont .srnum {
    border: 1px solid #36629852;
    color: #366298;
    border-radius: 3px;
    display: inline-block;
    padding: 2px 5px;
    margin: 2px 0 0 0;
}
.view-ponbox-list-ont .block-ont .l {
    margin-right: 5px;
}
.view-ponbox-list-ont .block-ont .l img {
    width: 35px;
}
.view-ponbox-list-ont .block-ont .b-add .mdu-curent {
    display: inline-block;
    background: #006d80b5;
    color: #fff;
    padding: 1px 4px;
    line-height: 13px;
    border-radius: 2px;
}
.view-ponbox-list-ont-close {
    line-height: 13px;
    font-size: 13px;
    padding: 0 5px 5px 0;
}
.ont-block-bookmarks {
    display: flex;
    justify-content: flex-start;
    flex-wrap: nowrap;
    width: 100%;
    align-items: center;
}
a.addstikers:hover{
background: linear-gradient(90deg,#0f74a7,#1c7395)!important;
}
a.addstikers {
    background: linear-gradient(90deg,#46b4eb,#1595c7)!important;
    color: #fff!important;
    padding: 0px 10px;
    border-radius: 5px;
    height: 30px;
    line-height: 30px;
    font-size: 15px;
    letter-spacing: -0.4px;
}
a.delstikers:hover{
    background: tomato;	
}
.block-center .stikers .status {
    background-size: 19px 19px;
    background-repeat: no-repeat;
    width: 70px;
    background-position-y: 5px;
    background-position-x: 3px;
    background-image: url(../img/star.png);
}
a.delstikers{
    background: linear-gradient(90deg,#ff512a,#ff1974)!important;
    color: #fff!important;
    padding: 0px 10px;
    border-radius: 5px;
    height: 30px;
    line-height: 30px;
    font-size: 15px;
    letter-spacing: -0.4px;
}
.ont-block-bookmarks span{
	color: #3096e7;
    text-decoration: underline;
	margin: 0 5px;
}
.ont-block-bookmarks time{
	color: #222;
    text-decoration: underline;
	margin: 0 5px;
}

.ont-block-bookmarks img{
    height: 30px;
    margin-right: 5px;
}
.view-ponbox-list-ont-close a:hover{
    color: #222;	
	opacity: 1;
}
.view-ponbox-list-ont-close a {
    color: red;
    opacity: 0.7;
}
.view-ponbox-list-ont-close a img {
    vertical-align: sub;
    margin-right: 5px;
    margin-left: 10px;
}
.view-ponbox-list-ont .block-ont .b-add {
    line-height: 12px;
}
.view-ponbox-list-ont .block-ont a:hover{
	color:red;
}
.view-ponbox-list-ont .block-ont a {
    color: #73819b;
}
.view-ponbox-list-ont .block-ont .b-add .lis b {
    margin-right: 3px;
    color: #599bd6;
}
