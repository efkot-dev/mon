	}
	.mmain .polka .block-monitor-olt {
		width: 100%;
		padding: 0;
	}
	.mmain .polka {
		display: flex;
		flex-direction: column;
		flex-wrap: nowrap;
	}
	.mmain .tpl_type_olt .tpl_type_pon .typepon span {
		font-size: 10px;
		padding: 1px 3px;
		margin-bottom: 15px;
	}
	.mmain .name_inface .ont_new {
		font-size: 8px;
		padding: 0px 1px;
		margin-left: 5px;
		top: -1px;
	}
	.mmain .name_inface_sub {
		margin-left: 5px;
	}
	.mmain .name_inface{
		font-size: 10px;
		line-height: 10px;
	}
