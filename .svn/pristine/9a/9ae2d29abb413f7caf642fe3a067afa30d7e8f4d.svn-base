/*MOBILE*/
#contentspeed {
    height: 80px;
    box-shadow: 0 1px 20px 0 rgb(69 90 100 / 8%);
    width: 100%;
    padding: 0px;
    background: #fff;
    border-radius: 3px;
    margin-top: 20px;
    margin-bottom: 7px;
}
.flex1 {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    flex-wrap: nowrap;
    height: 40px;
}
.editcommimg:hover{
	color: red;
}
.editcommimg {
    font-size: 12px;
    color: #3f98e1;
    text-decoration: underline;
}
.historycomm:hover{
	color: red;
}
