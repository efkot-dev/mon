    padding: 8px 12px;
    text-align: left;
    font-size: 13px;
}
.wrap .mmain .text_center {
    text-align: center;
}
#board_fault td {
    padding: 5px;
    border-bottom: 1px solid #ddd;
    font-size: 13px;
}
    #board_fault tr:nth-child(even) { background-color: #f9f9f9; }
    #board_fault tr:nth-child(odd)  { background-color: #fff; }
    #board_fault tr:hover {
        background-color: #e3f2fd;
        transition: 0.2s;
        cursor: pointer;
    }
    .status_open {
        background: #e53935;
        color: #fff;
