.cal-table{width:100%; border-collapse:separate; border-spacing:4px; table-layout:fixed}
.cal-table thead th{font-size:12px; color:#555; font-weight:600; text-align:center; padding:4px 0}
.cal-table td{vertical-align:top}
.cal-td{position:relative; border:1px solid #e6e6e6; border-radius:5px; background:#fff; cursor:pointer; height:38px; text-align:left; padding:4px 6px}
.cal-td:hover{box-shadow:0 0 0 2px rgba(0,0,0,.05) inset}
.cal-td .d {
    font-weight: 600;
    font-size: 12px;
    color: #5682a3;
    line-height: 1;
}
.cal-td .m{font-size:10px; color:#888}
.cal-td.muted{opacity:.4; cursor:default}
.cal-td.hasdata{border-color:#b7e1c1; box-shadow:0 0 0 1px #b7e1c1 inset}
.cal-td.today{outline:2px solid #5aa6ff; outline-offset:0}
.cal-td.active{box-shadow:0 0 0 2px #007ab6 inset}
.cal-legend{display:flex; gap:12px; margin-top:8px; font-size:12px; color:#666}
.cal-legend .b{display:inline-block; width:10px; height:10px; border-radius:3px; margin-right:4px; vertical-align:middle}
.cal-legend .b1{background:#b7e1c1}
.cal-legend .b2{background:#5aa6ff}
.traffic-panel a.active{pointer-events:none; opacity:.7; text-decoration:underline}
.axis--x text{font-size:10px}
