/*MENU*/
.nav-pmon nav {
    height: 54px;
}
.nav-pmon nav ul {
	list-style-type: none;
	margin: 0;
	padding: 0;
	display: flex;
	justify-content: space-between;
	align-items: center;
}
.nav-pmon nav ul li {
    margin: 0 5px;
    line-height: 54px;
    font-size: 13px;
}
.nav-pmon nav ul li a {
	color: #fff;
	text-decoration: none;
	padding: 10px;
}
.nav-pmon nav ul li:hover {
    background-color: #1c4b6e;
}
.nav-pmon nav ul li.dropdown:hover .dropdown-menu {
    display: block;
    z-index: 999;
    box-shadow: 0 1px 10px 0 #9bacb673;
}
.nav-pmon .dropdown-menu {
	display: none;
	position: absolute;
	background-color: #fff;
	z-index: 1;
}
.nav-pmon .dropdown-menu li {
    display: block;
    line-height: 34px;
    font-size: 13px;
    margin: 0;
    min-width: 210px;
    padding: 0 10px;
}
.dr-menu a i{
	position: relative;
    margin-right: 10px;
    top: 2px;
}
.nav-pmon .dropdown-menu li a {
	color: #333;
	text-decoration: none;
}
.nav-pmon .dropdown-menu li:hover {
	background-color: #f2f2f2;
}
