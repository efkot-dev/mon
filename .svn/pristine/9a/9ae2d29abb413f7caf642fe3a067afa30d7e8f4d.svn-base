/*PONELEMNT*/
.list-ponbox {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-start;
    align-items: flex-start;
    width: 100%;
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}
.url-fiber {
    flex: 1 1 150px;
    max-width: 150px;
    font-size: 13px;
    line-height: 14px;
    padding: 5px;
    margin: 0;
    border: 1px solid #fff;
    box-sizing: border-box;
}

/* Медіа-запити для адаптивності */
@media (max-width: 1200px) {
    .url-fiber {
        flex: 1 1 130px; /* Мінімальна ширина 180px */
    }
}

@media (max-width: 992px) {
    .url-fiber {
        flex: 1 1 100px; /* Мінімальна ширина 150px */
    }
}

@media (max-width: 768px) {
    .url-fiber {
        flex: 1 1 100px; /* Мінімальна ширина 120px */
    }
}

@media (max-width: 1000px) {
    .url-fiber {
        flex: 1 1 100px;
    }
	.mmain #ont #ajaxsignal .block_dbm{
		grid-template-columns: repeat(3, 1fr);
		gap: 2px;
		display: grid;
		padding: 0px 10px 10px 10px;
		margin: 0;
	}
	.mmain #usercard {
		color: #212529;
		background-color: #f8f9fa;
		padding: 0px;
		border-radius: 8px;
	}
}
