    color: #fff;
    font-size: 19px;
    position: relative;
    top: 4px;
    text-shadow: 1px 1px 10px #360303;
}
.css-warning .txt {
    display: flex;
    justify-content: flex-start;
    align-items: center;
    flex-direction: row;
    flex-wrap: nowrap;
    color: #101010;
    padding: 0 12px;
    line-height: 16px;
    font-weight: 600;
}
