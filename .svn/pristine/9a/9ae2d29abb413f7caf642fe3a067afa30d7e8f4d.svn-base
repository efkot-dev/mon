/*SKLAD TRANSFER*/
.transfer-grid{width:100%;display:grid;grid-template-columns: 1fr 1fr;gap:18px}
.table{width:100%;border-collapse:collapse}
.table th,.table td{border-bottom:1px solid #eee;padding:8px 10px;vertical-align:middle}
.table tbody tr:hover{background:#fafafa}
.btn_outline{border:1px solid #ccc;background:#fff;padding:8px 14px;border-radius:6px}
.qty-input{width:100%}
.badge{display:inline-block;padding:2px 8px;border-radius:10px;background:#f1f1f1}
.action-link{cursor:pointer;text-decoration:underline}
.w100{width:100%}
.ml-auto{margin-left:auto}
/*SKLAD TRANSFER*/
.flex_niz{
    display: flex;
    flex-direction: column;
    width: 100%;
    justify-content: flex-start;
    align-items: flex-start;
}
.min_desc_gpon span img {
    height: 13px;
    width: 13px;
    position: relative;
    vertical-align: bottom;
    margin-right: 3px;
}
.min_desc_gpon span {
    font-size: 11px;
	cursor:pointer;
    text-decoration: underline;
    padding: 0 5px 3px 0px;
    color: #808080b0;
}
.weather-hourly .hour-block {
  min-width: 42px;
  text-align: center;
  padding: 2px 0px;
  position: relative;
  cursor: default;
  background: #bdc7d5;
}
.weather-hourly .hour-block:last-child {
	border-right: none;
}
.weather-hourly .hour-block .temp span {
  font-size: 12px;
  background: #fff;
  color: #222;
  border-radius: 4px;
}
.weather-hourly .hour-block .temp img {
  height: 40px;
  width: 40px;
}
.weather-hourly .hour-block .temp {
    font-size: 13px;
    margin-bottom: 4px;
}
.weather-hourly .hour-block .time {
    font-size: 12px;
    border-radius: 3px;
    margin-bottom: 4px;
    background: #eee;
    color: #222;
}
.weather-hourly .hour-block .tooltip {
	visibility: hidden;
	background-color: rgba(0,0,0,0.75);
	color: #fff;
	text-align: center;
	border-radius: 4px;
	padding: 5px 7px;
	position: absolute;
	bottom: 80px;
	left: 50%;
	transform: translateX(-50%);
	width: 120px;
	font-size: 12px;
	pointer-events: none;
	opacity: 0;
	transition: opacity 0.3s;
	z-index: 10;
}
.weather-hourly .hour-block:hover .tooltip {
	visibility: visible;
	opacity: 1;
}
.mmain .pogoda_current {
    border: 1px solid red;
    background: #fff;
}
.pogoda_soon {
    background: #fff;
}
.pogoda_finis:hover{
    border: 1px solid red;
}
.pogoda_finis {
	border: 1px solid transparent;
	cursor:pointer;
    color: #636e72;
}
