.pre80{width: 79.8%;}
.pre30{width: 29.8%;}
.pre50{width: 49.8%;}
.pre40{width: 39.8%;}
.pre60{width: 59.8%;}
.pre70{width: 69.8%;}
#board_fault {
width: 100%;
border-collapse: collapse;
border-radius: 6px;
overflow: hidden;
}
#board_fault th {
    background-color: #006698;
