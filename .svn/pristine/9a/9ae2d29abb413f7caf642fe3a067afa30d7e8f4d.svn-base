/*regonu*/
.copir {
  animation: blinkerlogo 1s linear infinite;
  display: inline-block;
}
@keyframes blinkerlogo {
  50% {
    opacity: 0;
	color: #5f7d95;
  }
}
.monitor-port-ajax .monitor-port-name p {
    font-size: 13px;
    line-height: 13px;
    font-weight: 300;
    color: #98a6c1;
    padding: 0;
    margin: 0;
}
.cssload-squares{
	display:block;
	width: 193px;
    position: fixed;
    z-index: 99999999;
    top: 30%;
    left: 40%;
}
	
.cssload-squares, .cssload-squares * {
	box-sizing: border-box;
		-o-box-sizing: border-box;
		-ms-box-sizing: border-box;
		-webkit-box-sizing: border-box;
		-moz-box-sizing: border-box;
}

.cssload-squares span {
    display: inline-block;
    height: 26px;
    width: 26px;
    background: rgb(59 128 181);
    border-radius: 0px;
    border: 1px solid #fff;
    box-shadow: 0 1px 20px 0 rgb(69 90 100 / 19%);
    margin-right: 4px;
}

.cssload-squares span:nth-child(1) {
	animation: rotateY 4.6s 0.35s infinite cubic-bezier(0.65, 0.03, 0.735, 0.045);
		-o-animation: rotateY 4.6s 0.35s infinite cubic-bezier(0.65, 0.03, 0.735, 0.045);
		-ms-animation: rotateY 4.6s 0.35s infinite cubic-bezier(0.65, 0.03, 0.735, 0.045);
		-webkit-animation: rotateY 4.6s 0.35s infinite cubic-bezier(0.65, 0.03, 0.735, 0.045);
		-moz-animation: rotateY 4.6s 0.35s infinite cubic-bezier(0.65, 0.03, 0.735, 0.045);
}
.cssload-squares span:nth-child(2) {
	animation: rotateY 4.6s 0.69s infinite cubic-bezier(0.65, 0.03, 0.735, 0.045);
		-o-animation: rotateY 4.6s 0.69s infinite cubic-bezier(0.65, 0.03, 0.735, 0.045);
		-ms-animation: rotateY 4.6s 0.69s infinite cubic-bezier(0.65, 0.03, 0.735, 0.045);
		-webkit-animation: rotateY 4.6s 0.69s infinite cubic-bezier(0.65, 0.03, 0.735, 0.045);
		-moz-animation: rotateY 4.6s 0.69s infinite cubic-bezier(0.65, 0.03, 0.735, 0.045);
}
.cssload-squares span:nth-child(3) {
	animation: rotateY 4.6s 1.04s infinite cubic-bezier(0.65, 0.03, 0.735, 0.045);
		-o-animation: rotateY 4.6s 1.04s infinite cubic-bezier(0.65, 0.03, 0.735, 0.045);
		-ms-animation: rotateY 4.6s 1.04s infinite cubic-bezier(0.65, 0.03, 0.735, 0.045);
		-webkit-animation: rotateY 4.6s 1.04s infinite cubic-bezier(0.65, 0.03, 0.735, 0.045);
		-moz-animation: rotateY 4.6s 1.04s infinite cubic-bezier(0.65, 0.03, 0.735, 0.045);
}
.cssload-squares span:nth-child(4) {
	animation: rotateY 4.6s 1.38s infinite cubic-bezier(0.65, 0.03, 0.735, 0.045);
		-o-animation: rotateY 4.6s 1.38s infinite cubic-bezier(0.65, 0.03, 0.735, 0.045);
		-ms-animation: rotateY 4.6s 1.38s infinite cubic-bezier(0.65, 0.03, 0.735, 0.045);
		-webkit-animation: rotateY 4.6s 1.38s infinite cubic-bezier(0.65, 0.03, 0.735, 0.045);
		-moz-animation: rotateY 4.6s 1.38s infinite cubic-bezier(0.65, 0.03, 0.735, 0.045);
}
.cssload-squares span:nth-child(5) {
	animation: rotateY 4.6s 1.73s infinite cubic-bezier(0.65, 0.03, 0.735, 0.045);
		-o-animation: rotateY 4.6s 1.73s infinite cubic-bezier(0.65, 0.03, 0.735, 0.045);
		-ms-animation: rotateY 4.6s 1.73s infinite cubic-bezier(0.65, 0.03, 0.735, 0.045);
		-webkit-animation: rotateY 4.6s 1.73s infinite cubic-bezier(0.65, 0.03, 0.735, 0.045);
		-moz-animation: rotateY 4.6s 1.73s infinite cubic-bezier(0.65, 0.03, 0.735, 0.045);
}



@keyframes rotateY {
	0% {
		transform: rotateY(0deg);
	}
	50% {
		transform: rotateY(90deg);
		background: rgb(147,225,215);
	}
	100% {
		transform: rotateY(0deg);
	}
}

@-o-keyframes rotateY {
	0% {
		-o-transform: rotateY(0deg);
	}
	50% {
		-o-transform: rotateY(90deg);
		background: rgb(147,225,215);
	}
	100% {
		-o-transform: rotateY(0deg);
	}
}

@-ms-keyframes rotateY {
	0% {
		-ms-transform: rotateY(0deg);
	}
	50% {
		-ms-transform: rotateY(90deg);
		background: rgb(147,225,215);
	}
	100% {
		-ms-transform: rotateY(0deg);
	}
}

@-webkit-keyframes rotateY {
	0% {
		-webkit-transform: rotateY(0deg);
	}
	50% {
		-webkit-transform: rotateY(90deg);
		background: rgb(147,225,215);
	}
	100% {
		-webkit-transform: rotateY(0deg);
	}
}

@-moz-keyframes rotateY {
	0% {
		-moz-transform: rotateY(0deg);
	}
	50% {
		-moz-transform: rotateY(90deg);
		background: rgb(147,225,215);
	}
	100% {
		-moz-transform: rotateY(0deg);
	}
}
