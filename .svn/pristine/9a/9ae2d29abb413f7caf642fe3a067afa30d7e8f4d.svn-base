/*VIKNO-MY*/
#popup {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.5);
    justify-content: center;
    align-items: center;
    z-index: 999999;
}
#popup-box {
    width: 80%;
    max-height: 80%;
    background: white;
    padding: 10px;
    border-radius: 8px;
    overflow-y: hidden;
    position: relative;
}
#popup-close {
    position: absolute;
    top: 8px;
    right: 10px;
    background: none;
    border: none;
    font-size: 18px;
    cursor: pointer;
}
#popup-content {
    max-height: 70vh;
    overflow-y: auto;
    overflow-x: hidden;
}
