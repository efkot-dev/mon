/*logo-pmon*/
.nav-pmon .pmon-logo .title {
    font-size: 1.3rem;
    line-height: 1.5rem;
    color: #fff;
}
.nav-pmon .pmon-logo .subtitle {
    font-size: .75rem;
    line-height: .625rem;
    color: #fff;
}
.nav-pmon .pmon-logo:after {

}
.nav-pmon .pmon-logo:after {

}
.nav-pmon .pmon-logo:before {
    position: absolute;
    content: "";
    width: 33px;
    height: 33px;
    left: -40px;
}
.nav-pmon .pmon-logo:before {
    background-size: 33px 33px;
    top: -2px;
    background-image: url(../../style/logo_pmon.png);
}
.nav-pmon .pmon-logo {
    position: relative;
    display: -webkit-inline-box;
    display: -ms-inline-flexbox;
    display: inline-flex;
    flex-direction: column;
    justify-content: space-between;
    height: 29px;
    margin-left: 60px;
    padding-left: 10px;
    cursor: pointer;
    top: -2px;
    margin-right: 50px;
}
.nav-pmon {
    width: 100%;
    height: 54px;
    display: flex;
    background-image: url(../img/headimg.png);
    background-position: center center;
    background-color: #00699d;
    flex-wrap: nowrap;
    align-items: center;
    position: relative;
    z-index: 100003;
    box-shadow: 0 0.46875rem 2.1875rem rgba(4, 9, 20, 0.03), 0 0.9375rem 1.40625rem rgba(4, 9, 20, 0.03), 0 0.25rem 0.53125rem rgba(4, 9, 20, 0.05), 0 0.125rem 0.1875rem rgba(4, 9, 20, 0.03);
}
