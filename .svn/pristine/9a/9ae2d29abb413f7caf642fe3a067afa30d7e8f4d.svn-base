/*huawei time down list*/
.list_key_spoiler {
    display: inline-block;
    position: relative;
    padding: 0 30px 0 0;
    cursor: pointer;
    float: right;
    color: grey;
    font-weight: 500;
}
.list_key_spoiler:hover:before{
	opatic:0.8;
}
.list_key_spoiler:before{
    position: absolute;
    content: '';
    right: 0;
    top: 0;
    width: 20px;
    height: 100%;
    background: url(../img/down.png) no-repeat center center;
    cursor: pointer;
    transition: .2s;
    transition-timing-function: ease-in-out;
}
.list_key_spoiler .open:before{
    transform: rotate(180deg);
}
.block_body{
	font-size: 16px;
    padding: 10px;
    box-sizing: border-box;
    display: none;
}
.block_all h2 {
    font-size: 14px;
    color: #2e83bd;
    width: 100%;
    font-weight: 500;
    display: flex;
    margin: 0;
    padding: 5px 10px;
    justify-content: space-between;
    align-items: center;
    align-content: center;
    flex-wrap: nowrap;
}
.block_all:hover h2 b{
	color: #8ca688;
}
.block_all:hover{
	border: 2px solid #fff;	
	box-shadow: 0 1px 20px 0 rgb(69 90 100 / 8%);
}
.block_all {
    transition: background 0.5s, border 0.5s, border-radius 0.5s, box-shadow 0.5s;
    display: flex;
    width: 100%;
    padding: 0;
    font-size: 14px;
    margin: 5px 0px 10px 0px;
    border: 2px solid #e6ebf2;
    flex-direction: column;
    flex-wrap: nowrap;
	cursor:pointer;
    align-items: flex-start;
    align-content: flex-start;
}
.list_time{
	display: block;
    width: 100%;
    float: left;
}
.list_time .down_time {
    display: inline-block;
    padding: 0 20px 0px 0;
    font-size: 13px;
