/*--page:unit,css:inf--*/
.fixed-add-ponbox .addmdujs:hover{
	opacity: 1;
}
.fixed-add-ponbox .addmdujs {
    transition: all 0.3s cubic-bezier(0.26, 0.46, 0.45, 0.95) 0s;
    width: 93px;
    cursor: pointer;
    margin: 3px;
    opacity: 0.8;
    font-size: 12px;
    line-height: 13px;
    display: flex;
    flex-direction: row;
    flex-wrap: nowrap;
    align-content: center;
    justify-content: flex-start;
    align-items: center;
}
.fixed-add-ponbox .addmdujs img{width: 35px;}
.fixed-add-ponbox .addmdujs b{}
.mmain .connect-list-head h2 {
    color: #0c7bd3;
    font-size: 13px;
    padding: 5px 19px 8px 5px;
    display: inline-block;
    font-weight: 300;
    border-bottom: 3px solid #0c7bd3;
    display: initial;
}
.mmain .details_ponbox .connect-list-head {
    border-bottom: 2px solid #c5c5c5b3;
    margin-bottom: 10px;
    padding: 5px 0px;
}
.ponbox_details h2 {
    color: #005ca0;
    text-decoration: underline;
    font-size: 15px;
    line-height: 15px;
    margin-bottom: 3px;
    padding: 3px;
}
.ponbox_panel {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    text-align: center;
}
.ponbox_panel a.edit:hover{
	background-color: #02c902;
	color: #222;
}
.ponbox_panel a.edit {
    background-color: #82daa75c;
    color: #06800b;
	cursor: pointer;
}
.ponbox_panel a.foto:hover{
	background-color: #0059b0;
	color:#fff;
}
#load_data {
    width: 100%;
}
.usr_billing{
    width: 100%;
    background: #fff;
    border-radius: 5px;
    padding: 5px;
}
.ponbox_panel a.foto {
    background-color: #a6dcfd5c;
    color: #0059b0;
    cursor: pointer;
}
.ponbox_panel a.usr:hover{
    background-color: orange;
    color: #222;	
}
.ponbox_panel a.usr {
    background-color: #ffd64d5c;
    color: #222;
    cursor: pointer;
}
.ponbox_panel a.delet:hover{
    background-color: red;
    color: #fff;	
}
.ponbox_panel a.delet {
    background-color: #ff63471c;
    color: red;
	cursor:pointer;
}
.ponbox_panel a {
    padding: 0px 5px 1px 5px;
    font-size: 14px;
    margin-bottom: 5px;
    border-radius: 3px;
}
.details_ponbox {
    background: #f6f6f6;
    border-radius: 3px;
    padding: 1px 10px 1px 10px;
    margin-block: 10px;
}
.fixed-add-ponbox{
    width: 300px;
    display: flex;
    flex-wrap: wrap;
    align-content: flex-start;
    justify-content: flex-start;
    align-items: flex-start;
}
.inf_display {
    display: block;
    width: 100%;
    padding: 10px 10px;
    background: linear-gradient(45deg,#f8fafb 10%,#eaf5ff3b 100%);
    color: #5a6698;
    border-radius: 3px;
    margin-bottom: 5px;
}
.mappanel:hover{

}
.mappanel .nomap {
    display: inline-block;
    background: #1384ea;
    line-height: 15px;
    color: #fff;
    font-size: 13px;
    padding: 1px 4px;
    border-radius: 3px;
}
.mappanel {
    transition: background 0.5s, border 0.5s, border-radius 0.5s, box-shadow 0.5s;
    position: absolute;
    z-index: 999;
    background: #ffffff5e;
    top: 5px;
    margin: 0px 0px 0 -10px;
    padding: 8px 10px 0px 10px;
    border-radius: 3px;
}
.inf_display i {
    margin-right: 10px;
    position: relative;
    opacity: 0.5;
    top: 2px;
}
/*--page:unit,css:inf--*/
.zvit-unit {
    padding: 10px;
}
.zvit-unit h2 {
    font-size: 14px;
    line-height: 14px;
    border-bottom: 1px solid #eee;
    display: flex;
    flex-direction: row;
    flex-wrap: nowrap;
    justify-content: flex-start;
    align-items: center;
    padding: 5px;
}
.zvit-unit h2 img {
    height: 22px;
    margin-right: 6px;
}
.list-spliter {
    display: flex;
    flex-wrap: wrap;
    align-content: center;
    justify-content: flex-start;
    align-items: flex-start;
}
.list-spliter .fiber-spliter:hover{
    background: #adc3d812;
    border-radius: 6px;
}
.list-spliter .fiber-spliter {
	transition: all 0.3s cubic-bezier(0.26, 0.46, 0.45, 0.95) 0s;
    width: 9%;
    display: flex;
    flex-direction: column;
    flex-wrap: nowrap;
    align-content: center;
    justify-content: flex-start;
    align-items: center;
    height: 90px;
	cursor:pointer;
}
.list-spliter .fiber-spliter .img .spliter{
    height: 65px;
    padding: 5px;	
}
.list-spliter .fiber-spliter .img {
    width: 100%;
    text-align: center;
    height: 60px;
}
.list-spliter .fiber-spliter a {
    font-size: 12px;
    font-weight: 600;
    line-height: 13px;
    text-align: center;	
}
.list-spliter .fiber-spliter span {
    font-size: 12px;
    font-weight: 300;
    line-height: 13px;
    text-align: center;
}
.fiber-spliter .del-icon:hover{
    opacity: 1;	
}
.fiber-spliter .del-icon {
    position: absolute;
    transition: all 0.3s cubic-bezier(0.26, 0.46, 0.45, 0.95) 0s;
    display: block;
    opacity: 0.5;
    float: right;
    margin: 5px;
    cursor: pointer;
}
.list-tree-object {
    display: flex;
    flex-wrap: wrap;
    align-content: flex-start;
    justify-content: flex-start;
    align-items: flex-start;
}
.list-tree-object .pon-tree-object {
    width: 16%;
    display: flex;
    flex-direction: row;
    flex-wrap: nowrap;
    justify-content: flex-start;
    align-items: center;
    margin-bottom: 5px;
}
.list-tree-object .img-tree-object{margin-right: 5px;width: 50px;}
.list-tree-object .img-tree-object img{width: 50px;}
.list-tree-object .name-tree-object {
    font-size: 13px;
    line-height: 13px;
}
.list-tree-object .name-tree-object a:hover{color: tomato;}
.list-tree-object .name-tree-object a {
    color: #5983b3;
    font-weight: 600;
	transition: all 0.3s cubic-bezier(0.26, 0.46, 0.45, 0.95) 0s;
}
.btn-tree {
	margin-bottom: 20px;
    margin-top: 10px;
}
.btn-tree span:hover b{
    display: inline-block;
	transition: all 1s cubic-bezier(0.26, 0.46, 0.45, 0.95) 0s;
}
.btn-tree span:hover{
    background: #fff;
    color: #578acb;
}
.btn-tree span b {
    font-weight: 300;
    margin: 0 0 0 10px;
    display: none;
}
.btn-tree span {
    transition: all 0.3s cubic-bezier(0.26, 0.46, 0.45, 0.95) 0s;
    background: #ffffffde;
    color: #727bba;
    padding: 7px 12px;
    cursor: pointer;
    margin-right: 5px;
    border-radius: 2px;
}
.btn-tree a:hover b{
    display: inline-block;
	transition: all 1s cubic-bezier(0.26, 0.46, 0.45, 0.95) 0s;
}
.btn-tree a:hover{
    background: #fff;
    color: #578acb;
}
.btn-tree a b {
    font-weight: 300;
    margin: 0 0 0 10px;
    display: none;
}
.btn-tree a i {
    position: relative;
    top: 3px;
}
.btn-tree span i {
    position: relative;
    top: 3px;
}
.btn-tree a {
    transition: all 0.3s cubic-bezier(0.26, 0.46, 0.45, 0.95) 0s;
    background: #ffffffde;
    color: #727bba;
    padding: 7px 12px;
    cursor: pointer;
    margin-right: 5px;
    border-radius: 2px;
}
.list-pon-tree {
    display: flex;
    flex-wrap: wrap;
    align-content: flex-start;
    justify-content: flex-start;
    align-items: flex-start;
    width: auto;
    padding: 5px 0 0 0;
    margin: 5px;
    background: #fff;
    border-radius: 4px;
}
.pon-tree:hover{
    border: 0px solid #b8dfe8;
    border-radius: 3px;	
}
.pon-tree {
    width: 20%;
    display: flex;
    flex-direction: row;
    flex-wrap: nowrap;
    padding: 4px;
    align-content: center;
    justify-content: flex-start;
    align-items: center;
    margin: 0px 0px 3px 0px;
    border: 0px solid #fff;
    overflow: hidden;
}
.pon-tree .name-tree {
    margin-left: 5px;
    display: flex;
    flex-direction: column;
    flex-wrap: nowrap;
    align-content: flex-start;
    justify-content: center;
    align-items: flex-start;
    padding: 3px 0;
}
.pon-tree .img-tree {
    height: 41px;
    width: 41px;
    overflow: hidden;
}
.pon-tree .img-tree img {
    height: 37px;
    opacity: 0.8;
}
.pon-tree .name-tree .sub-port-tree b {
    background: #369add;
    color: #fff;
    font-size: 11px;
    font-weight: 300;
    padding: 1px 3px;
    opacity: 0.8;
}
.pon-tree .name-tree .sub-port-tree {
    line-height: 13px;
    font-size: 13px;
    margin-top: 2px;
}
.pon-tree .name-tree .sub-port-sub-port-inf {
    line-height: 14px;
    font-size: 13px;
    margin-top: 2px;
    color: #22222259;
}
.pon-tree .name-tree a:hover{
    color: red;	
}
.pon-tree .name-tree a {
    color: #5274ad;
}
.pon-tree .name-tree h2 {
    font-size: 14px;
    line-height: 14px;
}
.pon-tree .name-tree span{}
.pon-tree:hover{}
.tree_port {
    font-size: 14px;
    line-height: 15px;
    margin-bottom: 13px;
    padding: 0 5px 10px 5px;
    border-bottom: 1px solid #eeeeee7a;
}
.tree_port h1 .netip{
    background: #5b8ec6;
    color: #fff;
    padding: 0 5px;
    margin: 0 3px 0 0px;
    font-size: 13px;
    position: relative;
    display: inline-block;
    top: -2px;
}
.tree_port h1 {
    color: #398cea;
    font-size: 16px;
    font-weight: 300;
    margin-bottom: 5px;
}
.tree_port h1 .port_status_up {
    display: inline-block;
    font-size: 13px;
    padding: 2px 4px;
    line-height: 13px;
    color: #58e058;
}
.tree_port h1 .port_status_down {
    display: inline-block;
    font-size: 13px;
    padding: 2px 4px;
    line-height: 13px;
    color: tomato;
}
.tree_port .sub_inf_port {
    font-size: 13px;
}
.tree_port .sub_inf_port b {
    margin: 0 5px 0 0px;
    color: #808080cc;
    font-weight: 300;
}
.tree_port .sub_inf_port time {
    margin: 0 5px 0 0px;
    padding: 1px 3px 0 3px;
    display: inline-block;
    line-height: 14px;
    color: #1198d1;
    text-decoration: underline;
    font-style: italic;
}
