CREATE TABLE `billing_usr` (
  `id` int(11) unsigned NOT NULL AUTO_INCREMENT,
  `uid` int(11) DEFAULT NULL,
  `dogovir` int(11) DEFAULT NULL,
  `platijniy` int(11) DEFAULT NULL,
  `status` int(11) DEFAULT NULL,
  `ip` int(11) DEFAULT NULL,
  `org` text DEFAULT NULL,
  `pib` text DEFAULT NULL,
  `mobile` text DEFAULT NULL,
  `city` text DEFAULT NULL,
  `street` text DEFAULT NULL,
  `houser` text DEFAULT NULL,
  `nomer` text DEFAULT NULL,
  `subnomer` text DEFAULT NULL,
  `locationid` int(11) DEFAULT NULL,
  `onuid` int(11) DEFAULT NULL,
  `onumac` text DEFAULT NULL,
  `deviceid` int(11) DEFAULT NULL,
  `portidid` int(11) DEFAULT NULL,
  `device_type` text DEFAULT NULL,
  `added` datetime DEFAULT NULL,
  PRIMARY KEY (`id`),
  KEY `idx_onuid` (`onuid`), 
  KEY `idx_onumac` (`onumac`(255))
) ENGINE=InnoDB DEFAULT CHARSET=utf8 COLLATE=utf8_general_ci;

ALTER TABLE `monitor_temp`
ADD `lan` varchar(60) COLLATE 'utf8_general_ci' NULL AFTER `energy`,
ADD `lon` varchar(60) COLLATE 'utf8_general_ci' NULL AFTER `lan`;



