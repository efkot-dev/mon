							$sql= "UPDATE ponmap_connect SET `in1` = 'left' WHERE id = '{$row['id']}'";
							$db->query($sql);
						}						
						if($row['in1']=='left'){
							$sql= "UPDATE ponmap_connect SET `in1` = 'right' WHERE id = '{$row['id']}'";
