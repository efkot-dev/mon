<div class="block-monitor"><div class="block-head"><h2>[lang:apibilling_setup]</h2></div><div class="block-center"><div id="billing">
<div class="block-setup">
<form action="/?do=send" method="post">
<input name="act" type="hidden" value="savebilling">
<div class="pole1">
<div class="form1">[lang:apibilling_status]<b>[lang:apibilling_statusdescr]</b></div>
<div class="form2">{selstbill}</div>
</div>		
<div class="pole1">
<div class="form1">[lang:apibilling_type]<b>[lang:apibilling_typedescr]</b></div>
<div class="form2">{selbill}</div>
</div>		
<div class="pole1">
<div class="form1">[lang:apibilling_urlapi]<b>[lang:apibilling_urlapidescr]</b></div>
<div class="form2"><input required="" name="billingurl" class="input1" type="text" value="{billingurl}"></div>
</div>		
<div class="pole1">
<div class="form1">[lang:apibilling_keyapi]<b>[lang:apibilling_keyapidescr]</b></div>
<div class="form2"><input required="" name="billingapikey" class="input1" type="text" value="{billingapikey}"></div>
</div>
<div class="navigation mbottom20 mtop10px"><button type="submit" class="button" value="submit">[lang:save]</button></div>
</form>
</div>
<div class="block-connect-list">
<div class="pole1">
<div class="form1">[lang:apibilling_alluid]<b>[lang:apibilling_alluiddescr]</b></div>
<div class="form2">{countuid}</div>
</div>	
</div>
</div></div></div>
