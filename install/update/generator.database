CREATE TABLE IF NOT EXISTS generators (
  id INT AUTO_INCREMENT PRIMARY KEY,
  name VARCHAR(150) NOT NULL,
  fuel_type ENUM('diesel','gasoline','gas') NOT NULL,
  power INT NOT NULL,
  fuel_consumption DECIMAL(6,2) NOT NULL,
  added_at DATETIME DEFAULT CURRENT_TIMESTAMP
);
CREATE TABLE IF NOT EXISTS fuel_stock (
  id INT AUTO_INCREMENT PRIMARY KEY,
  fuel_type ENUM('diesel','gasoline','gas') NOT NULL,
  quantity DECIMAL(10,2) NOT NULL DEFAULT 0,
  added_at DATETIME DEFAULT CURRENT_TIMESTAMP
);
CREATE TABLE IF NOT EXISTS generator_runs (
  id INT AUTO_INCREMENT PRIMARY KEY,
  generator_id INT NOT NULL,
  fuel_id INT DEFAULT NULL,
  location VARCHAR(255),
  start_at DATETIME NOT NULL,
  end_at DATETIME DEFAULT NULL,
  hours_run DECIMAL(7,2) DEFAULT 0,
  fuel_used DECIMAL(10,2) DEFAULT 0,
  FOREIGN KEY (generator_id) REFERENCES generators(id) ON DELETE CASCADE,
  FOREIGN KEY (fuel_id) REFERENCES fuel_stock(id) ON DELETE SET NULL
);
CREATE TABLE IF NOT EXISTS fuel_history (
  id INT AUTO_INCREMENT PRIMARY KEY,
  fuel_id INT NOT NULL,
  quantity DECIMAL(10,2) NOT NULL,
  action ENUM('added','used') NOT NULL,
  related_run INT DEFAULT NULL,
  created_at DATETIME DEFAULT CURRENT_TIMESTAMP,
  FOREIGN KEY (fuel_id) REFERENCES fuel_stock(id) ON DELETE CASCADE,
  FOREIGN KEY (related_run) REFERENCES generator_runs(id) ON DELETE SET NULL
);
CREATE TABLE fuel_recalc_log (
    id INT AUTO_INCREMENT PRIMARY KEY,
    created_at DATETIME DEFAULT CURRENT_TIMESTAMP,
    note VARCHAR(255)
);
ALTER TABLE generators CONVERT TO CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
ALTER TABLE fuel_stock CONVERT TO CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
ALTER TABLE generator_runs CONVERT TO CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
ALTER TABLE fuel_history CONVERT TO CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
ALTER TABLE generator_runs ADD fuel_rate_at_run DECIMAL(10,2) NULL;
