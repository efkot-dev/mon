ALTER TABLE `switch_port_err`
  ADD COLUMN `outerror` BIGINT UNSIGNED NOT NULL DEFAULT 0 AFTER `inerror`,
  ADD COLUMN `newout`   BIGINT UNSIGNED NOT NULL DEFAULT 0 AFTER `newin`;
CREATE INDEX idx_spe_dev_llid_added ON switch_port_err (deviceid, llid, added);
CREATE INDEX idx_spe_added          ON switch_port_err (added);
CREATE TABLE IF NOT EXISTS switch_port_err_daily (
  deviceid  INT NOT NULL,
  llid      INT NOT NULL,
  day       DATE NOT NULL,
  sum_newin  BIGINT UNSIGNED NOT NULL,
  sum_newout BIGINT UNSIGNED NOT NULL,
  PRIMARY KEY (deviceid, llid, day)
) ENGINE=InnoDB;
