CREATE TABLE `alarm_ping3_history` (
  `id` INT NOT NULL AUTO_INCREMENT,
  `alarm_id` INT NOT NULL,
  `old_status` INT NOT NULL,
  `new_status` INT NOT NULL,
  `event_time` DATETIME NOT NULL,
  `note` VARCHAR(255),
  PRIMARY KEY (`id`),
  KEY `alarm_id` (`alarm_id`),
  KEY `event_time` (`event_time`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;
CREATE TABLE `alarm_ping3` (
  `id` INT NOT NULL AUTO_INCREMENT,
  `name` VARCHAR(255) NOT NULL,
  `netip` VARCHAR(255) NOT NULL,
  `snmpro` VARCHAR(255) NOT NULL,
  `status` INT NOT NULL DEFAULT 2,
  `monitor` ENUM('yes','no') NOT NULL DEFAULT 'no',
  PRIMARY KEY (`id`),
  UNIQUE KEY `netip` (`netip`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;
