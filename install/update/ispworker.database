CREATE TABLE ispworker_marker_types (
  id INT AUTO_INCREMENT PRIMARY KEY,
  code VARCHAR(32) UNIQUE,
  title VARCHAR(64) NOT NULL,
  icon VARCHAR(64) NOT NULL
);
CREATE TABLE ispworker_markers (
  id BIGINT AUTO_INCREMENT PRIMARY KEY,
  userid INT NOT NULL,
  title VARCHAR(128) NOT NULL,
  descr TEXT,
  type_id INT NOT NULL,
  lat DECIMAL(10,6) NOT NULL,
  lon DECIMAL(10,6) NOT NULL,
  notify TINYINT(1) NOT NULL DEFAULT 0,
  created_at DATETIME NOT NULL,
  updated_at DATETIME NULL,
  INDEX idx_lat_lon (lat, lon),
  CONSTRAINT fk_type_id FOREIGN KEY (type_id) REFERENCES ispworker_marker_types(id)
) ENGINE=InnoDB;
CREATE TABLE ispworker_marker_photos (
  id BIGINT AUTO_INCREMENT PRIMARY KEY,
  marker_id BIGINT NOT NULL,
  path VARCHAR(255) NOT NULL,
  created_at DATETIME NOT NULL,
  UNIQUE KEY uniq_marker (marker_id),
  CONSTRAINT fk_marker_id FOREIGN KEY (marker_id) REFERENCES ispworker_markers(id) ON DELETE CASCADE
) ENGINE=InnoDB;

