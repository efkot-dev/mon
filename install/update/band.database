ALTER TABLE snmp_data ADD PRIMARY KEY (id);
CREATE INDEX idx_portid ON snmp_data (portid);
CREATE INDEX idx_timestamp ON snmp_data (timestamp);
CREATE INDEX idx_deviceid_added ON mon_voltage(deviceid, added, energy, volt, mon_types);
ALTER TABLE mon_voltage
MODIFY COLUMN mon_types VARCHAR(50) DEFAULT NULL,
MODIFY COLUMN added VARCHAR(100) DEFAULT NULL;
ALTER TABLE mon_voltage
MODIFY COLUMN energy ENUM('1', '2') DEFAULT NULL,
MODIFY COLUMN volt DECIMAL(5,2) DEFAULT NULL,
MODIFY COLUMN deviceid INT(11) DEFAULT NULL;
ALTER TABLE traff_monitor
ADD INDEX idx_deviceid (deviceid),
ADD INDEX idx_llid (llid);
CREATE INDEX idx_portid_timestamp ON snmp_data (portid, timestamp);

ALTER TABLE `tempdate`
CHANGE `last_processed` `last_processed` timestamp NOT NULL DEFAULT current_timestamp() ON UPDATE CURRENT_TIMESTAMP AFTER `file`,
ADD `previous` longtext COLLATE 'utf8mb4_unicode_ci' NULL AFTER `data`,
CHANGE `updated_at` `updated_at` timestamp NOT NULL DEFAULT current_timestamp() ON UPDATE CURRENT_TIMESTAMP AFTER `created_at`;

ALTER TABLE `switch_log`
CHANGE `types` `types` text COLLATE 'utf8_general_ci' NULL DEFAULT 'system' AFTER `deviceid`,
ADD `status` text COLLATE 'utf8_general_ci' NULL AFTER `types`,
RENAME TO `pmon_log`;

ALTER TABLE `pmon_log` CHANGE `deviceid` `deviceid` int(11) NULL DEFAULT '0' AFTER `id`;

ALTER TABLE `billing_usr` ADD `ponid` int(11) NULL AFTER `portidid`;

ALTER TABLE `panel_client` DROP `balance`, ADD `idonu` int(11) NULL AFTER `onukey`, DROP `login`, DROP `password`, ADD `update` datetime NULL;
ALTER TABLE `panel_client` RENAME TO `onu_support`;

CREATE TABLE `onu_message` (
  `id` int(11) unsigned NOT NULL AUTO_INCREMENT,
  `providerid` int(11) DEFAULT NULL,
  `billingid` int(11) DEFAULT NULL,
  `komy` int(11) DEFAULT NULL,
  `supportid` int(11) DEFAULT NULL,
  `title` text,
  `message` text,
  `status` int(11) DEFAULT NULL,
  `added` datetime DEFAULT NULL,
  `vidpovid` datetime DEFAULT NULL,
  PRIMARY KEY (`id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8 COLLATE=utf8_general_ci;

CREATE TABLE bandwidth_daily (
    id INT AUTO_INCREMENT PRIMARY KEY,
    portid INT NOT NULL,
    date DATE NOT NULL,
    traffic_day JSON NOT NULL,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    UNIQUE KEY unique_port_date (portid, date)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;
DROP TABLE `traffic_daily`;

ALTER TABLE `bandwidth_daily`
ADD `deviceid` int(11) NULL AFTER `portid`;


SET foreign_key_checks = 0;
DROP TABLE `shop_invoices`, `shop_invoice_items`, `shop_products`, `shop_used`;

CREATE TABLE `poncalculator` (
  `id` int(11) NOT NULL AUTO_INCREMENT,
  `name` varchar(255) DEFAULT NULL,
  `nodes` longtext CHARACTER SET utf8mb4 COLLATE utf8mb4_bin DEFAULT NULL CHECK (json_valid(`nodes`)),
  `edges` longtext CHARACTER SET utf8mb4 COLLATE utf8mb4_bin DEFAULT NULL CHECK (json_valid(`edges`)),
  `created_at` timestamp NOT NULL DEFAULT current_timestamp(),
  PRIMARY KEY (`id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8 COLLATE=utf8_unicode_ci;
ALTER TABLE `onusdata`
CHANGE `uid` `uid` varchar(11) NULL AFTER `name`;

