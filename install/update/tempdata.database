CREATE TABLE `pmonini` (
  `id` int(11) UNSIGNED NOT NULL AUTO_INCREMENT,
  `name` text,
  `value` text,
  `note` text,
  `subid` int(11) DEFAULT NULL,
  `port` text,
  `onu` text,
  `update` datetime DEFAULT NULL,
  `added` datetime DEFAULT NULL,
  PRIMARY KEY (`id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8;

