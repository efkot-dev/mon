CREATE TABLE `appmessages` (
  `id` int(11) NOT NULL AUTO_INCREMENT,
  `sender_id` int(11) DEFAULT NULL,
  `message` text DEFAULT NULL,
  `timestamp` timestamp NOT NULL DEFAULT current_timestamp(),
  `read_status` tinyint(1) DEFAULT 0,
  `types` text DEFAULT NULL,
  `pmon` text DEFAULT NULL,
  PRIMARY KEY (`id`),
  KEY `sender_id` (`sender_id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8 COLLATE=utf8_unicode_ci;
CREATE TABLE `read_messages` (
  `id` int(11) NOT NULL AUTO_INCREMENT,
  `message_id` int(11) NOT NULL,
  `user_id` int(11) NOT NULL,
  `read_at` timestamp NOT NULL DEFAULT current_timestamp(),
  PRIMARY KEY (`id`),
  KEY `message_id` (`message_id`),
  KEY `user_id` (`user_id`),
  CONSTRAINT `read_messages_ibfk_1` FOREIGN KEY (`message_id`) REFERENCES `appmessages` (`id`),
  CONSTRAINT `read_messages_ibfk_2` FOREIGN KEY (`user_id`) REFERENCES `users` (`id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8 COLLATE=utf8_unicode_ci;
ALTER TABLE appmessages ADD `types` TEXT NULL DEFAULT NULL AFTER read_status;
ALTER TABLE appmessages ADD `pmon` TEXT NULL DEFAULT NULL AFTER types;

CREATE TABLE `notification` (
  `id` int(11) UNSIGNED NOT NULL AUTO_INCREMENT,
  `status` int(11) DEFAULT NULL,
  `type` int(11) DEFAULT NULL,
  `added` datetime DEFAULT NULL,
  `types` enum('cron','system','user','switch','core','monitor') DEFAULT 'system',
  `message` text,
  `system` text,
  `users` text,
  `device` text,
  `grups` text,
  PRIMARY KEY (`id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8;

CREATE TABLE `ethelement` (
  `id` int(11) unsigned NOT NULL AUTO_INCREMENT,
  `name` varchar(255) NOT NULL,
  `tree` int(11) DEFAULT NULL,
  `types` int(11) DEFAULT NULL,
  `status` int(11) DEFAULT NULL,
  `count` int(11) DEFAULT NULL,
  `description` text DEFAULT NULL,
  `location` int(11) DEFAULT NULL,
  `lan` varchar(100) DEFAULT NULL,
  `lon` varchar(100) DEFAULT NULL,
  PRIMARY KEY (`id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8 COLLATE=utf8_general_ci;