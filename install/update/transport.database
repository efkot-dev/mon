CREATE TABLE IF NOT EXISTS transport_isp (
  id INT UNSIGNED AUTO_INCREMENT PRIMARY KEY,
  name VARCHAR(128) NOT NULL,
    location INT UNSIGNED NULL,
  logo VARCHAR(255) DEFAULT NULL,
  comment VARCHAR(255) NULL,
  phone VARCHAR(64) DEFAULT NULL,
  address VARCHAR(255) DEFAULT NULL,
  created_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

CREATE TABLE IF NOT EXISTS transport_onu (
  id BIGINT UNSIGNED AUTO_INCREMENT PRIMARY KEY,
  isp_id INT UNSIGNED NOT NULL,
  olt INT UNSIGNED NULL, 
  idonu INT UNSIGNED NULL, 
  mac CHAR(17) NULL,
  sn  VARCHAR(64) NULL,
  comment VARCHAR(255) NULL,
  status ENUM('online','offline') NOT NULL DEFAULT 'online',
  added DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
  UNIQUE KEY uniq_per_isp_idonu (isp_id, idonu),
  KEY idx_isp (isp_id),
  CONSTRAINT fk_transport_onu_isp
    FOREIGN KEY (isp_id) REFERENCES transport_isp(id)
    ON DELETE CASCADE
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;


