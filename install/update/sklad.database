SET foreign_key_checks = 0;
DROP TABLE `tmc_catalog`, `tmc_move`, `tmc_nakladna`, `tmc_provider`, `tmc_transport`;
CREATE TABLE `sklad_category` (
  `id` int(11) unsigned NOT NULL AUTO_INCREMENT,
  `name` text DEFAULT NULL,
  `img` text DEFAULT NULL,
  `note` text DEFAULT NULL,
  `number` varchar(10) DEFAULT NULL,
  `status` int(11) DEFAULT NULL,
  `types` int(11) DEFAULT NULL,
  `code` text DEFAULT NULL,
  PRIMARY KEY (`id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3 COLLATE=utf8mb3_general_ci;
CREATE TABLE sklad_tovar (
  id INT PRIMARY KEY AUTO_INCREMENT,
  name VARCHAR(255) NOT NULL,
  category_id INT UNSIGNED NOT NULL,
  unit VARCHAR(50) NOT NULL,
  quantity DECIMAL(10, 2) NOT NULL,
  description TEXT,
  price DECIMAL(10, 2) NOT NULL,
  date_added DATE NOT NULL,
  inventory_number VARCHAR(50),
  CONSTRAINT fk_category FOREIGN KEY (category_id) REFERENCES sklad_category(id) ON DELETE CASCADE ON UPDATE CASCADE
);
ALTER TABLE sklad_tovar ADD COLUMN status ENUM('active', 'inactive') DEFAULT 'active';
CREATE TABLE sklad_temp (
    id INT AUTO_INCREMENT PRIMARY KEY,
    product_id INT NOT NULL,
    user_id INT NOT NULL,
    quantity INT NOT NULL,
    assigned_at DATETIME DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (product_id) REFERENCES sklad_tovar(id),
    FOREIGN KEY (user_id) REFERENCES users(id)
);
CREATE TABLE sklad_accounting (
    id INT AUTO_INCREMENT PRIMARY KEY,
    product_id INT NOT NULL,
    user_id INT NOT NULL,
    quantity INT NOT NULL,
    action_type ENUM('assigned', 'returned') NOT NULL,
    action_date DATETIME DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (product_id) REFERENCES sklad_tovar(id),
    FOREIGN KEY (user_id) REFERENCES users(id)
);
CREATE TABLE sales_log (
    id INT AUTO_INCREMENT PRIMARY KEY,
    product_id INT NOT NULL,
    user_id INT NOT NULL,
    quantity_sold INT NOT NULL,
    sale_date TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (product_id) REFERENCES sklad_tovar(id),
    FOREIGN KEY (user_id) REFERENCES users(id)
);

ALTER TABLE `sklad_accounting`
ADD `status` enum('enable','disable') COLLATE 'utf8mb3_general_ci' NOT NULL AFTER `action_type`;
ALTER TABLE `sklad_tovar`
ADD `mac` text COLLATE 'utf8mb3_general_ci' NULL AFTER `description`;
ALTER TABLE `sklad_tovar`
ADD `oblik` int(10) unsigned NULL AFTER `category_id`,
CHANGE `unit` `unit` varchar(50) COLLATE 'utf8mb3_general_ci' NULL AFTER `oblik`;

CREATE TABLE sklad_sub_category (
    id INT AUTO_INCREMENT PRIMARY KEY,
    cat_id INT NOT NULL,
    name VARCHAR(255) NOT NULL,
    icon VARCHAR(255) NOT NULL,
    quantity INT NOT NULL,
    description TEXT
);
ALTER TABLE `sklad_sub_category`
CHANGE `icon` `icon` varchar(255) COLLATE 'utf8mb3_general_ci' NULL AFTER `name`;
ALTER TABLE `sklad_tovar`
ADD `sub_cat_id` int(10) unsigned NOT NULL AFTER `category_id`,
ADD `price_pdv` decimal(10,2) NOT NULL AFTER `price`;

CREATE TABLE sklad_akt (
    id INT AUTO_INCREMENT PRIMARY KEY,
    name TEXT NOT NULL,
    note TEXT NOT NULL,
    user_id INT NOT NULL,
    moderator_id INT NOT NULL,
    moderation ENUM('yes', 'no') NOT NULL,
    created_date DATETIME DEFAULT CURRENT_TIMESTAMP,
    checked_date DATETIME DEFAULT CURRENT_TIMESTAMP
);
ALTER TABLE `sklad_akt`
CHANGE `name` `name` text COLLATE 'utf8mb3_general_ci' NULL AFTER `id`,
CHANGE `note` `note` text COLLATE 'utf8mb3_general_ci' NULL AFTER `name`,
CHANGE `moderator_id` `moderator_id` int(11) NULL AFTER `user_id`,
CHANGE `moderation` `moderation` enum('yes','no') COLLATE 'utf8mb3_general_ci' NULL AFTER `moderator_id`;
CREATE TABLE sklad_akt_tovar (
    id INT AUTO_INCREMENT PRIMARY KEY,
    t_id INT NOT NULL,
    count INT NOT NULL,
    score VARCHAR(255) NOT NULL,
    created_date DATETIME DEFAULT CURRENT_TIMESTAMP
);
ALTER TABLE `sklad_akt_tovar`
ADD `akt_id` int(11) NOT NULL AFTER `t_id`;
ALTER TABLE `sklad_tovar`
ADD `hide` enum('yes','no') COLLATE 'utf8mb3_general_ci' NULL;

ALTER TABLE `sklad_akt_tovar` ADD `p_id` int(11) NULL AFTER `t_id`;
ALTER TABLE `sklad_sub_category`
ADD `code` text COLLATE 'utf8mb3_general_ci' NULL;

ALTER TABLE `sklad_category`
ADD `code` text COLLATE 'utf8mb3_general_ci' NULL;


CREATE TABLE `sklad_services` (
  `id` int(11) unsigned NOT NULL AUTO_INCREMENT,
  `name` text DEFAULT NULL,
  `iban` text DEFAULT NULL,
  `code` text DEFAULT NULL,
  `codefo` text DEFAULT NULL,
  `usrpib` text DEFAULT NULL,
  `mob` text DEFAULT NULL,
  `address` text DEFAULT NULL,
  `site` text DEFAULT NULL,
  `mail` text DEFAULT NULL,
  `note` text DEFAULT NULL,
  `status` int(11) DEFAULT NULL,
  PRIMARY KEY (`id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8 COLLATE=utf8_general_ci;

CREATE TABLE `sklad_tovar_ser` (
  id INT PRIMARY KEY AUTO_INCREMENT,
  name VARCHAR(255) NOT NULL,
  cat_id INT UNSIGNED NOT NULL,
  sub_cat_id INT UNSIGNED NOT NULL,
  status int(11) DEFAULT NULL,
  services_id int(11) DEFAULT NULL,
  tovar_id int(11) DEFAULT NULL,
  quantity DECIMAL(10, 2) NOT NULL,
  description TEXT,
  date_added DATE NOT NULL,
  date_return DATE NOT NULL,
  inventory_number VARCHAR(50)
);
ALTER TABLE `sklad_tovar_ser`
CHANGE `date_return` `date_return` date NULL AFTER `date_added`;
ALTER TABLE `sklad_tovar`
ADD `uadded` int(11) unsigned NULL AFTER `oblik`;
CREATE TABLE `tmc_category` (
  `id` int(11) unsigned NOT NULL AUTO_INCREMENT,
  `name` text DEFAULT NULL,
  `note` text DEFAULT NULL,
  `status` int(11) DEFAULT NULL,
  `locationid` int(11) DEFAULT NULL,
  PRIMARY KEY (`id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8 COLLATE=utf8_general_ci;

ALTER TABLE `shop_invoices` ADD `close_at` timestamp NOT NULL, ADD `status` int(11) NOT NULL AFTER `close_at`;

