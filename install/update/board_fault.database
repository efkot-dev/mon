CREATE TABLE `incident` (
  `id` INT NOT NULL AUTO_INCREMENT,
  `start_time` DATETIME NOT NULL,
  `description` TEXT NOT NULL,
  `reason` VARCHAR(256) DEFAULT NULL,
  `restore_time` DATETIME DEFAULT NULL,
  `status` ENUM('open', 'closed') NOT NULL DEFAULT 'open',
  `created_at` DATETIME NOT NULL,
  `updated_at` DATETIME NOT NULL,
  `user_id` INT NOT NULL,
  PRIMARY KEY (`id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;
CREATE TABLE `incident_log` (
  `id` INT NOT NULL AUTO_INCREMENT,
  `incident_id` INT NOT NULL,
  `action` TEXT NOT NULL,
  `user` VARCHAR(100) NOT NULL,
  `timestamp` DATETIME NOT NULL,
  PRIMARY KEY (`id`),
  KEY `incident_id` (`incident_id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;
CREATE TABLE incident_log_location (
    id INT AUTO_INCREMENT PRIMARY KEY,
    location_id INT,
    incident_id INT,
    street_id INT,
    house_numbers TEXT
);
CREATE TABLE incident_log_switch (
    id INT AUTO_INCREMENT PRIMARY KEY,
    incident_id INT,
    switch_id INT,
    port_id INT
);
ALTER TABLE `incident`
CHANGE `start_time` `start_time` datetime NULL AFTER `id`,
CHANGE `description` `description` text COLLATE 'utf8mb4_general_ci' NULL AFTER `start_time`,
CHANGE `status` `status` enum('open','closed') COLLATE 'utf8mb4_general_ci' NULL DEFAULT 'open' AFTER `restore_time`,
CHANGE `created_at` `created_at` datetime NULL AFTER `status`,
CHANGE `updated_at` `updated_at` datetime NULL AFTER `created_at`;
ALTER TABLE `incident` ADD `cron` int(11) NULL;
CREATE TABLE `incident` (
  `id` int(11) NOT NULL AUTO_INCREMENT,
  `start_time` datetime DEFAULT NULL,
  `description` text DEFAULT NULL,
  `comment` text DEFAULT NULL,
  `reason` varchar(256) DEFAULT NULL,
  `restore_time` datetime DEFAULT NULL,
  `status` enum('open','closed') DEFAULT 'open',
  `created_at` datetime DEFAULT NULL,
  `updated_at` datetime DEFAULT NULL,
  `user_id` int(11) NOT NULL,
  `user_id_close` int(11) DEFAULT NULL,
  `cron` int(11) DEFAULT NULL,
  PRIMARY KEY (`id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci;
CREATE TABLE `incident_log` (
  `id` int(11) NOT NULL AUTO_INCREMENT,
  `incident_id` int(11) NOT NULL,
  `action` text NOT NULL,
  `user` varchar(100) NOT NULL,
  `timestamp` datetime NOT NULL,
  PRIMARY KEY (`id`),
  KEY `incident_id` (`incident_id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci;
CREATE TABLE `incident_log_location` (
  `id` int(11) NOT NULL AUTO_INCREMENT,
  `location_id` int(11) DEFAULT NULL,
  `incident_id` int(11) DEFAULT NULL,
  `street_id` int(11) DEFAULT NULL,
  `sorc` int(11) DEFAULT NULL,
  `house_numbers` text DEFAULT NULL,
  PRIMARY KEY (`id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8 COLLATE=utf8_unicode_ci;
CREATE TABLE `incident_log_switch` (
  `id` int(11) NOT NULL AUTO_INCREMENT,
  `incident_id` int(11) DEFAULT NULL,
  `switch_id` int(11) DEFAULT NULL,
  `port_id` int(11) DEFAULT NULL,
  `sorc` int(11) DEFAULT NULL,
  PRIMARY KEY (`id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8 COLLATE=utf8_unicode_ci;
ALTER TABLE `incident_log_location` ADD `sorc` int(11) NULL AFTER `street_id`;
ALTER TABLE `incident_log_switch` ADD `sorc` int(11) NULL;
ALTER TABLE `incident` ADD `comment` text COLLATE 'utf8mb4_general_ci' NULL AFTER `description`, ADD `user_id_close` int(11) NULL AFTER `user_id`;
ALTER TABLE `incident` ADD `message` int(11) unsigned NULL, ADD FOREIGN KEY (`message`) REFERENCES `message` (`id`);
ALTER TABLE `incident` DROP FOREIGN KEY `incident_ibfk_1`